  <Item class="ReplicatedStorage" referent="6">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="7">
      <Properties>
        <string name="Name">Config</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Ajustes que o CLIENTE tambem precisa enxergar: camera, animacao, formacao.

	Nada de segredo aqui. Tudo em ReplicatedStorage e' replicado pra todos os
	jogadores e pode ser lido por qualquer um. A URL e a chave do servidor ficam
	em ServerScriptService/Segredos.luau, que nunca sai do servidor.
]]

return {
	--[[ ─────────────────────── A DANCA ───────────────────────

		Estes IDs sao animacoes GRATUITAS da propria Roblox. Elas funcionam
		sempre, em qualquer experiencia, sem voce precisar de permissao de
		ninguem -- e essa e' a razao de serem o padrao aqui.

		Se voce quiser usar um emote comprado do catalogo, ATENCAO a uma
		armadilha que custa horas: o ID do emote de catalogo (tipo 61) NAO
		funciona em Animation.AnimationId, que so' aceita tipo 24. Colar o ID do
		emote nao da' erro nenhum -- simplesmente nao toca nada, e voce fica
		procurando o problema no lugar errado. E' preciso extrair o ID da
		Animation que mora DENTRO do emote.

		E mais importante: um asset de TERCEIRO precisa da autorizacao do criador
		pra tocar na sua experiencia. Se um dia aparecer "Failed to load
		animation", e' permissao, nao o ID.

		Outras gratuitas da Roblox, caso queira variar:
		  507771019  Dance1A     507772104  Dance1C
		  507776043  Dance2A     507776879  Dance2C
		  507777268  Dance3A
	]]
	--[[ A DANCA PRINCIPAL: "Jamal Brazil Groove", da Setalcix Emote Creations.

		83796130837213 e' a ANIMATION (tipo 24). O emote de catalogo com o mesmo
		nome e' o 104131847054135, tipo 61, e ele NAO funciona aqui -- colar o
		numero do emote nao da' erro nenhum, simplesmente nao toca nada, e voce
		perde horas procurando o problema no lugar errado.

		ATENCAO -- LEIA ANTES DE VENDER: este asset e' de TERCEIRO. Para tocar
		numa experiencia, o criador precisa compartilha-lo com ela pelo Creator
		Hub. No Studio em modo PLAY, que e' como esta live roda, o ID de terceiro
		costuma funcionar sem isso. Mas se um dia voce PUBLICAR o jogo, ou se a
		Setalcix mudar a permissao, ele para de tocar -- e ai' entra a reserva
		abaixo, sozinha, sem derrubar a live.

		Se este virar o carro-chefe do seu produto, vale falar com a Setalcix e
		pedir a autorizacao no seu nome. ]]
	ANIMACAO = 83796130837213,

	--[[ A RESERVA. Animacao gratuita da propria Roblox: funciona sempre, em
		qualquer experiencia, sem depender da permissao de ninguem.

		Ela entra sozinha se a principal nao carregar. Sem isto, um asset de
		terceiro que perde a permissao no meio de uma live deixaria cem bonecos
		parados em pe', sem nenhuma mensagem explicando por que. ]]
	ANIMACAO_RESERVA = 507771019,

	--[[ ───────── UMA DANCA POR PRESENTE ─────────

		Quem chega por presente caro dança DIFERENTE de quem so' comentou. E'
		o que faz o presente ser visivel de longe: quem assiste percebe que
		aconteceu alguma coisa antes mesmo de ler o nome na tela.

		A chave da esquerda e' o que o painel manda no campo `danca` do efeito.
		"" (vazio) = usa a ANIMACAO principal, la' de cima.

		ESTAS CHAVES SAO UM CONTRATO COM O PYTHON. Uma dança so' chega aqui se o
		nome dela passar pela lista `DANCAS_VALIDAS` do ponte/regras.py -- ela
		existe justamente pra um nome errado no painel virar "dança padrao" em
		vez de virar um boneco parado em pe'. Criou uma dança nova aqui? Ponha o
		mesmo nome la' tambem, senao ela nunca sera' usada.

		As tres primeiras sao EMOTES COMPRADOS, com autorizacao dos criadores.
		A `festa` continua sendo uma gratuita da Roblox, de proposito: ela e' a
		unica que nao depende de permissao de terceiro, entao se um dia as
		outras pararem de carregar ainda sobra uma danca de verdade na live.

		O CAMPO `criador` NAO E' DECORACAO. A autorizacao de uso destas
		animacoes foi concedida com UMA contrapartida: creditar os autores na
		live. O nome fica ao lado do ID pra a obrigacao aparecer pra quem mexer
		na tabela, em vez de virar uma promessa que ninguem lembra.

		Pra trocar uma delas por outro emote comprado, lembre da armadilha: o
		ID do emote de CATALOGO (tipo 61) nao funciona aqui. So' o da Animation
		(tipo 24) que mora dentro dele. Pra extrair:

		    python ponte/extrair_animacao.py <id do emote>

		Se um dia uma delas parar de tocar com "Failed to load animation", e'
		PERMISSAO do asset e nao o ID: peca ao criador pra compartilhar com a
		experiencia pelo Creator Hub. No Studio em modo PLAY -- que e' como
		esta live roda -- o ID de terceiro funciona. ]]
	DANCAS = {
		-- emote 100548049120781 · animacao "Imported Animation Clip"
		rosquinha = 97851878594337, -- Moonwalk, de Blast Motion
		-- emote 104142334418357 · animacao "Style4"
		oculos = 129764254213842, -- Gangnam Style, de Our new group!
		-- emote 73946479113094 · animacao "macaroni"
		galaxia = 89558401923098, -- Macarena, de Voxelates
		festa = 507776879, -- R15Dance2C, gratuita da Roblox
	},

	--[[ A danca ESPECIAL: um presente configurado no painel faz a formacao
		INTEIRA trocar pra ela por alguns segundos, e depois ela volta sozinha.

		E' a MESMA da "festa" la' de cima, e de proposito: ela precisa ser
		diferente das tres dancas de presente, senao a formacao inteira trocaria
		pra danca do oculos bem no momento em que ela deveria fazer algo que
		nenhum presente sozinho faz -- e a troca geral, que e' o efeito mais caro
		da live, passaria despercebida. ]]
	ANIMACAO_ESPECIAL = 507776879,

	--[[ ───────────────────── A FORMACAO ─────────────────────

		A grade onde os avatares ficam em pe'. Estes sao os valores de fabrica;
		o painel manda os dele por cima, em tempo real.
	]]
	-- Quantos cabem antes de a formacao fechar o ciclo e recomecar do zero.
	MAX_AVATARES = 100,
	-- Quantos por fileira. A camera fica do lado +Z, entao cada fileira nova
	-- nasce mais PERTO de quem assiste.
	POR_FILA = 10,
	-- Distancia entre avatares vizinhos, em studs.
	ESPACO_X = 6,
	--[[ Distancia entre uma fileira e a proxima, PARA GENTE DE TAMANHO NORMAL.

		Maior que o ESPACO_X de proposito: com as fileiras muito juntas, quem
		esta' atras fica escondido por quem esta' na frente, e a formacao vira
		uma parede.

		Uma fileira com boneco grande abre mais que isto sozinha -- ela empurra a
		seguinte pelo tamanho do maior que tem. Ver `zDaFileira` no Formacao.luau:
		com este numero fixo pra todo mundo, um gigante invadia a fileira da
		frente com metade do corpo e a formacao virava um amontoado. ]]
	ESPACO_Z = 8,
	--[[ Quanto de LARGURA um avatar de escala 1.0 ocupa. E' o que decide quantos
		slots um avatar GRANDE precisa -- sem isso, um boneco de escala 4 nasceria
		em cima dos vizinhos.

		6 e nao 5: um R15 parado tem uns 4 studs de ombro a ombro, mas DANCANDO
		ele abre os bracos, e a conta apertada deixava o boneco de escala 3.2 (a
		galaxia) com tres slots quando o corpo dele pede quatro -- os bracos
		batiam nos vizinhos no meio da coreografia. ]]
	LARGURA_POR_ESCALA = 6,

	--[[ ───────────────────── O CRESCIMENTO ─────────────────────

		O que o telao promete: "envie presentes e seu personagem cresce".

		Estes sao os valores de fabrica. O painel manda os dele por cima em
		tempo real (o Principal os espelha em atributos do workspace), entao
		mexer aqui so' muda o comportamento de quem nunca abriu o painel.
	]]
	CRESCIMENTO = {
		--[[ O que um presente faz na tela. "novo" | "crescer" | "ambos".

			  novo      cada presente poe um boneco NOVO na tela. <-- PADRAO
			  crescer   o presente engorda o boneco que a pessoa ja' tem.
			  ambos     as duas coisas.

			O padrao e' "novo" por uma razao de produto: presente tem que
			colocar ALGUMA COISA NOVA na tela. Um boneco que so' incha no meio
			da formacao e' um efeito que quem assiste pelo celular nao liga ao
			presente que acabou de passar no chat -- e quem pagou fica sem
			saber se funcionou.

			As tres opcoes sao legitimas e o painel troca entre elas ao vivo:
			"novo" mostra QUANTA gente participou, "crescer" premia QUEM
			gastou. Este valor so' vale enquanto o painel nunca foi aberto. ]]
		MODO = "novo",

		--[[ Ate' onde um avatar pode crescer somando presente sobre presente.

			6.0 nao e' um numero solto: e' o maior tamanho em que um boneco
			ainda CABE no enquadramento junto com a formacao. Acima disso a
			camera precisa recuar tanto pra ele caber que todo o resto da live
			vira um tapete de pontinhos no chao -- ou seja, o presente mais caro
			passaria a ESTRAGAR o quadro em vez de destacar quem pagou.

			Quem chega ao teto NAO para de receber efeito: o presente seguinte
			vira um avatar novo (ver `crescer` no Principal). ]]
		TAMANHO_MAX = 6.0,

		--[[ Quanto o crescimento demora, em segundos.

			Salto seco parece bug -- o boneco simplesmente e' outro no quadro
			seguinte, e quem esta' assistindo nao liga uma coisa a' outra. Longo
			demais termina depois de a camera ja' ter ido embora, e a pessoa nao
			ve' o que pagou. 0,6s e' o ponto em que da' pra VER acontecendo. ]]
		SUAVE_S = 0.6,
	},

	--[[ ───────────────────── A CAMERA ─────────────────────

		SEGUIR   o padrao, e o que roda a live quase inteira. Acompanha quem
		         acabou de chegar, com atraso, e RECUA quando o boneco e' grande
		         em vez de ficar em cima dele.
		ABERTA   fim do ciclo: recua e mostra a formacao inteira antes de limpar.
		CENA     DESLIGADA (ver CENA_LIGADA). Girava em volta de quem mandou
		         presente caro; enjoava e escondia a multidao.
	]]
	CAMERA = {
		--[[ ═══════════════ O ENQUADRAMENTO ═══════════════

			TUDO QUE DECIDE O QUADRO DA LIVE ESTA' NESTE BLOCO.

			E a camera NAO usa estes numeros crus: ela usa como PONTO DE PARTIDA
			e depois confere, quadro a quadro, se o telao e o avatar cabem os
			dois. Ver `enquadrar` no Camera.client.luau.

			Por que um solver em vez de numeros fixos: a distancia certa depende
			de tres coisas que mudam o tempo todo -- o tamanho do avatar (que
			agora CRESCE com presente, ate' 6x), a fileira em que ele esta' (a
			formacao anda 70 studs em direcao a' camera ao longo do ciclo) e o
			formato do video (9:16 corta muito mais que 16:9). Qualquer numero
			fixo esta' errado em duas das tres situacoes; foi assim que o topo do
			telao vivia cortado justamente na primeira fileira. ]]

		--[[ Altura da camera, CONTADA A PARTIR DO MEIO DO ALVO.

			A conta e' `pes + ALTURA + metade da altura do boneco` (ver
			`resolver` no Enquadramento.luau), entao 1 num boneco normal poe a
			lente a 4 studs do chao: A ALTURA DO PEITO dele.

			POR QUE NA ALTURA DO PEITO, E NAO ACIMA

			Era 19 (lente a 22 studs), depois 6.5 (lente a 9,5) -- e os dois
			ainda olhavam pra BAIXO. Camera acima da cabeca mostra a formacao
			como GRADE: da' pra contar as fileiras, e o boneco de quem acabou de
			comentar aparece de cima, que e' o angulo em que uma skin menos se
			reconhece (voce ve' o chapeu e o ombro, nao a roupa nem o rosto).

			No peito, a lente olha o boneco DE FRENTE. E' o enquadramento de
			quem esta' conversando com ele, e nao de quem esta' vigiando a
			plateia -- e e' o unico que mostra a skin inteira do jeito que a
			pessoa a montou.

			ELA ACOMPANHA O TAMANHO sozinha: a metade da altura do boneco entra
			na conta, entao um avatar de 36 studs e' filmado a 19 studs de
			altura -- o peito DELE. Nenhum caso especial no codigo.

			O preco disso esta' no telao, e ele e' real: uma lente nessa altura
			nao alcanca o alto da parede. Por isso a MENSAGEM do telao mora na
			faixa de baixo dele -- ver o bloco TELAO aqui embaixo e o
			Cenario.model.json. ]]
		ALTURA = 1,

		--[[ Distancia de quem ela esta' seguindo -- o ponto de PARTIDA.

			Este numero e' o que decide se a live parece um close claustrofobico
			ou um palco. Perto demais, o avatar toma a tela inteira e nao da' pra
			ver que tem uma multidao atras -- e a multidao e' o argumento que faz
			a proxima pessoa comentar. Longe demais e os bonecos viram formigas.

			13 com a lente de 40 graus, na altura do peito, deixa um avatar
			normal ocupando mais da metade da altura do quadro, DE FRENTE. E' o
			plano em que a skin e o nick se leem sem esforco no celular de quem
			assiste -- que e' a coisa que esta live vende.

			Referencia pra ajustar:
			  10 = close no rosto
			  13 = padrao: corpo inteiro de frente, multidao atras
			  20 = grupo, duas ou tres fileiras
			  38 = o plano antigo, o palco inteiro ]]
		DISTANCIA = 13,

		--[[ Os limites dentro dos quais o solver pode se mexer.

			Ele SO' AFASTA a partir da DISTANCIA, nunca aproxima -- entao o
			MINIMO e' um piso de seguranca (se voce puser uma DISTANCIA absurda
			no painel) e o MAXIMO e' o que impede um colosso de empurrar a camera
			pro outro lado do mapa, transformando a live inteira num tapete de
			pontinhos. ]]
		DISTANCIA_MIN = 8,
		DISTANCIA_MAX = 120,

		--[[ ═══════════════ O ZOOM DE CHEGADA ═══════════════

			Quem comenta ou manda presente ganha alguns segundos de CLOSE: o
			boneco grande na tela, com o nick legivel, e depois a camera volta
			pro plano normal.

			POR QUE ELE EXISTE

			Os dois pedidos do quadro brigam entre si. O plano normal precisa
			mostrar a MULTIDAO e o TELAO -- e' o que faz a proxima pessoa
			comentar. O close precisa mostrar UMA pessoa e o nome dela -- e' o
			que faz quem ja' comentou continuar assistindo. Nao existe uma
			distancia so' que entregue as duas: a que mostra a multidao deixa a
			skin pequena, e a que mostra a skin corta a multidao.

			Resolvido no TEMPO, e nao no espaco, os dois cabem: o close acontece
			no instante em que a pessoa chega -- que e' o unico instante em que
			ela esta' olhando -- e o resto do tempo a live respira aberta. ]]
		ZOOM_LIGADO = true,

		--[[ Quantos segundos o close dura.

			2,2 e' tempo de LER um nick e reconhecer uma roupa, e pouco pra
			cansar. Mais curto vira susto; mais longo e a live vira uma
			sequencia de closes, sem multidao nenhuma -- que e' exatamente o
			defeito pelo qual a cinematica antiga (CENA_LIGADA) foi desligada. ]]
		ZOOM_S = 2.2,

		--[[ Onde o close COMECA a procurar distancia, por unidade de tamanho
			do boneco.

			E' o piso da busca, e nao a distancia final: o solver afasta a
			partir daqui ate' o boneco e o balao do nome caberem. Num avatar
			normal isso da' uns 12 studs, com o corpo ocupando ~70% da altura
			do quadro. Multiplicado pelo tamanho porque um boneco de escala 4
			precisa de quatro vezes mais espaco pro mesmo quadro. ]]
		ZOOM_DISTANCIA = 9,

		--[[ A folga do close, em graus -- menor que a do plano normal.

			O close nao tem telao pra acomodar nem multidao pra respeitar: e' um
			retrato. Apertar a margem de 4 pra 2 graus tira ~1,5 stud de
			distancia sem tirar nada do quadro, porque o que sobra na borda de
			um close e' ar, e nao cenario.

			ELE NAO PODE IR A ZERO: sem folga nenhuma, o balao do nome encosta
			na borda de cima e o pe' do boneco na de baixo, e qualquer tremida
			da interpolacao corta um dos dois. ]]
		ZOOM_MARGEM_GRAUS = 2,

		--[[ Suavidade da ENTRADA no close -- bem maior que a normal.

			O pedido foi literal: "tem que ser um zoom rapido". Com a suavidade
			de sempre (0.08) a camera levaria mais de um segundo pra chegar no
			close, ou seja, ainda estaria viajando quando o tempo dele acabasse
			-- e o que sai no video e' um vai-e-vem molenga, nao um zoom. Em
			0.22 ela fecha o movimento em ~0.25s.

			A VOLTA usa a suavidade normal, e de proposito: sair devagar do
			close devolve a multidao sem susto. ]]
		ZOOM_SUAVIDADE = 0.22,

		--[[ Ate' onde o TELAO pode empurrar a lente pra tras, em studs.

			Sem este teto, o telao mandava no plano inteiro: ele fica 74 studs
			atras da formacao, e caber o topo dele junto com o avatar exigia
			recuar ate' o boneco virar um bonequinho. A live ficava longe por
			causa do FUNDO.

			Com ele, quem manda e' o AVATAR. Se o telao nao couber dentro deste
			limite, o solver desiste dele -- o mesmo caminho que ja' existia pro
			colosso -- e entrega o plano de perto, com o telao aparecendo
			cortado. E' o preco certo: o boneco de quem chegou e' o assunto, o
			telao e' o cartaz atras dele. ]]
		TELAO_RECUO_MAX = 22,

		--[[ Abertura da lente, em graus (vertical).

			40 nos dois formatos. Antes eram 62 e 68 -- uma grande-angular, que
			e' a lente certa pra caber MUITA COISA e a errada pra mostrar UMA
			PESSOA: ela estica o que esta' perto da borda e achata o rosto de
			quem esta' no meio, e agora quem esta' no meio e' o assunto.

			Fechar a lente tambem e' o que permite chegar a 18 studs sem o
			quadro virar um olho-de-peixe. Os dois numeros andam juntos: uma
			lente aberta a 18 studs deformaria o boneco; uma lente fechada a 38
			mostraria so' um pedaco da formacao.

			OS DOIS FORMATOS IGUAIS, e antes nao eram. A vertical era mais
			aberta pra devolver largura no 9:16, onde a abertura horizontal sai
			da vertical pela proporcao da tela. Com 40 a largura util no 9:16 e'
			estreita mesmo -- e a resposta pra isso nao e' abrir a lente e
			entortar o boneco, e' a MENSAGEM DO TELAO viver numa coluna central
			estreita, que e' como ela esta' montada no Cenario.model.json. ]]
		FOV = 40,
		FOV_VERTICAL = 40,

		--[[ Folga, em graus, entre o que PRECISA aparecer e a borda do quadro.

			Sem ela o solver entrega um enquadramento tecnicamente correto e
			visualmente sufocado: o topo do telao encostado na borda de cima, os
			pes do avatar encostados na de baixo. 4 graus de cada lado e' o
			respiro que faz o quadro parecer composto em vez de espremido. ]]
		MARGEM_GRAUS = 4,

		--[[ Quanto do quadro o telao pode exigir pra si.

			Se o avatar cresceu muito, chega um ponto em que enquadrar os dois
			exige recuar tanto que os DOIS ficam pequenos. Passando disto, o
			solver desiste do topo do telao e prioriza o avatar -- ainda aparece
			bastante telao no fundo, mas o presente que a pessoa pagou continua
			grande na tela, que e' a escolha certa nesse impasse. ]]
		TELAO_ATE_GRAUS = 46,
		-- Suavidade do movimento, de 0 a 1. Quanto MENOR, mais macio -- e mais
		-- lento pra alcancar. 0.08 e' o ponto em que ela parece uma camera na
		-- mao de alguem, sem enjoar quem assiste.
		SUAVIDADE = 0.08,
		-- Distancia no plano ABERTO, no fim de cada ciclo. Precisa ser bem maior
		-- que a DISTANCIA, senao o "plano aberto" fica parecido demais com o de
		-- perto e o momento de mostrar a multidao inteira se perde.
		RECUO = 85,
		ALTURA_ABERTA = 48,
		-- Quanto o plano aberto dura antes de a formacao ser apagada.
		ABERTA_S = 3.0,
		--[[ A CINEMATICA DE GIRO -- DESLIGADA.

			Ligada, um presente caro fazia a camera CORTAR pro avatar e dar uma
			volta em torno dele. No papel e' o momento da pessoa; na tela o giro
			nao para de acontecer -- e numa live movimentada, com presente
			chegando a cada poucos segundos, a camera passava mais tempo rodando
			em volta de alguem do que mostrando a live. Fica tonto de assistir, e
			pior: cada giro joga fora a MULTIDAO do fundo, que e' o argumento que
			faz a proxima pessoa entrar.

			Desligada, quem pagou nao perde nada. A camera normal ja' vai atras
			de quem acabou de chegar, e o `segura` do presente continua valendo:
			ninguem nasce por cima dele. Ele fica em quadro o mesmo tempo -- so'
			que parado, com a formacao inteira atras.

			Pra ligar de volta: `true` aqui. O resto continua funcionando. ]]
		CENA_LIGADA = false,
		-- Velocidade do giro, em voltas por segundo (so' vale com CENA_LIGADA).
		-- Devagar de proposito: rapido demais embrulha o estomago de quem
		-- assiste, e o ponto da cena e' dar tempo de OLHAR a skin de quem pagou.
		CENA_GIRO = 0.12,
		--[[ A CENA e' o unico momento em que vale a pena chegar perto: e' o close
			de quem pagou. Mas nem tao perto -- a skin inteira, do chapeu ao
			sapato, precisa caber no quadro.

			ATENCAO: estes dois numeros valem pra um avatar de TAMANHO NORMAL. A
			camera multiplica os dois pela altura do boneco, senao um presente de
			escala 4 (o oculos) apareceria so' do peito pra cima -- e o colosso,
			so' a canela. Mexer aqui muda a cena de todo mundo junto. ]]
		CENA_DISTANCIA = 14,
		CENA_ALTURA = 6,
	},

	--[[ ───────────────────── O TELAO ─────────────────────

		Onde ele esta' no mundo. A camera usa isto pra garantir que ele CABE no
		quadro (ver `enquadrar` no Camera.client.luau).

		Estes numeros sao uma RESERVA: em tempo de execucao a camera mede a peca
		"Telao" de verdade dentro do Cenario e usa as medidas dela. E' a mesma
		ideia de sempre neste kit -- se um dia voce arrastar o telao no Studio,
		o enquadramento acompanha sozinho, em vez de continuar mirando no lugar
		onde ele estava.

		Se voce APAGAR o telao do mapa, estes valores entram e a camera
		continua enquadrando o fundo como se ele estivesse la'. E' de proposito:
		melhor um quadro um pouco alto demais do que uma camera que muda de
		comportamento sem ninguem entender por que.

		═══════════════════════════════════════════════════════════════════
		POR QUE O TOPO E' 21 E NAO 56 -- A PAREDE TEM DUAS PECAS AGORA
		═══════════════════════════════════════════════════════════════════

		A parede de LED continua com 52 studs de altura. O que mudou e' que ela
		virou DUAS pecas, e so' a de baixo se chama `Telao`:

		  Telao          Y 4..21   a MENSAGEM. E' o que a camera promete caber.
		  PainelSuperior Y 21..56  a marca, em letra gigante. Enfeite de plano
		                           aberto -- ninguem precisa ler de perto.

		A divisao existe porque a camera baixa (ver CAMERA.ALTURA) olha pra
		BAIXO, e o alto de uma parede de 56 studs simplesmente nao esta' no
		quadro dela -- em nenhuma distancia razoavel. Enquanto o `Telao` era a
		parede inteira, o solver obedecia: recuava ate' 40 studs pra caber um
		topo que ninguem precisava ler, e desfazia justamente o plano de perto
		que a lente veio buscar.

		Agora a camera se compromete com os 17 studs que carregam texto, cabe
		neles a 18 studs de distancia, e o resto da parede aparece cortado --
		como aparece o alto do cenario em qualquer transmissao de verdade.

		SE VOCE ENGORDAR O `Telao` NO STUDIO, A CAMERA RECUA. E' a mesma regra
		de sempre (ela mede a peca, ver `medirTelao`), e agora ela tem um preco
		visivel: cada stud a mais no topo empurra a lente pra tras. ]]
	TELAO = {
		Z = -74,
		TOPO = 21,
		BASE = 4,
		MEIA_LARGURA = 74,
	},

	--[[ ───────────────────── O ROTULO ─────────────────────

		O balao com o nome, em cima da cabeca de cada avatar. Duas linhas: o @ do
		TikTok em cima, o nick do Roblox embaixo -- e' o que deixa a pessoa se
		reconhecer na tela sem depender so' da skin.
	]]
	ROTULO = {
		--[[ Studs acima do CENTRO DA CABECA.

			Era 3.2, e o balao boiava longe do boneco. Nao era so' feio: cada
			stud de folga aqui e' um stud a mais que a camera precisa enquadrar
			pra o nick aparecer -- e, num close, isso empurra a lente pra tras
			ou joga o quadro pra cima do boneco. Foi o que fez o close sair
			"olhando pra cima" em vez de para o peito.

			2.2 poe o topo do balao a 8 studs do chao num boneco normal, que e'
			exatamente o dobro da altura da lente (4, a altura do peito). Essa
			simetria e' o que deixa o close RETO: com o que precisa caber
			distribuido igualmente acima e abaixo da lente, o eixo optico sai
			na horizontal sozinho, sem nenhum caso especial. ]]
		ALTURA = 2.2,
		--[[ Largura do balao, em studs.

			ELA PRECISA CABER NO ESPACO ENTRE VIZINHOS. Com a fileira da frente
			inteira nomeada, dez baloes ficam lado a lado a ESPACO_X (6 studs)
			um do outro -- e um balao de 9 studs invadia 3 studs do vizinho dos
			dois lados. Os nomes se encavalavam justamente na fileira que a live
			existe pra mostrar.

			5.5 deixa meio stud de ar entre um e outro. O texto nao fica menor
			por isso na pratica: o que limita o tamanho da fonte e' a ALTURA da
			linha, e ela nao mudou.

			Mexeu no ESPACO_X da formacao? Mexa aqui junto, ou os nomes voltam a
			se encostar. ]]
		LARGURA = 5.5,
		FUNDO = Color3.fromRGB(0, 0, 0),
		TRANSPARENCIA = 0.35,
		--[[ Nao existe COR_ARROBA aqui, e a falta e' de proposito: a linha do @
			usa sempre a COR DO PRESENTE. E' o sinal mais barato de "esta pessoa
			pagou", legivel de relance num celular assistindo a live -- uma cor
			fixa jogaria isso fora. Quem nao mandou presente cai no branco. ]]
		COR_NICK = Color3.fromRGB(255, 214, 64),

		--[[ ───────── QUANDO O ROTULO APARECE ─────────

			ESTES TRES NUMEROS EXISTEM POR UM MOTIVO SO': DE LONGE, NOME NENHUM
			SE LE'.

			O `DISTANCIA_MAX` era 80, e 80 e' MAIS que a formacao inteira. A
			camera de perto fica a uns 45 studs de quem ela esta' seguindo (ver
			CAMERA.DISTANCIA e CAMERA.ALTURA), entao 80 alcancava a pessoa
			seguida MAIS quatro fileiras atras dela: quarenta, cinquenta baloes
			pretos desenhados ao mesmo tempo, empilhados uns sobre os outros no
			video de um celular. Nao dava pra ler nenhum -- nem o de quem a
			camera estava seguindo, que e' o unico que importa -- e a multidao,
			que e' o argumento que faz a proxima pessoa comentar, sumia atras de
			uma parede de texto.

			Agora sao quatro regras, nesta ordem:

			  1. so' a FILEIRA DA FRENTE tem nome (ver SO_FILEIRA_DA_FRENTE);
			  2. passou do ALCANCE, o rotulo some;
			  3. dentro do alcance, ele APAGA aos poucos a partir do
			     DISTANCIA_SUAVE (some sem "piscar" na tela);
			  4. e nenhum nome pode cair EM CIMA de outro na tela, nem passar
			     de MAX_NA_TELA ao todo.

			Fora de todas elas fica QUEM A CAMERA ESTA' MOSTRANDO: esse acende
			sempre, marcado pelo proprio Camera.client.luau.

			Quem faz as contas e' o StarterPlayerScripts/Rotulos.client.luau,
			no cliente, quadro a quadro do lado de quem esta' vendo.

			PRA DESLIGAR TUDO ISTO e voltar ao comportamento antigo: ponha
			SO_FILEIRA_DA_FRENTE = false, SEM_SOBREPOR = false,
			DISTANCIA_MAX = 300 e MAX_NA_TELA = 400. ]]

		--[[ A que distancia o rotulo some de vez.

			ESTE NUMERO ANDA COLADO NA CAMERA.DISTANCIA, e por isso ele mudou
			junto com ela: era 68, calibrado pra uma lente que ficava a ~45
			studs de quem seguia. Com a lente a ~19 studs (ver CAMERA.DISTANCIA
			e CAMERA.ALTURA), 68 alcancaria seis fileiras -- sessenta baloes
			pretos empilhados no quadro de um celular, que e' exatamente a
			parede de texto que estes tres ajustes existem pra evitar.

			ESTE NUMERO E' PRA QUEM SO' COMENTOU, e foi ele que fez o nick de
			quem comenta nao aparecer enquanto o de quem mandou Rosa aparecia
			do lado. O alcance cresce com a raiz do tamanho (ver ESCALA_TETO),
			entao na MESMA distancia um boneco de escala 1 tinha 40 studs de
			alcance e o de escala 2 tinha 57: o pequeno apagava primeiro. Quem
			pagou ficava nomeado e quem comentou ficava anonimo ao lado dele --
			o oposto da promessa que o telao faz.

			75 alcanca umas sete fileiras a partir da lente, que e' toda a parte
			da formacao que aparece grande o bastante pra um nome ser lido. Quem
			limita a poluicao nao e' este numero e sim o SO_FILEIRA_DA_FRENTE e o
			MAX_NA_TELA -- e os dois valem igual pra todo mundo, independente de
			tamanho.

			No PLANO ABERTO do fim do ciclo a camera vai pra ~130 studs, entao
			os rotulos da multidao somem sozinhos justamente no momento de
			mostrar QUANTA gente entrou. Um presente gigante ainda aparece
			nomeado la' -- e' UM balao, e e' o mais caro da live. ]]
		DISTANCIA_MAX = 75,

		--[[ Onde ele COMECA a apagar. Entre este numero e o DISTANCIA_MAX o
			rotulo vai ficando transparente.

			Sem esta faixa, o rotulo sumia de um quadro pro outro toda vez que a
			camera se mexia um pouco -- cem baloes piscando juntos, que na
			gravacao fica pior do que o excesso que este ajuste veio resolver. ]]
		DISTANCIA_SUAVE = 60,

		--[[ ───────── UM NOME NAO PODE CAIR EM CIMA DO OUTRO ─────────

			As regras acima decidem QUANTOS nomes aparecem. Esta decide se eles
			cabem no lugar onde caem.

			A conta que explica o embolamento: com a lente na altura do peito,
			todo balao esta' na mesma altura do MUNDO. Quanto mais longe, menor
			a elevacao -- entao o balao da fileira de tras DESCE na tela e vai
			pousar exatamente em cima da cabeca de quem esta' na frente. Nao e'
			azar de posicao, e' geometria: acontece toda vez.

			Ligado, o cliente mede o retangulo de cada balao na tela e da' o
			lugar a quem esta' MAIS PERTO da lente. Quem cairia por cima nao
			acende -- um nome a menos e' melhor que dois ilegiveis empilhados.

			`false` devolve o comportamento antigo (todos acendem, sobrepondo).
			Ver `retanguloDe` no Rotulos.client.luau. ]]
		SEM_SOBREPOR = true,

		--[[ Folga em PIXELS em volta de cada balao, na conta de sobreposicao.

			Zero deixaria dois nomes encostados um no outro -- tecnicamente sem
			sobrepor, e ilegiveis do mesmo jeito. 6 e' o respiro que faz o olho
			separar os dois. Numero maior = menos nomes na tela, mais espacados. ]]
		FOLGA_SOBREPOR = 6,

		--[[ Teto de rotulos na tela ao mesmo tempo, dos mais PERTOS pros mais
			longes.

			ELE PRECISA CABER A FILEIRA INTEIRA, senao ele corta justamente o que
			o SO_FILEIRA_DA_FRENTE veio garantir -- e corta calado, pelos mais
			distantes da fileira. 14 cobre os POR_FILA = 10 com folga pro colosso
			e pra quem a camera estiver seguindo de outra fileira.

			Aumentou o POR_FILA no painel? Aumente este junto. ]]
		MAX_NA_TELA = 14,

		--[[ ───────── SO' A FILEIRA DA FRENTE TEM NOME ─────────

			A fileira que esta' ENTRANDO aparece com todos os nicks; as de tras
			ficam sem nome, dancando na multidao. Quando uma fileira nova nasce,
			a anterior apaga.

			POR QUE NAO TODAS: com cem avatares, mostrar todos os nomes juntos e'
			uma parede de texto onde nenhum se le' -- e a multidao, que e' o
			argumento que faz a proxima pessoa comentar, some atras dos baloes.

			POR QUE NAO UM RODIZIO: foi o que existia antes. As fileiras se
			revezavam de 4 em 4 segundos pra todo mundo ter a vez, e na intencao
			era justo. Na tela era outra coisa: quem acabou de comentar -- que e'
			exatamente quem esta' olhando pra live naquele segundo -- tinha uma
			chance em dez de ver o proprio nome. A promessa da live e' "comente e
			apareca", e ela so' se cumpre no instante em que a pessoa comenta.

			`false` desliga e mostra o nome de todo mundo que estiver dentro do
			alcance -- que e' o comportamento antigo, e a parede de texto. ]]
		SO_FILEIRA_DA_FRENTE = true,

		--[[ Ate' que tamanho de boneco o alcance do rotulo cresce junto.

			ISTO NAO E' GOSTO: E' A MESMA LEI DO RECUO DA CAMERA.

			Quando chega um avatar grande, a camera se AFASTA dele -- e ela se
			afasta pela RAIZ do tamanho (ver `destinoSeguir` no
			Camera.client.luau, e o porque esta' explicado la'). Ou seja: quanto
			maior o boneco, mais longe da lente ele fica, mesmo sendo o alvo.

			Com alcance fixo pra todo mundo, o resultado era o pior possivel: o
			presente MAIS CARO da live -- o colosso, que empurra a camera pra
			mais de 130 studs -- era exatamente o unico que ficava SEM nome na
			tela. Quem pagou mais aparecia como um gigante anonimo.

			O alcance entao cresce pela raiz do tamanho, igualzinho ao recuo, e
			os dois se cancelam: cada avatar fica legivel na distancia em que a
			camera escolheu enquadra-lo, seja ele de escala 1 ou de escala 40.

			O TETO de 9 (raiz de 9 = 3 vezes o alcance) e' o que impede o
			colosso, que pode chegar a escala 40, de virar um outdoor visivel de
			qualquer canto do mapa. Na pratica:
			  escala  1  ->   75 studs   (quem so' comentou)
			  escala  4  ->  150 studs   (o oculos)
			  escala  6  ->  184 studs   (a galaxia)
			  escala 40  ->  225 studs   (colosso, no teto) ]]
		ESCALA_TETO = 9,
	},

	--[[ ───────────────────── O BRILHO ─────────────────────

		A aura de quem mandou presente. A cor vem do efeito (a mesma do nome),
		entao cada presente brilha de um jeito proprio sem precisar de outro
		campo. O numero e' so' a FORCA, de 1 a 5.

		Quem so' comentou nunca brilha, e isso e' regra e nao acaso: se todo
		mundo brilha, o brilho deixa de significar alguma coisa.

		E' UMA COISA SO': o CONTORNO no formato do corpo. Nada de luz no chao,
		nada de faisca, nada de halo -- essas camadas existiram e sairam. Luz de
		verdade nao respeita o corpo de ninguem: ela vaza pro chao, pinta os
		vizinhos e lava a cor da roupa da pessoa, que e' o que ela veio ver na
		tela. Com cem bonecos, cem luzes coloridas transformam a formacao numa
		mancha.

		O contorno acompanha a silhueta -- braco, cabelo, chapeu, acessorio --
		e para exatamente onde o boneco para. Ele cresce em FORCA, e nao em
		tamanho: quanto mais caro o presente, mais fechada a linha.
	]]
	BRILHO = {
		--[[ De que forca em diante o boneco ganha aura. 1 = todo presente tem.

			A escadinha de camadas antiga comecava no 2, e ai' a rosa (forca 1)
			nao ganhava nada. Com uma camada so', comecar no 2 deixaria o
			presente mais comum da live sem sinal nenhum de que foi pago. ]]
		CONTORNO_DESDE = 1,

		--[[ Quanto a LINHA fecha. Transparencia = BASE - POR_FORCA x forca,
			entao numero MENOR = linha mais forte. Forca 5 fecha em 0 (cheia). ]]
		LINHA_BASE = 0.45,
		LINHA_POR_FORCA = 0.09,

		--[[ Quanto de cor entra POR DENTRO do corpo. Quase nada, de proposito:
			preenchimento forte apaga a roupa da pessoa. Mesma conta da linha --
			menor = mais cor. ]]
		PREENCHIMENTO_BASE = 0.97,
		PREENCHIMENTO_POR_FORCA = 0.015,

		--[[ Teto de auras ao mesmo tempo. NAO E' AJUSTE DE GOSTO: o motor da
			Roblox desenha no maximo 31 Highlight por vez, e do 32 em diante ele
			simplesmente NAO desenha -- sem erro, sem aviso.

			Estourar o teto nao apaga a aura de quem chegou: o codigo tira a do
			presente MAIS FRACO que estiver na tela pra dar lugar ao mais forte.
			Assim a galaxia nunca fica sem aura porque vinte rosas chegaram
			antes -- que e' exatamente o que aconteceria com um teto simples. ]]
		MAX_CONTORNOS = 24,
	},
}
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="8">
      <Properties>
        <string name="Name">Enquadramento</string>
        <string name="Source"><![CDATA[--!strict
--[[
	A conta que decide onde a camera fica.

	MODULO PURO: so' numeros entram e so' numeros saem. Nenhum servico da
	Roblox, nenhum Instance, nenhum estado global.

	POR QUE ELE E' SEPARADO DA CAMERA

	Porque assim ele pode ser TESTADO. O enquadramento e' a parte do kit em que
	um erro custa mais caro e aparece menos: um telao meio cortado nao levanta
	excecao nenhuma, nao entra em log nenhum, e so' e' percebido por quem
	assiste -- que nao vai avisar, vai so' sair da live. Deixar essa conta
	dentro de um script de cliente significaria que a unica forma de conferi-la
	seria abrir o Studio e olhar, toda vez.

	Aqui ela roda no `luau` puro, sem Roblox nenhum, e tem uma suite de casos
	em roblox/testes/enquadramento.spec.luau que cobre avatar normal, avatar
	crescido, colosso, primeira e ultima fileira, em 16:9 e em 9:16.

	═══════════════════════════════════════════════════════════════════
	O PROBLEMA, EM UMA FRASE
	═══════════════════════════════════════════════════════════════════

	Onde por a lente pra que o TELAO (la' no fundo, alto) e o AVATAR (na frente,
	de tamanho variavel) apareçam os dois no mesmo quadro, sem que nenhum dos
	dois fique pequeno demais?

	A resposta e' um par (distancia, inclinacao). A inclinacao e' facil depois
	que a distancia esta' escolhida: e' o meio do caminho entre o ponto mais
	alto e o mais baixo que precisam aparecer. A distancia e' o problema de
	verdade, e e' resolvida por bissecao -- ver `resolver`.
]]

local Enquadramento = {}

export type Pedido = {
	-- ONDE ESTA' O ALVO, em coordenadas do mundo.
	alvoZ: number,
	alvoPes: number,
	alvoTopo: number,
	--[[ O TOPO DO BALAO DO NOME. Opcional; sem ele vale o `alvoTopo`.

		ELE EXISTE PORQUE O NOME SUMIA DO QUADRO.

		O balao mora ACIMA da cabeca (ROTULO.ALTURA studs de folga, mais a
		altura do proprio balao), e o enquadramento so' declarava pes e cabeca.
		Enquanto a lente ficava longe isso nao aparecia: sobrava quadro de
		sobra em cima. Conforme a camera foi chegando perto -- que e' o pedido
		do produto -- a borda de cima passou a cortar exatamente a faixa onde
		o nick estava escrito. O boneco aparecia inteiro e ANONIMO, que e' o
		contrario do que esta live faz.

		SEPARADO do `alvoTopo` porque os dois respondem perguntas diferentes:
		este diz o que precisa CABER, e o `alvoTopo` diz onde fica o meio do
		CORPO -- que e' o que decide a altura da lente. Juntar os dois faria a
		camera subir pra altura do balao e olhar o boneco de cima de novo. ]]
	alvoTopoQuadro: number?,
	-- ONDE ESTA' O TELAO, em coordenadas do mundo.
	telaoZ: number,
	telaoTopo: number,
	-- A LENTE.
	fov: number,
	margem: number,
	-- A CAMERA.
	alturaBase: number,
	partida: number,
	minimo: number,
	maximo: number,
	--[[ Ate' onde o TELAO pode empurrar a lente. Opcional; sem ele vale o
		`maximo`, que e' o comportamento antigo.

		Existe porque o telao mandava no plano inteiro: ele fica 74 studs atras
		da formacao, e caber o topo dele junto com o avatar custava dezenas de
		studs de recuo -- a live ficava longe por causa do FUNDO. Com um teto
		proprio, o telao vira o que ele e': o segundo item da lista de
		prioridades, nao o primeiro. ]]
	tetoComTelao: number?,
}

export type Plano = {
	distancia: number,
	-- Elevacao do eixo optico, em graus. Negativo = olhando pra baixo.
	eixo: number,
	altura: number,
	-- `false` quando nao houve distancia que coubesse os dois e o solver
	-- priorizou o avatar. Quem chama pode querer avisar; a camera nao avisa,
	-- so' entrega o melhor quadro possivel.
	comTelao: boolean,
}

--[[ A elevacao de um ponto visto da camera, em graus. Positivo = acima.

	So' o plano vertical (Z e Y) importa: no modo seguir a camera fica sempre no
	mesmo X do alvo, entao o enquadramento e' um problema bidimensional. ]]
function Enquadramento.elevacao(yPonto: number, zPonto: number,
	yCam: number, zCam: number): number
	-- O piso de 0.01 evita o atan2(algo, 0) de uma camera exatamente em cima do
	-- ponto -- que nao acontece na live, mas acontece num teste com numeros
	-- redondos, e uma divisao por zero num teste e' um teste que mente.
	local dz = math.max(zCam - zPonto, 0.01)
	return math.deg(math.atan2(yPonto - yCam, dz))
end

--[[ O maior e o menor angulo que o quadro precisa cobrir, nesta distancia.

	TUDO AQUI E' Y DO MUNDO, e nao altura relativa ao alvo. A distincao parece
	pedante ate' voce misturar as duas: o topo do telao e' um Y absoluto, entao
	medir o avatar em "altura a partir dos pes" faria duas coordenadas
	diferentes conviverem na mesma conta. Enquanto o palco tem o piso em y=0 os
	numeros batem por coincidencia, e o erro fica invisivel -- ate' alguem subir
	o palco um stud e o telao sair do quadro sem explicacao. ]]
function Enquadramento.abertura(p: Pedido, d: number, yCam: number,
	comTelao: boolean): (number, number)
	local zCam = p.alvoZ + d
	local pes = Enquadramento.elevacao(p.alvoPes, p.alvoZ, yCam, zCam)
	-- O topo do QUADRO e' o do balao do nome quando ele foi informado. Sem
	-- isto a borda de cima corta exatamente a faixa onde o nick esta' escrito.
	local cabeca = Enquadramento.elevacao(
		p.alvoTopoQuadro or p.alvoTopo, p.alvoZ, yCam, zCam)
	local menor = math.min(pes, cabeca)
	local maior = math.max(pes, cabeca)
	if comTelao then
		local topo = Enquadramento.elevacao(p.telaoTopo, p.telaoZ, yCam, zCam)
		menor = math.min(menor, topo)
		maior = math.max(maior, topo)
	end
	return menor, maior
end

-- Quantos passos de bissecao. 18 fecham um intervalo de 100 studs em menos de
-- meio milesimo -- muito alem do que a tela distingue, e ainda assim barato.
local PASSOS = 18

--[[ Acha a menor distancia, a partir de `partida`, em que tudo cabe.

	A busca e' uma BISSECAO e nao uma formula fechada, e o motivo e' honesto: a
	abertura necessaria em funcao da distancia e' a diferenca de dois
	arco-tangentes com centros diferentes (o alvo e o telao estao a distancias
	distintas da lente), e isolar `d` daria uma expressao que ninguem
	conseguiria conferir depois. A abertura CAI monotonicamente conforme a
	camera se afasta -- os dois arco-tangentes encolhem juntos -- entao a
	bissecao acha a resposta em 18 passos, custa nada, e da' pra explicar em
	duas linhas. ]]
local function menorQueCabe(p: Pedido, yCam: number, limite: number,
	comTelao: boolean): number?
	local function cabe(d: number): boolean
		local menor, maior = Enquadramento.abertura(p, d, yCam, comTelao)
		return (maior - menor) <= limite
	end

	-- Com o telao na conta, o recuo tem teto proprio (ver `tetoComTelao`): e'
	-- o que impede o fundo de decidir o plano da live inteira.
	local teto = if comTelao
		then math.min(p.tetoComTelao or p.maximo, p.maximo)
		else p.maximo

	if cabe(p.partida) then
		return p.partida
	end
	if teto <= p.partida or not cabe(teto) then
		return nil
	end

	local perto, longe = p.partida, teto
	for _ = 1, PASSOS do
		local meio = (perto + longe) / 2
		if cabe(meio) then
			longe = meio
		else
			perto = meio
		end
	end
	return longe
end

--[[ Resolve o plano. Nunca falha: sempre devolve um quadro utilizavel. ]]
function Enquadramento.resolver(p: Pedido): Plano
	--[[ A camera sobe junto com o alvo. Sem isto, um boneco de 36 studs seria
		olhado a partir do tornozelo: o quadro caberia (a bissecao garante), mas
		a composicao ficaria com o gigante inteiro na metade de cima e o chao
		vazio embaixo. ]]
	local yCam = p.alvoPes + p.alturaBase + (p.alvoTopo - p.alvoPes) * 0.5
	local limite = p.fov - 2 * p.margem

	local comTelao = true
	local d = menorQueCabe(p, yCam, limite, true)

	if not d then
		--[[ Nem no limite de recuo os dois cabem. Acontece com o colosso:
			enquadrar um boneco de 40x JUNTO com o telao exigiria centenas de
			studs de recuo, e ai' os dois ficariam pequenos -- o presente mais
			caro da live viraria um pontinho ao lado de um telao ilegivel.

			Priorizar o avatar entrega pelo menos uma das duas coisas grande na
			tela, e o telao continua aparecendo no fundo (so' nao inteiro). ]]
		comTelao = false
		d = menorQueCabe(p, yCam, limite, false) or p.maximo
	end

	d = math.clamp(d, p.minimo, p.maximo)
	local menor, maior = Enquadramento.abertura(p, d, yCam, comTelao)
	return {
		distancia = d,
		eixo = (menor + maior) / 2,
		altura = yCam,
		comTelao = comTelao,
	}
end

--[[ A meia-abertura HORIZONTAL, em graus, derivada da vertical.

	E' com ela que se responde "quanto do telao aparece num video em pe'?". A
	resposta e' menos do que quase todo mundo espera: num 9:16, a abertura
	horizontal e' pouco mais de um terco da de um 16:9 com a MESMA lente. Por
	isso a mensagem do telao vive numa faixa central estreita -- ver o
	Cenario.model.json. ]]
function Enquadramento.meiaAberturaHorizontal(fov: number, proporcao: number): number
	return math.deg(math.atan(math.tan(math.rad(fov / 2)) * proporcao))
end

--[[ Quantos studs de largura cabem no quadro a uma certa distancia. ]]
function Enquadramento.larguraVisivel(fov: number, proporcao: number,
	distancia: number): number
	return 2 * distancia
		* math.tan(math.rad(Enquadramento.meiaAberturaHorizontal(fov, proporcao)))
end

return Enquadramento
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="10">
      <Properties>
        <string name="Name">Avatares</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Cria e remove os avatares.

	COMO A SKIN REAL DA PESSOA VIRA UM BONECO DANCANDO

	  GetHumanoidDescriptionFromUserIdAsync(id)              a aparencia dela
	  CreateHumanoidModelFromDescriptionAsync(desc, R15)     o corpo montado

	Dois passos, e nao o CreateHumanoidModelFromUserIdAsync direto, por um motivo
	so': aquele devolve o rig que a PESSOA usa, R6 ou R15, e nao deixa escolher.
	Uma formacao com R6 e R15 misturados nao consegue dancar a mesma animacao --
	metade ficaria parada no meio da coreografia. Passando pela description, todo
	mundo sai R15 e a formacao dança junta.

	TUDO AQUI PODE FALHAR. As duas chamadas fazem HTTP por baixo e sao limitadas
	pela Roblox. Cada uma vai de pcall, e um avatar que nao carrega e' so' um
	avatar que nao aparece -- nunca um erro que derruba a live.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

local Avatares = {}

export type Avatar = {
	modelo: Model,
	--[[ A posicao dele na lista da Formacao. -1 = fora da grade (o colosso).

		E' um INDICE e nao uma posicao no mundo porque a posicao muda: quando um
		vizinho cresce, a formacao inteira se reacomoda e o CFrame deste avatar
		passa a ser outro. Guardar o CFrame aqui deixaria as duas metades em
		desacordo -- e o sintoma seria um boneco parado no lugar antigo,
		atravessado no novo vizinho. ]]
	indice: number,
	tiktok_id: string,
	nascido: number,
	vida: number,
	prio: number,
	-- O tamanho ATUAL, ja' com todo o crescimento aplicado.
	escala: number,
	--[[ O tamanho que o CORPO tem neste instante.

		Diferente do `escala` durante os poucos decimos de segundo de uma
		animacao de crescimento: o `escala` ja' vale o destino (a formacao
		precisa reservar o espaco antes), enquanto este acompanha o corpo. E' o
		que decide a que altura plantar os pes -- usar o destino aqui faria o
		boneco flutuar acima do palco ate' a animacao alcancar. ]]
	escalaVisual: number,
	-- Um crescimento em andamento cancela o anterior. Ver `Avatares.crescer`.
	geracao: number,
}

--[[ As animacoes existem como INSTANCIAS FIXAS, criadas uma vez.

	Trocar o AnimationId de uma Animation ja' carregada nao afeta as faixas que
	ja' sairam dela, e as proximas cargas viriam de um cache confuso -- o tipo de
	bug que aparece como "as vezes a danca certa, as vezes a antiga". Uma
	instancia por danca mantem cada uma com a sua identidade. ]]
local function novaAnimacao(nome: string, id: number): Animation
	local anim = Instance.new("Animation")
	anim.Name = nome
	anim.AnimationId = "rbxassetid://" .. tostring(id)
	return anim
end

local animacaoPrincipal = novaAnimacao("Principal", Config.ANIMACAO)
local animacaoReserva = novaAnimacao("Reserva", Config.ANIMACAO_RESERVA)
local animacaoEspecial = novaAnimacao("Especial", Config.ANIMACAO_ESPECIAL)

--[[ Uma danca por PRESENTE: "rosquinha", "oculos", "galaxia".

	E' o que faz o presente ser visivel de longe. Quem assiste nao le' o nome do
	presente no rotulo -- ele e' pequeno demais no video de um celular. O que se
	ve' e' o PASSO mudar: chegou alguem dancando diferente do resto da formacao,
	entao alguem pagou por alguma coisa.

	Montado a partir do Config.DANCAS, e nao escrito na mao aqui, pra adicionar
	uma danca nova ser uma linha no Config -- e nao uma linha no Config mais
	outra aqui que alguem vai esquecer. ]]
local dancasDePresente: { [string]: Animation } = {}
for nome, id in pairs(Config.DANCAS) do
	dancasDePresente[nome] = novaAnimacao("Danca_" .. nome, id)
end

-- Qual danca vale de verdade. Decidido UMA vez, na subida (ver `escolherDanca`).
local animacaoNormal = animacaoPrincipal

-- Qual danca vale AGORA. Vale tambem pra quem nascer no meio da troca: e'
-- sempre esta variavel que o `dancar` consulta.
local naEspecial = false
local jaAvisouDaAnimacao = false

--[[ O RELOGIO COMUM DA DANCA.

	Todo mundo toca a mesma animacao a partir deste instante de referencia. E' o
	que permite um avatar que chegou agora entrar no MESMO PASSO de quem ja'
	estava dancando: em vez de comecar do zero, ele entra no ponto em que a
	musica ja' esta'.

	Sem isso, cada avatar comeca a coreografia no proprio tempo e a formacao vira
	cem pessoas dancando desencontradas -- que e' exatamente o oposto do efeito
	que faz a live parecer produzida. ]]
function Avatares.iniciarRelogio()
	workspace:SetAttribute("EpocaDanca", workspace:GetServerTimeNow())
end

--[[ A animacao principal carrega mesmo? Se nao, cai pra reserva.

	POR QUE ESTE TESTE PRECISA EXISTIR

	`LoadAnimation` NAO falha quando o asset e' inacessivel. Ele devolve um
	AnimationTrack normal, o `Play()` funciona, o `IsPlaying` diz true -- e o
	boneco fica parado em pe'. O download do asset acontece depois, por baixo, e
	quando ele e' negado ninguem avisa o codigo.

	O unico sinal confiavel e' o `Length`: enquanto o asset nao chega, ele fica
	em 0. Asset que nunca chega fica em 0 pra sempre.

	Isso importa porque a danca principal e' de TERCEIRO (ver o Config). Se a
	permissao dela cair no meio de uma live, sem este teste a formacao inteira
	congela sem uma linha de erro. Com ele, a live troca de danca sozinha e
	segue.

	Roda UMA vez, na subida, num boneco de mentira que e' destruido logo depois. ]]
local ESPERA_DE_CARGA_S = 6

--[[ Relogio de PAREDE, e nao os.clock.

	Em Luau o os.clock devolve tempo de CPU, e nao tempo que passou de verdade.
	Num servidor de Studio parado esperando download de asset -- que e'
	exatamente a situacao aqui -- ele anda MUITO mais devagar que o relogio: a
	espera de "6 segundos" virava dezenas de segundos reais, e a primeira coisa
	que quem comprou via ao apertar Play era um Studio aparentemente travado,
	antes do primeiro boneco. ]]
local function relogio(): number
	return workspace:GetServerTimeNow()
end

local function carrega(anim: Animation): boolean
	local modelo = Instance.new("Model")
	-- Nome de verdade: durante os 6 segundos do teste estes bonecos de mentira
	-- aparecem no Explorer do Studio, e "Model, Model, Model" no meio da subida
	-- parece coisa quebrada.
	modelo.Name = "TesteDeDanca_" .. anim.Name
	local humanoide = Instance.new("Humanoid")
	humanoide.Parent = modelo
	local animador = Instance.new("Animator")
	animador.Parent = humanoide
	-- Precisa estar no DataModel: um Animator solto nao baixa asset nenhum.
	modelo.Parent = workspace

	local carregou = false
	local ok, faixa = pcall(function()
		return animador:LoadAnimation(anim)
	end)
	if ok and faixa then
		local limite = relogio() + ESPERA_DE_CARGA_S
		while faixa.Length == 0 and relogio() < limite do
			task.wait(0.1)
		end
		carregou = faixa.Length > 0
	end

	modelo:Destroy()
	return carregou
end

--[[ Confere TODAS as dancas de uma vez, e derruba pro padrao as que falharem.

	EM PARALELO, e isso importa: cada conferencia espera ate' 6 segundos pelo
	download. Uma depois da outra, seis dancas dariam mais de meio minuto de tela
	preta na subida -- e quem comprou o kit veria o Studio "travado" logo no
	primeiro Play, que e' o pior primeiro minuto possivel. Todas juntas, a espera
	continua sendo a de uma so'.

	Uma danca de presente que nao carrega vira a danca padrao em vez de virar um
	boneco parado em pe'. E' a mesma decisao da reserva la' de cima: a live nunca
	para por causa de um asset. ]]
function Avatares.escolherDanca()
	local resultado: { [string]: boolean } = {}
	local faltam = 0

	local function conferir(chave: string, anim: Animation)
		faltam += 1
		task.spawn(function()
			resultado[chave] = carrega(anim)
			faltam -= 1
		end)
	end

	conferir("principal", animacaoPrincipal)
	conferir("especial", animacaoEspecial)
	for nome, anim in pairs(dancasDePresente) do
		conferir("presente:" .. nome, anim)
	end

	-- A folga de 2s cobre o tempo entre agendar as tarefas e elas comecarem; sem
	-- ela, uma subida engasgada sairia daqui achando que tudo falhou.
	local limite = relogio() + ESPERA_DE_CARGA_S + 2
	while faltam > 0 and relogio() < limite do
		task.wait(0.1)
	end

	if resultado["principal"] then
		animacaoNormal = animacaoPrincipal
		print("[avatares] danca principal OK (" .. tostring(Config.ANIMACAO) .. ")")
	else
		animacaoNormal = animacaoReserva
		warn("[avatares] a danca principal (" .. tostring(Config.ANIMACAO) .. ") nao "
			.. "carregou -- usando a reserva da Roblox (" .. tostring(Config.ANIMACAO_RESERVA)
			.. "). Isso e' PERMISSAO do asset: ele e' de outro criador, e precisa ser "
			.. "compartilhado com esta experiencia pelo Creator Hub.")
	end

	if not resultado["especial"] then
		animacaoEspecial = animacaoReserva
		warn("[avatares] a danca ESPECIAL (" .. tostring(Config.ANIMACAO_ESPECIAL)
			.. ") nao carregou -- a troca geral vai usar a reserva.")
	end

	local ligadas = {}
	for nome, _ in pairs(dancasDePresente) do
		if resultado["presente:" .. nome] then
			table.insert(ligadas, nome)
		else
			-- Tirar do mapa E' o fallback: o `dancaDe` nao acha a chave e devolve
			-- a danca padrao, sem nenhum `if` extra no caminho quente.
			dancasDePresente[nome] = nil
			warn("[avatares] a danca do presente '" .. nome .. "' nao carregou -- "
				.. "quem mandar esse presente vai dancar a danca padrao. Confira o "
				.. "ID em Config.luau (DANCAS).")
		end
	end
	table.sort(ligadas)
	print("[avatares] dancas de presente prontas: " ..
		(if #ligadas > 0 then table.concat(ligadas, ", ") else "nenhuma"))
end

function Avatares.epoca(): number
	return (workspace:GetAttribute("EpocaDanca") :: number) or 0
end

function Avatares.trocarDanca(especial: boolean)
	naEspecial = especial
end

--[[ "FF2D6F" -> Color3. Lixo vira branco.

	Nome sem cor e' muito melhor que avatar sem nome: um hexadecimal torto vindo
	do painel nao pode fazer o rotulo inteiro sumir. ]]
local function corDoHex(hex: string?): Color3
	local limpo = string.gsub(tostring(hex or ""), "#", "")
	if #limpo ~= 6 then
		return Color3.new(1, 1, 1)
	end
	local n = tonumber(limpo, 16)
	if not n then
		return Color3.new(1, 1, 1)
	end
	return Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
end

--[[ A marca que o CLIENTE usa pra achar todos os rotulos sem varrer o Workspace.

	O nome esta' escrito igual no Rotulos.client.luau, e os dois PRECISAM
	combinar: uma letra diferente e o cliente simplesmente nao acha rotulo
	nenhum, sem erro em lugar nenhum -- os baloes ficam todos ligados e o
	excesso volta calado.

	CollectionService, e nao um Folder com referencias: o ciclo apaga cem
	avatares de uma vez, e a marca sai junto com o objeto destruido sozinha. Uma
	lista na mao ficaria segurando cem baloes mortos na memoria. ]]
local MARCA_ROTULO = "RotuloDaLive"

--[[ O balao com o nome, em cima da cabeca.

	Duas linhas: o @ do TikTok em cima e o nick do Roblox embaixo. As duas
	importam, e por motivos diferentes -- o @ e' como a pessoa se reconhece no
	chat, e o nick e' a prova de que aquele boneco e' mesmo a skin dela. ]]
--[[ Poe o balao no tamanho e na altura certos pro tamanho ATUAL do boneco.

	SEPARADO DA CRIACAO PORQUE O TAMANHO MUDA DEPOIS.

	Tanto o tamanho quanto a altura do balao sao medidos em STUDS DO MUNDO --
	eles NAO crescem junto quando o modelo cresce. Enquanto o avatar nascia e
	morria do mesmo tamanho, calcular isto uma vez bastava. Com o crescimento
	por presente, nao basta mais: o boneco que recebeu quatro galaxias fica
	quatro vezes maior e o balao dele continuaria do tamanho de nascimento --
	um selo minusculo perdido no peito de um gigante, justamente no avatar que
	mais interessa ler.

	Entao esta funcao roda no nascimento E a cada crescimento.

	A raiz quadrada na LARGURA e' de proposito. A altura precisa crescer junto
	com o corpo (senao o balao entra na cabeca), mas a largura crescer igual
	faria o rotulo de um gigante tapar os vizinhos dos dois lados. ]]
local function ajustarRotulo(balao: BillboardGui, escala: number)
	local tamanho = math.max(escala, 1)
	balao.Size = UDim2.fromScale(
		Config.ROTULO.LARGURA * math.sqrt(tamanho), 2.2 * math.sqrt(tamanho))
	balao.StudsOffsetWorldSpace = Vector3.new(0, Config.ROTULO.ALTURA * tamanho, 0)

	--[[ O ALCANCE deste rotulo: de que distancia ele ainda aparece.

		RAIZ QUADRADA, e nao proporcional, porque e' a MESMA LEI QUE A CAMERA
		USA PRA RECUAR de um boneco grande (ver `destinoSeguir` no
		Camera.client.luau). As duas contas se cancelam: o avatar de escala 4
		fica duas vezes mais longe da lente, e o rotulo dele alcanca duas vezes
		mais longe -- entao ele fica legivel na mesma medida que o de escala 1.

		Sem isso, o presente MAIS CARO da live era justamente o unico a ficar
		sem nome: o colosso empurra a camera pra alem de 130 studs, e um alcance
		fixo de 68 nunca chegava la'.

		E COM TETO (ROTULO.ESCALA_TETO), senao o colosso de escala 40 ganhava um
		rotulo visivel de qualquer canto do mapa -- inclusive no plano aberto,
		onde a regra e' que os nomes somem.

		Gravado como ATRIBUTO porque quem decide de verdade se este rotulo
		aparece agora e' o cliente (Rotulos.client.luau): a distancia da camera
		muda 60 vezes por segundo, e isso e' conta do lado de quem esta' vendo,
		nao do servidor. O MaxDistance abaixo continua como rede de seguranca --
		se o script do cliente nao subir, o motor da Roblox ainda corta os
		rotulos de longe sozinho, em vez de desenhar cem deles. ]]
	local alcance = Config.ROTULO.DISTANCIA_MAX
		* math.sqrt(math.clamp(tamanho, 1, Config.ROTULO.ESCALA_TETO))
	balao:SetAttribute("Alcance", alcance)
	balao.MaxDistance = alcance
end

local function porRotulo(modelo: Model, spawn: any, cor: Color3, escala: number)
	local cabeca = modelo:FindFirstChild("Head")
	if not cabeca or not cabeca:IsA("BasePart") then
		return
	end

	local balao = Instance.new("BillboardGui")
	balao.Name = "Rotulo"
	balao.AlwaysOnTop = true
	ajustarRotulo(balao, escala)
	CollectionService:AddTag(balao, MARCA_ROTULO)
	balao.Parent = cabeca

	local fundo = Instance.new("Frame")
	fundo.Size = UDim2.fromScale(1, 1)
	fundo.BackgroundColor3 = Config.ROTULO.FUNDO
	fundo.BackgroundTransparency = Config.ROTULO.TRANSPARENCIA
	fundo.BorderSizePixel = 0
	fundo.Parent = balao

	local canto = Instance.new("UICorner")
	canto.CornerRadius = UDim.new(0, 8)
	canto.Parent = fundo

	local temNick = spawn.nick_roblox ~= ""

	local arroba = Instance.new("TextLabel")
	arroba.BackgroundTransparency = 1
	arroba.Size = UDim2.fromScale(1, if temNick then 0.55 else 1)
	arroba.Position = UDim2.fromScale(0, 0)
	arroba.Text = spawn.nickname
	-- A cor do presente sobe pro nome: e' o sinal mais barato de "esta pessoa
	-- pagou", legivel de relance mesmo num celular assistindo a live.
	arroba.TextColor3 = cor
	arroba.TextScaled = true
	arroba.Font = Enum.Font.GothamBold
	arroba.TextStrokeTransparency = 0.4
	arroba.Parent = fundo

	if temNick then
		local nick = Instance.new("TextLabel")
		nick.BackgroundTransparency = 1
		nick.Size = UDim2.fromScale(1, 0.45)
		nick.Position = UDim2.fromScale(0, 0.55)
		nick.Text = spawn.nick_roblox
		nick.TextColor3 = Config.ROTULO.COR_NICK
		nick.TextScaled = true
		nick.Font = Enum.Font.Gotham
		nick.TextStrokeTransparency = 0.5
		nick.Parent = fundo
	end
end

--[[ ───────────────────────── A AURA ─────────────────────────

	SO' pra quem mandou presente. Quem so' comentou nunca brilha, e isso e'
	regra: se todo mundo brilha, o brilho deixa de significar alguma coisa -- e a
	aura existe justamente pra separar, num relance, quem pagou de quem nao
	pagou.

	E' UM Highlight, E MAIS NADA.

	Ja' foi um SelectionBox por peca do corpo. Aquilo nao desenhava contorno:
	desenhava um CAIXOTE DE ARAME em volta de cada peca -- uma caixa no braco,
	outra na perna, outra na cabeca, e mais uma em cada acessorio, cabelo e
	chapeu. O boneco aparecia dentro de uma gaiola retangular, e o "brilho" so'
	atrapalhava a skin, que e' o produto inteiro deste jogo.

	Depois foi contorno + luz + faiscas. Tambem saiu. Luz de verdade nao respeita
	o corpo de ninguem: ela vaza pro chao, pinta os vizinhos e lava a cor da
	roupa da pessoa. Com cem bonecos, cem luzes coloridas viram uma mancha onde
	nao da' pra distinguir mais ninguem -- inclusive quem pagou.

	O Highlight faz o que as duas versoes tentavam fazer, e so' isso: segue a
	SILHUETA do modelo, acessorio incluido, e para exatamente onde o boneco para.
	Um objeto por avatar, sem particula, sem luz.

	E o Occluded (em vez de AlwaysOnTop) e' o que impede a aura de quem esta' na
	ULTIMA fileira de atravessar as fileiras da frente. Com AlwaysOnTop a
	multidao vira uma sopa de contornos flutuando por cima uns dos outros. ]]

-- Marca pra contar as auras vivas sem guardar contador nenhum: um ciclo apaga
-- cem avatares de uma vez, e um contador na mao ficaria dessincronizado na
-- primeira limpeza -- justamente onde ninguem olharia.
local MARCA_CONTORNO = "AuraContorno"

local function aurasVivas(): { Instance }
	local vivas = {}
	for _, item in ipairs(CollectionService:GetTagged(MARCA_CONTORNO)) do
		-- Filtra o que ja' saiu do jogo. Destruir tira as marcas sozinho, mas
		-- depender disso deixaria o teto errado por um detalhe do motor que
		-- ninguem lembraria de conferir.
		if item.Parent then
			table.insert(vivas, item)
		end
	end
	return vivas
end

--[[ Cabe mais uma aura? Se nao couber, o presente MAIS FORTE toma o lugar.

	O motor da Roblox desenha no maximo 31 Highlight de cada vez, e do 32 em
	diante ele nao desenha -- sem erro, sem aviso. Um teto simples ("cheio, entao
	este fica sem") daria o pior resultado possivel numa live cheia: vinte rosas
	de 1 moeda chegam primeiro, enchem o orcamento, e a galaxia de 1000 que
	chegar depois e' justamente a que fica sem aura nenhuma.

	Tirando a mais fraca, o orcamento sempre fica com os presentes que mais
	importam. Quem perde a aura e' sempre o mais barato que ainda esta' na tela. ]]
local function cabeAura(forca: number): boolean
	local vivas = aurasVivas()
	if #vivas < Config.BRILHO.MAX_CONTORNOS then
		return true
	end

	local maisFraca, menorForca = nil, math.huge
	for _, item in ipairs(vivas) do
		local f = tonumber(item:GetAttribute("Forca")) or 0
		if f < menorForca then
			menorForca, maisFraca = f, item
		end
	end

	-- `<` e nao `<=`: em empate quem ja' esta' na tela fica. Trocar auras entre
	-- iguais so' faria a formacao piscar sem mudar nada de util.
	if maisFraca and menorForca < forca then
		maisFraca:Destroy()
		return true
	end
	return false
end

local function porBrilho(modelo: Model, forca: number, cor: Color3)
	if forca < Config.BRILHO.CONTORNO_DESDE or forca <= 0 then
		return
	end
	if not cabeAura(forca) then
		return
	end

	--[[ Nada de caixa, nada de moldura, nada de sobra pra fora: o Highlight
		desenha exatamente a silhueta do modelo, braco por braco, cabelo, chapeu
		e acessorio incluidos. Se a pessoa esta' de asas, a aura tem asas.

		A cor vem inteira do presente -- vale igual pra rosa, rosquinha, oculos e
		galaxia, e pra qualquer cor que voce puser no painel. Nao existe nenhuma
		cor tratada de forma especial aqui.

		Nada disto depende do TAMANHO do boneco: o contorno e' desenhado em cima
		da geometria, entao um colosso ganha um colosso contornado sem precisar
		de nenhum ajuste de escala -- que era o que a luz e as faiscas exigiam. ]]
	local contorno = Instance.new("Highlight")
	contorno.Name = "AuraContorno"
	contorno.Adornee = modelo
	contorno.DepthMode = Enum.HighlightDepthMode.Occluded
	contorno.OutlineColor = cor
	contorno.FillColor = cor
	contorno.OutlineTransparency = math.clamp(
		Config.BRILHO.LINHA_BASE - Config.BRILHO.LINHA_POR_FORCA * forca, 0, 1)
	contorno.FillTransparency = math.clamp(
		Config.BRILHO.PREENCHIMENTO_BASE
			- Config.BRILHO.PREENCHIMENTO_POR_FORCA * forca, 0.85, 1)
	-- A forca fica gravada: e' por ela que o `cabeAura` sabe qual sacrificar.
	contorno:SetAttribute("Forca", forca)
	CollectionService:AddTag(contorno, MARCA_CONTORNO)
	contorno.Parent = modelo
end

--[[ Qual danca este boneco deve estar dancando AGORA.

	A ordem manda: a troca geral (o presente que muda a formacao inteira) vence
	tudo, porque ela e' um momento da live e nao uma caracteristica do avatar.
	Fora dela, cada um volta pra danca do PROPRIO presente -- que fica guardada
	no atributo, e nao numa tabela paralela, justamente pra sobreviver a' troca
	geral e voltar certa quando ela acabar.

	Guardar numa tabela `modelo -> danca` teria um custo escondido: a formacao e'
	apagada inteira a cada ciclo, e a tabela ficaria segurando cem modelos
	destruidos na memoria ate' alguem lembrar de limpa-la. ]]
local function dancaDe(modelo: Model): Animation
	if naEspecial then
		return animacaoEspecial
	end
	local nome = modelo:GetAttribute("Danca")
	if type(nome) == "string" and nome ~= "" then
		local propria = dancasDePresente[nome]
		if propria then
			return propria
		end
	end
	return animacaoNormal
end

--[[ Poe o avatar pra dancar, no passo em que a formacao ja' esta'.

	`TimePosition` e' o pulo do gato: em vez de comecar do zero, o avatar entra no
	ponto da coreografia que o relogio comum indica. ]]
local function dancar(modelo: Model)
	local humanoide = modelo:FindFirstChildOfClass("Humanoid")
	if not humanoide then
		return
	end

	local animador = humanoide:FindFirstChildOfClass("Animator")
	if not animador then
		animador = Instance.new("Animator")
		animador.Parent = humanoide
	end

	--[[ PARA o que ja' estava tocando ANTES de por a proxima.

		Sem isto, cada troca de danca SOMA uma faixa em cima da anterior em vez
		de substitui-la. Duas animacoes tocando no mesmo Humanoid nao dao erro:
		elas se misturam por peso, e o boneco fica tremendo entre dois passos --
		um defeito que so' aparece DEPOIS da primeira troca geral da live, ou
		seja, exatamente no momento mais caro dela, e que some quando voce testa
		de novo do zero. ]]
	for _, tocando in ipairs((animador :: Animator):GetPlayingAnimationTracks()) do
		tocando:Stop(0.15)
	end

	local ok, faixa = pcall(function()
		return (animador :: Animator):LoadAnimation(dancaDe(modelo))
	end)

	if not ok or not faixa then
		-- Avisa UMA vez. Sem o `jaAvisouDaAnimacao`, cem avatares que falham
		-- viram cem warnings identicos e o Output fica ilegivel justamente
		-- quando voce precisa dele.
		if not jaAvisouDaAnimacao then
			jaAvisouDaAnimacao = true
			warn("[avatares] a animacao nao carregou. Se o ID for de um emote "
				.. "do catalogo (tipo 61), ele NAO funciona aqui -- so' o ID da "
				.. "Animation (tipo 24) que mora dentro dele. Veja o Config.luau.")
		end
		return
	end

	faixa.Looped = true
	faixa:Play(0.2)

	-- Entra no passo em que todo mundo ja' esta'.
	local decorrido = workspace:GetServerTimeNow() - Avatares.epoca()
	if faixa.Length > 0 then
		faixa.TimePosition = decorrido % faixa.Length
	end
end

--[[ O tamanho final de um avatar. UM lugar so', e por um motivo concreto.

	Antes esta conta existia em dois lugares: o Principal calculava o tamanho do
	COLOSSO pra saber quantos slots reservar, e o Avatares calculava o dele
	sozinho pra chamar o ScaleTo. So' que o de ca' lia `spawn.escala` e limitava
	em 4 -- entao o colosso, que vem em `spawn.colosso` e pode chegar a 40,
	NUNCA crescia. Ele nascia do tamanho de gente normal, atras da formacao
	inteira, onde ninguem via.

	O presente mais caro do painel simplesmente nao fazia nada, e nao havia erro
	nenhum apontando pra isso. Com a conta num lugar so', os dois lados nao tem
	como discordar de novo. ]]
function Avatares.escalaDe(spawn: any): number
	local colosso = tonumber(spawn.colosso) or 0
	if colosso > 0 then
		return math.clamp(colosso, 0.5, 40)
	end
	return math.clamp(tonumber(spawn.escala) or 1, 0.5, 4)
end

--[[ Monta um avatar. Devolve nil se nao deu -- e nao dar e' normal.

	As duas chamadas da Roblox falham de verdade, com frequencia, sob limite de
	requisicao. Um avatar a menos numa live de cem e' invisivel; um erro nao
	tratado no meio do laco de spawn para a live inteira. ]]
function Avatares.criar(spawn: any, posicao: CFrame, pai: Instance): Model?
	local okDesc, descricao = pcall(function()
		return Players:GetHumanoidDescriptionFromUserIdAsync(spawn.roblox_id)
	end)
	if not okDesc or not descricao then
		return nil
	end

	local okModelo, modelo = pcall(function()
		return Players:CreateHumanoidModelFromDescriptionAsync(
			descricao, Enum.HumanoidRigType.R15)
	end)
	if not okModelo or not modelo then
		return nil
	end

	modelo.Name = "Avatar_" .. tostring(spawn.roblox_id)

	local humanoide = modelo:FindFirstChildOfClass("Humanoid")
	if humanoide then
		-- Nada de barra de vida nem de nome padrao: o rotulo proprio ja' diz
		-- quem e', e os dois juntos ficam empilhados e ilegiveis.
		humanoide.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoide.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		-- Sem isto o boneco pode ser empurrado pelo vizinho e a formacao
		-- desmancha sozinha ao longo da live.
		humanoide.WalkSpeed = 0
		humanoide.JumpPower = 0
	end

	local escala = Avatares.escalaDe(spawn)
	if escala ~= 1 then
		pcall(function()
			modelo:ScaleTo(escala)
		end)
	end

	--[[ ANCORA SO' O HumanoidRootPart. NUNCA o corpo inteiro.

		Este e' o erro que faz o boneco APARECER e ficar PARADO, congelado numa
		pose, sem nenhuma mensagem de erro em lugar nenhum.

		O motivo: a animacao de um rig R15 acontece pelos Motor6D, que giram uma
		peca em relacao a' outra. E uma peca ANCORADA nao obedece a Motor6D
		nenhum -- ancorar tudo trava a coreografia inteira. A animacao carrega,
		toca, o AnimationTrack diz que esta' rodando, e mesmo assim nada se mexe.

		Ancorando so' a raiz: ela segura o boneco parado no lugar da grade (sem
		cair, sem ser empurrado pelo vizinho) e o resto do corpo continua livre
		pros Motor6D animarem. E' o jeito padrao de fazer figurante estatico.

		Tudo isto DEPOIS do ScaleTo -- redimensionar com peca ancorada briga com
		a fisica e o boneco sai torto ou atravessa o chao. ]]
	for _, peca in ipairs(modelo:GetDescendants()) do
		if peca:IsA("BasePart") then
			peca.Anchored = false
			-- Ninguem colide com ninguem: cem bonecos com colisao ligada se
			-- empurram e a formacao desmancha sozinha em segundos.
			peca.CanCollide = false
			peca.Massless = true
		end
	end

	local raiz = modelo:FindFirstChild("HumanoidRootPart")
	if raiz and raiz:IsA("BasePart") then
		raiz.Anchored = true
	end

	-- PivotTo e nao CFrame direto: o pivo de um modelo R15 esta' no
	-- HumanoidRootPart, e mover peca por peca desmontaria o boneco.
	Avatares.plantar(modelo, posicao, escala)

	--[[ A danca deste presente fica GRAVADA no boneco, antes de ele entrar em
		cena. E' o que faz ele voltar pra danca certa quando uma troca geral
		acaba -- sem isto, todo mundo voltaria pra danca padrao e a rosquinha
		perderia a dela pro resto da vida do avatar. ]]
	modelo:SetAttribute("Danca", tostring(spawn.danca or ""))
	modelo.Parent = pai

	local cor = corDoHex(spawn.cor)
	porRotulo(modelo, spawn, cor, escala)
	porBrilho(modelo, tonumber(spawn.brilho) or 0, cor)
	dancar(modelo)

	return modelo
end

--[[ ───────────────────── O CRESCIMENTO ─────────────────────

	O que o telao promete: "envie presentes e seu personagem cresce".

	COMO UM BONECO CRESCE SEM QUEBRAR

	`Model:ScaleTo` e' o unico caminho certo aqui, e nao mexer no tamanho das
	pecas na mao: ele escala os Motor6D, os Attachment e os acessorios junto.
	Redimensionar peca por peca deixaria o cabelo flutuando ao lado da cabeca e
	a animacao andando em passos do tamanho antigo -- o boneco "cresceria"
	desmontado.

	Tres cuidados que este codigo tem e que nao sao obvios:

	1. OS PES VOLTAM PRO CHAO A CADA PASSO. O ScaleTo escala em torno do PIVO,
	   que num R15 fica na cintura. Sem reposicionar, metade do corpo que
	   cresceu vai pra baixo do piso -- o boneco afunda no palco conforme
	   cresce.

	2. O ROTULO E' REAJUSTADO JUNTO. Ele vive em studs do mundo e nao escala com
	   o modelo (ver `ajustarRotulo`).

	3. UM CRESCIMENTO CANCELA O ANTERIOR. Numa live real chegam varios presentes
	   da mesma pessoa em segundos, e duas interpolacoes rodando ao mesmo tempo
	   no mesmo boneco disputam o ScaleTo a cada quadro: o resultado e' um
	   avatar tremendo entre dois tamanhos, e o final e' o da tarefa que
	   terminar por ultimo -- ou seja, as vezes MENOR do que ja' estava. A
	   `geracao` resolve: cada crescimento novo invalida o que estava correndo.

	Devolve o tamanho final (ja' aplicado logicamente, mesmo que a animacao
	ainda esteja correndo). Quem chama precisa dele na hora pra reacomodar a
	formacao -- esperar a animacao terminar pra so' entao abrir espaco faria o
	boneco crescer POR CIMA dos vizinhos durante a animacao inteira. ]]
local PASSOS_DO_CRESCIMENTO = 14

function Avatares.crescer(avatar: Avatar, destino: number, segundos: number,
	aoPassar: ((number) -> ())?)
	local de = avatar.escala
	local ate = math.max(destino, 0.1)
	if math.abs(ate - de) < 0.01 then
		return
	end

	avatar.geracao += 1
	local minha = avatar.geracao
	-- A escala LOGICA vale desde ja': a formacao precisa reservar o espaco do
	-- tamanho final antes de o corpo chegar la'.
	avatar.escala = ate

	task.spawn(function()
		local modelo = avatar.modelo
		local passos = math.max(1, math.floor(PASSOS_DO_CRESCIMENTO))
		local intervalo = math.max(segundos, 0) / passos

		for i = 1, passos do
			-- Outro presente chegou e comecou um crescimento novo: este aqui
			-- para AGORA, sem tocar em mais nada. Continuar escreveria um
			-- tamanho velho por cima do novo.
			if avatar.geracao ~= minha or not modelo.Parent then
				return
			end

			--[[ Suavizacao "ease-out": rapido no comeco, desacelerando no fim.
				Linear parece mecanico; comecar rapido e' o que faz o
				crescimento ser PERCEBIDO por quem esta' assistindo pelo
				celular, que e' o ponto de ele existir. ]]
			local t = i / passos
			local suave = 1 - (1 - t) * (1 - t)
			local agora = de + (ate - de) * suave

			local ok = pcall(function()
				modelo:ScaleTo(agora)
			end)
			if not ok then
				return
			end
			if aoPassar then
				aoPassar(agora)
			end
			if intervalo > 0 then
				task.wait(intervalo)
			end
		end
	end)
end

--[[ Poe o boneco em pe' no chao, na posicao da grade, no tamanho que ele tem.

	O `3 * escala` e' a distancia do pivo (a cintura de um R15) ate' a sola do
	pe'. Um lugar so' pra esta conta porque ela e' usada no nascimento E a cada
	passo do crescimento, e as duas discordarem faria o boneco afundar no palco
	enquanto cresce. ]]
function Avatares.plantar(modelo: Model, posicao: CFrame, escala: number)
	pcall(function()
		modelo:PivotTo(posicao + Vector3.new(0, 3 * escala, 0))
	end)
end

--[[ O balao deste avatar, pra reajustar quando ele cresce. nil se nao tem. ]]
function Avatares.rotuloDe(modelo: Model): BillboardGui?
	local cabeca = modelo:FindFirstChild("Head")
	if not cabeca then
		return nil
	end
	local balao = cabeca:FindFirstChild("Rotulo")
	return if balao and balao:IsA("BillboardGui") then balao else nil
end

function Avatares.ajustarRotulo(modelo: Model, escala: number)
	local balao = Avatares.rotuloDe(modelo)
	if balao then
		ajustarRotulo(balao, escala)
	end
end

--[[ Em que FILEIRA este avatar esta' agora.

	O cliente le' isto pra mostrar os nomes de uma fileira por vez (ver
	Rotulos.client.luau). Precisa ser reescrito a cada re-layout da formacao:
	quando alguem cresce, os que vinham depois podem mudar de fileira, e um
	rotulo marcado com a fileira antiga apareceria fora da vez -- um nome
	solto no meio de uma fileira sem nomes. ]]
function Avatares.marcarFileira(modelo: Model, fileira: number)
	local balao = Avatares.rotuloDe(modelo)
	if balao then
		balao:SetAttribute("Fileira", fileira)
	end
end

--[[ Troca a danca de TODA a formacao que ja' esta' na tela.

	Reinicia o relogio junto: sem isso, os que ja' estavam entrariam na animacao
	nova no ponto da ANTIGA, e a troca sairia desencontrada logo no instante em
	que ela mais precisa parecer coreografada.

	Na VOLTA (especial = false) cada um pega a propria danca de novo, e nao a
	padrao: quem chegou de galaxia continua sendo quem chegou de galaxia depois
	que o momento passa. Quem cuida disso e' o `dancaDe`, lendo o atributo. ]]
function Avatares.trocarDancaDeTodos(pasta: Instance, especial: boolean)
	Avatares.trocarDanca(especial)
	Avatares.iniciarRelogio()
	for _, modelo in ipairs(pasta:GetChildren()) do
		if modelo:IsA("Model") then
			dancar(modelo)
		end
	end
end

return Avatares
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="11">
      <Properties>
        <string name="Name">Formacao</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Onde cada avatar fica em pe'.

	A regra e' uma grade preenchida em ORDEM DE CHEGADA, e nunca fora dela:

	  - os avatares entram um por um, lado a lado, na fileira atual;
	  - quando a fileira enche, a proxima nasce NA FRENTE da anterior;
	  - quando a grade inteira enche, o ciclo acaba: a camera abre pra mostrar
	    tudo, a formacao e' apagada, e recomeca do zero.

	A camera fica do lado +Z de cada avatar, entao "na frente" e' +Z: cada
	fileira nova tem Z maior e fica mais perto de quem assiste.

	═══════════════════════════════════════════════════════════════════
	POR QUE ISTO E' UM LAYOUT QUE SE RECALCULA, E NAO UM CURSOR QUE SO' ANDA
	═══════════════════════════════════════════════════════════════════

	A versao anterior reservava slots com um cursor que so' avancava, e a
	posicao de cada avatar era decidida UMA vez, no nascimento. Isso funcionava
	enquanto o tamanho de um boneco nunca mudava depois de ele nascer.

	So' que agora o presente FAZ O AVATAR CRESCER (e' a promessa do telao), e um
	boneco que cresce ocupa mais largura e mais profundidade do que ocupava
	quando nasceu. Com posicoes congeladas, o resultado era garantido e feio: o
	avatar de quem mandou a galaxia inflava POR CIMA dos dois vizinhos, com
	bracos atravessando corpos, e empurrava metade do corpo pra dentro da
	fileira da frente. Ou seja, exatamente o presente mais caro da live e' o que
	quebraria a formacao.

	Aqui a formacao guarda a LISTA de quem esta' nela, e as posicoes sao
	derivadas dessa lista sempre que alguem entra ou muda de tamanho. Cresceu?
	Todo mundo se reacomoda em volta, e ninguem se atravessa.

	A ORDEM DA LISTA NUNCA MUDA, e e' isso que preserva a propriedade que fazia
	o cursor valer a pena: quem chegou por ultimo continua sendo o ultimo da
	lista, ou seja, na fileira mais perto da camera. Recalcular reacomoda; nao
	reordena.

	Modulo sem estado global e sem efeito colateral: da' pra raciocinar sobre
	ele inteiro sem abrir o Studio, e e' por isso que ele tem teste proprio.
]]

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Config"))

local Formacao = {}
Formacao.__index = Formacao

--[[ Um lugar ocupado na grade.

	`escala` e' o tamanho ATUAL (ele muda quando a pessoa recebe presente).
	`fileira`, `coluna` e `cframe` sao derivados -- o `recalcular` os reescreve
	inteiros toda vez, e ninguem deve escrever neles de fora. ]]
export type Ocupante = {
	escala: number,
	vivo: boolean,
	fileira: number,
	coluna: number,
	slots: number,
	cframe: CFrame,
}

export type Formacao = typeof(setmetatable(
	{} :: {
		ocupantes: { Ocupante },
		--[[ Quantos por fileira NESTE ciclo.

			Fica na instancia, e nao lido do painel a cada chamada, porque o
			painel pode mudar isto no meio da live: com a regua mudando embaixo
			de gente ja' plantada, a formacao inteira saltaria de lugar no meio
			da transmissao. O valor novo so' entra no `limpar`, ou seja, no
			ciclo seguinte -- e o Principal fecha o ciclo na hora justamente pra
			a mudanca nao demorar cem avatares pra aparecer. ]]
		porFila: number,
		-- Quantos slots a grade inteira esta' usando agora. Derivado.
		usados: number,
		-- Z de cada fileira, em studs. Derivado.
		zDaFileira: { [number]: number },
	},
	Formacao
))

--[[ Quantos por fileira o painel pede agora. O Principal espelha o valor num
	atributo do workspace; sem atributo, vale o padrao do Config. ]]
local function porFilaDoPainel(): number
	local v = tonumber(workspace:GetAttribute("PorFila"))
	if not v then
		return Config.POR_FILA
	end
	return math.clamp(math.floor(v), 2, 20)
end

local function totalDoPainel(): number
	local v = tonumber(workspace:GetAttribute("TotalAvatares"))
	if not v then
		return Config.MAX_AVATARES
	end
	return math.clamp(math.floor(v), 4, 400)
end

--[[ Quantos slots um avatar dessa escala precisa.

	Sem isto um boneco de escala 4 nasceria em cima dos vizinhos: ele ocuparia
	um slot de largura normal e o corpo invadiria os dois lados. ]]
function Formacao.slotsPara(escala: number, porFila: number?): number
	local largura = Config.LARGURA_POR_ESCALA * math.max(escala, 0.1)
	local n = math.ceil(largura / Config.ESPACO_X)
	-- Nunca mais que uma fileira inteira, senao nada caberia nunca.
	return math.clamp(n, 1, porFila or Config.POR_FILA)
end

--[[ A coluna de um slot, ja' com a serpentina aplicada.

	As fileiras impares sao invertidas de proposito. Numa disposicao normal, o
	ultimo slot de uma fileira e o primeiro da seguinte ficam em pontas opostas,
	e a camera atravessaria a formacao inteira toda vez que uma fileira enchesse
	-- um solavanco lateral a cada dez avatares. Com a serpentina, o fim de uma
	fileira encosta no comeco da outra e a camera so' anda um passo. ]]
local function colunaVisual(fileira: number, coluna: number, porFila: number): number
	if fileira % 2 == 1 then
		return porFila - 1 - coluna
	end
	return coluna
end

function Formacao.novo(): Formacao
	return setmetatable({
		ocupantes = {},
		porFila = porFilaDoPainel(),
		usados = 0,
		zDaFileira = {},
	}, Formacao)
end

--[[ Refaz TODAS as posicoes a partir da lista de ocupantes.

	Tres passadas, e a separacao entre elas nao e' estilo -- cada uma depende do
	resultado inteiro da anterior:

	  1. distribui em fileiras e colunas, e descobre o MAIOR de cada fileira;
	  2. com o maior de cada fileira em maos, calcula o Z de cada uma;
	  3. so' entao monta o CFrame de cada ocupante.

	A passada 2 nao pode acontecer junto da 1 pelo motivo classico da grade:
	o vao entre a fileira F e a F+1 depende do maior boneco da F, e o maior
	boneco da F so' e' conhecido quando a fileira F terminou de ser preenchida.
	Misturar as duas foi o que, na versao antiga, deixava um gigante que chegava
	por ultimo invadindo quem ja' estava plantado na frente dele. ]]
function Formacao.recalcular(self: Formacao)
	local porFila = self.porFila
	local fileira, coluna = 0, 0
	local maiorDaFileira: { [number]: number } = {}

	-- 1) fileira e coluna de cada um, na ordem de chegada.
	for _, oc in ipairs(self.ocupantes) do
		local slots = Formacao.slotsPara(oc.escala, porFila)
		-- Os slots precisam caber na MESMA fileira: um avatar nao pode ficar
		-- metade numa e metade na outra. Se nao couber no que resta desta, pula
		-- pro comeco da proxima -- deixando um buraco no fim, que e' o preco de
		-- manter o avatar inteiro.
		if coluna + slots > porFila then
			fileira += 1
			coluna = 0
		end
		oc.fileira = fileira
		oc.coluna = coluna
		oc.slots = slots
		coluna += slots

		local tamanho = math.max(oc.escala, 1)
		if tamanho > (maiorDaFileira[fileira] or 0) then
			maiorDaFileira[fileira] = tamanho
		end
	end

	--[[ 2) O Z de cada fileira.

		Cada fileira empurra a seguinte pelo tamanho do MAIOR boneco que ela
		tem. Fileira so' de gente normal fica a ESPACO_Z; uma fileira com um
		oculos de escala 4 abre bem mais, e ninguem se atravessa.

		A MEDIA e nao a escala crua: o vao entre duas fileiras precisa caber
		meio corpo de cada lado, entao ele acompanha a media dos dois tamanhos.
		Multiplicar direto (8 x 4 = 32 studs) daria o dobro do necessario, e a
		formacao ficaria com um vazio enorme atras de cada presente grande --
		espalhada demais pra caber no plano aberto, e sem a sensacao de plateia
		cheia que faz a live funcionar. ]]
	table.clear(self.zDaFileira)
	local z = 0
	self.zDaFileira[0] = 0
	for f = 1, fileira do
		local grande = math.max(maiorDaFileira[f - 1] or 1, 1)
		z += Config.ESPACO_Z * (grande + 1) / 2
		self.zDaFileira[f] = z
	end

	--[[ 3) O CFrame.

		Centraliza no CONJUNTO de slots: um avatar de 2 slots fica no meio dos
		dois, e nao encostado no primeiro.

		Girado 180 graus. No Roblox o "para frente" de um CFrame e' o -Z, entao
		um CFrame.new(pos) puro deixaria todo mundo olhando pra -Z -- e a camera
		fica do lado +Z, entao o close pegaria a nuca de cada um. ]]
	for _, oc in ipairs(self.ocupantes) do
		local primeira = colunaVisual(oc.fileira, oc.coluna, porFila)
		local ultima = colunaVisual(oc.fileira, oc.coluna + oc.slots - 1, porFila)
		local meio = (primeira + ultima) / 2
		-- Centraliza a fileira no eixo X: as colunas vao de -(N-1)/2 a
		-- +(N-1)/2 vezes o espacamento, e nao de 0 a N-1. Sem isso, a formacao
		-- inteira cresceria so' pra direita e sairia do quadro.
		local x = (meio - (porFila - 1) / 2) * Config.ESPACO_X
		oc.cframe = CFrame.new(Vector3.new(x, 0, self.zDaFileira[oc.fileira] or 0))
			* CFrame.Angles(0, math.pi, 0)
	end

	self.usados = fileira * porFila + coluna
end

--[[ Poe mais um na formacao. Devolve o INDICE dele, ou nil se a grade encheu.

	O nil e' o sinal de "ciclo completo", e e' ele que dispara o plano aberto e
	a limpeza la' no Principal.

	Desfaz a entrada quando nao cabe, em vez de deixar o ocupante na lista e
	devolver nil: um ocupante fantasma na lista faria a proxima chamada do
	`recalcular` contar espaco pra um boneco que nao existe, e a formacao
	ficaria com um buraco permanente que so' sumiria no fim do ciclo. ]]
function Formacao.entrar(self: Formacao, escala: number): number?
	local oc: Ocupante = {
		escala = math.max(escala or 1, 0.1),
		vivo = true,
		fileira = 0,
		coluna = 0,
		slots = 1,
		cframe = CFrame.identity,
	}
	table.insert(self.ocupantes, oc)
	self:recalcular()

	if self.usados > totalDoPainel() then
		table.remove(self.ocupantes)
		self:recalcular()
		return nil
	end
	return #self.ocupantes
end

--[[ Este avatar cresceu: reacomoda a formacao em volta dele.

	Devolve `false` quando o tamanho novo nao cabe na grade -- e ai' o tamanho
	antigo e' restaurado, em vez de ficar um estado meio aplicado. Quem chama
	decide o que fazer (hoje: aplica o crescimento assim mesmo, e deixa o ciclo
	fechar; ver `Principal.crescer`). ]]
function Formacao.mudarEscala(self: Formacao, indice: number, escala: number): boolean
	local oc = self.ocupantes[indice]
	if not oc then
		return false
	end
	local antes = oc.escala
	oc.escala = math.max(escala or 1, 0.1)
	self:recalcular()

	if self.usados > totalDoPainel() then
		oc.escala = antes
		self:recalcular()
		return false
	end
	return true
end

function Formacao.posicaoDe(self: Formacao, indice: number): CFrame?
	local oc = self.ocupantes[indice]
	return if oc then oc.cframe else nil
end

function Formacao.escalaDe(self: Formacao, indice: number): number
	local oc = self.ocupantes[indice]
	return if oc then oc.escala else 1
end

--[[ Em que fileira este ocupante caiu no ultimo `recalcular`.

	O cliente usa isto pra achar a FILEIRA DA FRENTE (a ultima, entao
	contagem - 1), que e' a unica que aparece nomeada. Vem do
	estado derivado de proposito: ninguem guarda "a fileira" em lugar nenhum,
	ela e' recalculada junto com as posicoes -- e assim nao ha' como ela ficar
	dessincronizada de onde o boneco esta' de fato. ]]
function Formacao.fileiraDe(self: Formacao, indice: number): number
	local oc = self.ocupantes[indice]
	return if oc then oc.fileira else 0
end

--[[ Quantas fileiras a formacao tem agora (0 quando esta' vazia). ]]
function Formacao.fileiras(self: Formacao): number
	if #self.ocupantes == 0 then
		return 0
	end
	return self.ocupantes[#self.ocupantes].fileira + 1
end

--[[ Onde o COLOSSO fica: ATRAS da ultima fileira possivel.

	A grade cresce em +Z (fileira nova = mais perto da camera), entao "atras de
	todo mundo" e' o Z mais NEGATIVO -- antes ate' da primeira fileira. Fica um
	pouco alem pra ele nao encostar em quem esta' no fundo, mesmo sendo enorme.

	`quantos` e' quantos colossos JA' nasceram neste ciclo, e ele existe porque
	o colosso nao entra na grade (de proposito -- um gigante consumindo meia
	fileira fecharia o ciclo cedo demais). Sem esse numero, dois colossos
	seguidos nasciam exatamente no mesmo ponto e viravam um borrao de bracos e
	pernas atravessados. Aqui o primeiro fica no meio, e os seguintes se
	revezam nos lados.

	O ciclo de TRES nao e' arbitrario: acima de tres gigantes na mesma tela, os
	das pontas ja' saem do quadro da camera aberta, entao o quarto volta pro
	meio -- onde pelo menos aparece. ]]
function Formacao.posicaoColosso(quantos: number?): CFrame
	local vez = math.floor(quantos or 0) % 3
	local lado = if vez == 1 then -1 elseif vez == 2 then 1 else 0
	return CFrame.new(Vector3.new(lado * Config.ESPACO_X * 6, 0, -Config.ESPACO_Z * 3.5))
		* CFrame.Angles(0, math.pi, 0)
end

--[[ Do fundo ate' a ultima fileira, em studs.

	A camera do plano aberto PRECISA deste numero. Antes ela recuava um valor
	fixo a partir do centro, e isso ja' era apertado com a grade uniforme: com
	dez fileiras a 8 studs, a fileira da frente ficava praticamente em cima da
	lente. Como uma fileira com gigante abre mais espaco que uma normal, a
	profundidade varia de uma live pra outra -- de 72 studs numa live so' de
	comentarios a 180 numa cheia de presente grande -- e um recuo fixo deixaria
	metade da formacao ATRAS da camera no fim do ciclo, que e' justamente o
	momento de mostrar que a live esta' cheia. ]]
function Formacao.profundidade(self: Formacao): number
	local ultima = 0
	for _, oc in ipairs(self.ocupantes) do
		if oc.fileira > ultima then
			ultima = oc.fileira
		end
	end
	return self.zDaFileira[ultima] or 0
end

--[[ O centro da formacao no chao, pro plano aberto do fim do ciclo.

	Meio caminho ate' a ultima fileira, medido pelo Z de verdade dela -- e nao
	por `fileiras * ESPACO_Z`. Com um gigante no meio, as fileiras nao estao
	mais igualmente espacadas, e a conta antiga apontaria o plano aberto pra um
	ponto onde nao tem ninguem. ]]
function Formacao.centro(self: Formacao): Vector3
	return Vector3.new(0, 0, self:profundidade() / 2)
end

function Formacao.quantos(self: Formacao): number
	return #self.ocupantes
end

function Formacao.slotsUsados(self: Formacao): number
	return self.usados
end

function Formacao.cheia(self: Formacao): boolean
	return self.usados >= totalDoPainel()
end

--[[ Recomeca o ciclo.

	E' AQUI que uma mudanca de "por fileira" feita no painel entra em vigor: com
	a grade vazia, ninguem foi plantado pela regua antiga. ]]
function Formacao.limpar(self: Formacao)
	table.clear(self.ocupantes)
	table.clear(self.zDaFileira)
	self.usados = 0
	self.porFila = porFilaDoPainel()
end

return Formacao
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Principal</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
	O maestro: puxa do servidor, decide quem entra, spawna e limpa no tempo.

	DOIS LACOS INDEPENDENTES, e isso e' de proposito:

	  lacoServidor   so' fala HTTP e enfileira. Nunca spawna.
	  lacoSpawn      so' spawna, um de cada vez, do mais prioritario pro menos.

	Separados porque cada um tem um ritmo proprio e um deles e' LENTO: montar um
	avatar leva centenas de milissegundos e faz HTTP por baixo. Se o spawn
	morasse dentro do laco do servidor, um combo de 50 presentes travaria a
	consulta, e a live acumularia atraso ate' nunca mais alcancar o chat.

	O TEMPO DE TELA (`vida`) FUNCIONA, E O SLOT NUNCA VOLTA

	Quando a vida de um avatar acaba, ele some -- mas o SLOT dele continua
	gasto pra sempre. Essa e' a diferenca que faz a coisa toda funcionar.

	A versao obvia devolveria o slot pra fila. So' que o buraco pode estar numa
	fileira DE TRAS: o proximo a chegar nasceria atras de fileiras ja' formadas
	e ficaria tapado por elas, justamente enquanto a camera tenta mostra-lo.

	Mantendo o slot gasto, o `vida` entrega exatamente o que o painel promete --
	quem pagou fica na tela os 300 segundos que comprou, quem so' comentou sai
	em 45 -- e quem chega esta' SEMPRE na frente de todo mundo.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
local Avatares = require(script.Parent:WaitForChild("Avatares"))
local Formacao = require(script.Parent:WaitForChild("Formacao"))
local Segredos = require(script.Parent:WaitForChild("Segredos"))
local Servidor = require(script.Parent:WaitForChild("Servidor"))

--[[ Voce so' assiste; ninguem precisa de um boneco proprio andando no meio da
	formacao.

	ATENCAO -- isto tem um efeito colateral que custa horas pra descobrir: sem
	personagem, o Roblox nao tem referencia de onde o jogador "esta'". Com
	Workspace.StreamingEnabled LIGADO (o padrao de todo lugar novo), o servidor
	entao nao envia peca NENHUMA pro cliente -- nem o chao, nem o corpo dos
	avatares. Os modelos chegam, mas so' com Humanoid e roupa, e a tela fica num
	limbo cinza que nao parece ter nada a ver com a causa.

	Por isso o default.project.json forca StreamingEnabled = false. O palco e'
	minusculo e streaming nao traria beneficio nenhum aqui. ]]
Players.CharacterAutoLoads = false

-- ─────────────────────────── Estado ───────────────────────────

local formacao = Formacao.novo()

local pasta = Instance.new("Folder")
pasta.Name = "Avatares"
pasta.Parent = workspace

-- O canal server -> client da camera. Criado aqui, em tempo de execucao, pra
-- Rojo nao precisar declarar nada: um arquivo a menos pra dar errado na
-- instalacao de quem comprou.
local canalCamera = Instance.new("RemoteEvent")
canalCamera.Name = "CameraLive"
canalCamera.Parent = ReplicatedStorage

--[[ O canal do AVISO NA TELA.

	Existe por causa do relato mais comum de quem comprou o kit: "apertei Play e
	nao acontece nada". Nao acontecer nada tem tres causas possiveis (servidor
	fechado, HttpService desligado, ninguem comentou nick) e ate' agora as tres
	se pareciam exatamente com a mesma coisa: um palco vazio.

	O aviso so' aparece quando o jogo esta' MUDO ha' varias tentativas seguidas
	-- ou seja, quando a live ja' esta' quebrada de qualquer jeito -- e some
	sozinho no instante em que o servidor responde. Ele nunca entra em cima de
	uma live que esta' funcionando. ]]
local canalAviso = Instance.new("RemoteEvent")
canalAviso.Name = "AvisoLive"
canalAviso.Parent = ReplicatedStorage

-- O ultimo aviso mostrado, pra nao reenviar a mesma frase 60 vezes por minuto.
local avisoNaTela = ""

local function avisar(titulo: string?, texto: string?)
	local marca = tostring(titulo) .. "|" .. tostring(texto)
	if avisoNaTela == marca then
		return
	end
	avisoNaTela = marca
	canalAviso:FireAllClients(titulo, texto)
end

-- LISTA, e nao mapa por tiktok_id: a MESMA pessoa pode ter varios avatares na
-- tela ao mesmo tempo, porque cada comentario spawna o seu.
local naTela: { Avatares.Avatar } = {}

--[[ tiktok_id -> o avatar MAIS RECENTE daquela pessoa.

	E' por ele que o presente sabe QUEM fazer crescer. "Mais recente" e nao "o
	primeiro" de proposito: se a pessoa comentou de novo depois de mandar
	presente, o boneco que a camera acabou de mostrar e' o novo -- e crescer o
	antigo, la' na terceira fileira, seria um presente pago acontecendo fora do
	quadro.

	Zerado junto com a formacao a cada ciclo. Sem isso ele acumularia
	referencias pra modelos destruidos e o presente da pessoa tentaria crescer
	um boneco que ja' nao existe. ]]
local porPessoa: { [string]: Avatares.Avatar } = {}

local fila: { Servidor.Spawn } = {}

local cursor = 0
-- Ate' quando nenhum avatar novo pode nascer (o `segura` de quem chegou por
-- ultimo). E' isto que da' tempo de tela pra cada um.
local seguraAte = 0
-- Ate' quando a formacao fica na danca especial. 0 = danca normal.
local especialAte = 0
--[[ Quantos COLOSSOS ja' nasceram neste ciclo.

	O colosso nao reserva slot na grade (de proposito), entao nada impedia dois
	deles de nascerem exatamente no mesmo ponto -- e dois gigantes ocupando o
	mesmo lugar viram um borrao de pernas e bracos atravessados. O numero decide
	pra que lado o proximo vai. ]]
local colossosNoCiclo = 0

--[[ O painel mudou "por fileira"? Entao a formacao precisa RECOMECAR pra regua
	nova valer.

	Sem isto a mudanca so' entraria em vigor no fim do ciclo natural -- que so'
	acontece quando a grade enche. Numa live normal isso demora tanto que, na
	pratica, mexer no painel nao fazia nada: era exatamente o sintoma de "botei 5
	e continua 10". ]]
local pedirFormacaoNova = false

-- tiktok_id -> {nick, id, moedas, curtidas, presenca}
local placar: { [string]: any } = {}

local function agora(): number
	--[[ GetServerTimeNow, e nao os.clock: em Luau o os.clock devolve tempo de
		CPU, e nao tempo de parede. Num servidor ocioso ele anda mais devagar que
		o relogio, e os avatares ficariam na tela muito alem dos segundos
		contratados -- logo os de quem pagou, que sao os que mais duram. ]]
	return workspace:GetServerTimeNow()
end

-- ─────────────────────────── O palco ───────────────────────────

--[[ O MAPA vem pronto dentro do arquivo do jogo.

	Ele mora em roblox/src/Workspace/Cenario.model.json e o Rojo o monta junto
	com o codigo: palco, parede de LED, treliças, refletores, arquibancada e
	horizonte. Por isso ele aparece no Studio ANTES de voce apertar Play -- um
	lugar que abre vazio parece um kit quebrado, e era exatamente o que
	acontecia quando o cenario nascia so' em tempo de execucao.

	O piso do palco tem o TOPO em y=0, que e' onde a formacao planta os pes
	(ver Formacao.posicao). Se voce for mexer no mapa, essa e' a unica medida
	que nao pode mudar: subir o palco 1 stud deixa cem bonecos flutuando.

	Esta funcao nao CONSTROI o mapa -- ela so' confere se ele chegou, e monta um
	chao de emergencia se nao chegou (lugar novo em branco, ou cenario apagado
	sem querer). Sem isso, os avatares dançariam no vazio. ]]
local function montarPalco()
	-- O SpawnLocation vem junto com o Baseplate de um lugar novo e nao serve
	-- pra nada aqui (ninguem tem personagem). Ficaria um podio solto no meio
	-- da grade.
	local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
	if spawn then
		spawn:Destroy()
	end

	if workspace:FindFirstChild("Cenario") then
		return -- o mapa do kit chegou inteiro
	end

	--[[ O Baseplate cinza de um lugar novo: serve de chao, mas fica ABAIXO do
		mapa do kit. Se ele estiver aqui sozinho, deixa como esta' -- e' chao
		suficiente pra live nao rodar no vazio. ]]
	if workspace:FindFirstChild("Baseplate") then
		warn("[live] o mapa (Cenario) nao esta' neste lugar -- rodando so' com o "
			.. "chao padrao. Abra o jogo pelo ABRIR-JOGO.bat pra ele ser "
			.. "remontado com o mapa inteiro.")
		return
	end

	warn("[live] lugar sem chao nenhum -- montando um de emergencia. O mapa do "
		.. "kit vem do arquivo JOGO-DA-LIVE.rbxlx; rode o ABRIR-JOGO.bat.")

	--[[ Chao de emergencia, com o TOPO em y=0 exatamente como o Baseplate
		original: dois chaos empilhados no mesmo y fazem a placa de video
		alternar entre eles a cada quadro, e o chao PISCA preto sempre que a
		camera se move. ]]
	local chao = Instance.new("Part")
	chao.Name = "Baseplate"
	chao.Size = Vector3.new(512, 16, 512)
	chao.Position = Vector3.new(0, -8, 0)
	chao.Anchored = true
	chao.Locked = true
	chao.Color = Color3.fromRGB(163, 162, 165)
	chao.Material = Enum.Material.Plastic
	chao.TopSurface = Enum.SurfaceType.Smooth
	chao.Parent = workspace
end

-- ─────────────────────────── O placar ───────────────────────────

--[[ Soma por PESSOA, e nao por avatar: quem mandou 100 rosas aparece UMA vez
	com o total, e nao cem vezes ocupando o top 10 inteiro.

	Tres placares separados porque eles medem coisas diferentes e premiar tudo
	junto apaga os dois menores: as moedas do presente valem direto, a curtida
	tem o placar dela, e a presenca (comentar, seguir, compartilhar) rende 1
	ponto -- assim quem nunca gastou nada tambem aparece em algum lugar. ]]
local function contarNoPlacar(spawn: Servidor.Spawn)
	local chave = spawn.tiktok_id
	if chave == "" then
		return
	end
	local linha = placar[chave]
	if not linha then
		linha = { nick = spawn.nickname, id = spawn.roblox_id,
			moedas = 0, curtidas = 0, presenca = 0 }
		placar[chave] = linha
	end
	linha.nick = spawn.nickname
	linha.moedas += math.max(0, spawn.moedas)
	linha.curtidas += math.max(0, spawn.curtidas)
	if spawn.tipo ~= "curtida" then
		linha.presenca += 1
	end
end

local function topo(campo: string): { Servidor.LinhaDePlacar }
	local lista = {}
	for _, linha in pairs(placar) do
		if linha[campo] > 0 then
			table.insert(lista, { nick = linha.nick, id = linha.id, pontos = linha[campo] })
		end
	end
	table.sort(lista, function(a, b)
		return a.pontos > b.pontos
	end)
	while #lista > 10 do
		table.remove(lista)
	end
	return lista
end

-- ───────────────────── Limpeza e fim de ciclo ─────────────────────

local function limparFormacao()
	for _, avatar in ipairs(naTela) do
		if avatar.modelo and avatar.modelo.Parent then
			avatar.modelo:Destroy()
		end
	end
	table.clear(naTela)
	table.clear(porPessoa)
	formacao:limpar()
	colossosNoCiclo = 0
	-- O painel precisa saber que ninguem tem avatar agora, senao a coluna
	-- "tamanho" continua mostrando os numeros do ciclo passado pra sempre.
	task.spawn(Servidor.limparTamanhos)
end

--[[ Reacomoda TODO MUNDO nas posicoes que a formacao calculou agora.

	Chamado depois de qualquer coisa que mude a geometria da grade: um avatar
	que nasce, um que cresce. A formacao ja' recalculou os CFrames; aqui a
	gente so' move os bonecos pra onde eles passaram a pertencer.

	Planta pelo `escalaVisual` e nao pelo `escala`: durante a animacao de
	crescimento os dois sao diferentes, e usar o tamanho de destino levantaria
	o boneco do chao ate' o corpo alcancar -- ele cresceria flutuando. ]]
local function reacomodar()
	for _, avatar in ipairs(naTela) do
		if avatar.indice > 0 and avatar.modelo.Parent then
			local posicao = formacao:posicaoDe(avatar.indice)
			if posicao then
				Avatares.plantar(avatar.modelo, posicao, avatar.escalaVisual)
			end
			--[[ A fileira vai junto, e nao so' na hora de nascer: quando
				alguem cresce, quem vinha depois pode mudar de fileira. Um
				rotulo com a fileira antiga ficaria aceso (ou apagado) na
				fileira errada
				de nomes -- um nome solto no meio de uma fileira sem nomes. ]]
			Avatares.marcarFileira(avatar.modelo, formacao:fileiraDe(avatar.indice))
		end
	end
	-- O cliente precisa saber quantas fileiras existem pra fechar a volta do
	-- qual e' a da frente. Atributo, e nao RemoteEvent: replica sozinho.
	workspace:SetAttribute("FileirasNaTela", formacao:fileiras())
end

--[[ O fim do ciclo: a camera abre, mostra a formacao inteira, e so' entao a
	grade e' apagada.

	O plano aberto nao e' enfeite -- e' o unico momento em que quem assiste ve'
	QUANTA gente entrou. Cortar direto pro palco vazio jogaria fora a prova de
	que a live esta' cheia, que e' o argumento que faz a proxima pessoa comentar. ]]
local function fecharCiclo()
	canalCamera:FireAllClients({
		modo = "aberta",
		centro = formacao:centro(),
		-- A camera recua a partir da FRENTE da formacao, e pra isso ela precisa
		-- saber o tamanho dela: uma live cheia de presente grande e' duas vezes
		-- mais funda que uma so' de comentarios.
		profundidade = formacao:profundidade(),
		duracao = Config.CAMERA.ABERTA_S,
	})
	task.wait(Config.CAMERA.ABERTA_S)
	limparFormacao()
	canalCamera:FireAllClients({ modo = "seguir" })
end

--[[ O FURACAO: o avatar sai varrendo a formacao e derrubando todo mundo, e no
	fim a grade recomeca.

	Feito com a fisica de verdade (desancorando as pecas) e nao com animacao: um
	tombo calculado sai sempre igual, e depois da terceira vez o publico ja'
	decorou. Com fisica, cada varrida cai diferente. ]]
local function furacao(avatar: Avatares.Avatar, segundos: number)
	local raiz = avatar.modelo:FindFirstChild("HumanoidRootPart")
	if not raiz or not raiz:IsA("BasePart") then
		return
	end

	task.spawn(function()
		local fim = agora() + segundos
		while agora() < fim and avatar.modelo.Parent do
			for _, outro in ipairs(naTela) do
				if outro ~= avatar and outro.modelo.Parent then
					local alvo = outro.modelo:FindFirstChild("HumanoidRootPart")
					if alvo and alvo:IsA("BasePart") then
						local distancia = (alvo.Position - raiz.Position).Magnitude
						if distancia < 12 then
							for _, peca in ipairs(outro.modelo:GetDescendants()) do
								if peca:IsA("BasePart") then
									--[[ A COLISAO VOLTA AQUI -- sem isto o efeito
										mais caro da live vira um defeito.

										Todo avatar nasce com CanCollide = false
										(cem bonecos colidindo se empurram e a
										formacao desmancha sozinha). So' que um
										boneco desancorado SEM colisao nao tomba:
										ele atravessa o piso do palco e cai pra
										sempre, ate' o Roblox apagar o modelo la'
										embaixo. A varrida do oculos entao nao
										derrubava a formacao -- fazia ela SUMIR
										pelo chao, e o presente de 199 moedas
										parecia um bug. ]]
									peca.CanCollide = true
									peca.Massless = false
									peca.Anchored = false
								end
							end
							local empurrao = (alvo.Position - raiz.Position).Unit
							alvo.AssemblyLinearVelocity =
								(empurrao + Vector3.new(0, 1, 0)) * 45
						end
					end
				end
			end
			task.wait(0.25)
		end
		-- A grade ficou uma bagunca de bonecos caidos: recomecar e' a unica
		-- saida honesta, e e' tambem o momento mais bonito da varrida.
		pedirFormacaoNova = true
	end)
end

-- ─────────────────────────── O spawn ───────────────────────────

--[[ Os limites do crescimento, vindos do painel.

	Lidos a cada uso, e nao guardados: e' o que faz mexer no painel valer na
	hora, sem esperar o ciclo virar. ]]
local function tamanhoMaximo(): number
	local v = tonumber(workspace:GetAttribute("TamanhoMax"))
	return math.clamp(v or Config.CRESCIMENTO.TAMANHO_MAX, 1, 12)
end

local function suavidadeDoCrescimento(): number
	local v = tonumber(workspace:GetAttribute("CrescimentoSuave"))
	return math.clamp(v or Config.CRESCIMENTO.SUAVE_S, 0, 5)
end

--[[ O que um presente faz na tela: "novo", "crescer" ou "ambos".

	Vem do painel. Qualquer valor desconhecido cai em "ambos" -- e nao num
	erro: um ajuste torto nao pode fazer os presentes pararem de funcionar no
	meio da live. ]]
local function modoDoPresente(): string
	local v = workspace:GetAttribute("PresenteFaz")
	if v == "novo" or v == "crescer" or v == "ambos" then
		return v
	end
	return Config.CRESCIMENTO.MODO
end

--[[ Depois de cada efeito, a camera olha pra ele e ninguem nasce por um tempo.

	Num lugar so' porque vale igual pro avatar que NASCE e pro que CRESCE: os
	dois sao "o momento daquela pessoa", e quem pagou pra ver o proprio boneco
	inflar merece o mesmo tempo de tela de quem pagou pra ver um nascer. Antes
	isto so' existia no caminho do nascimento, e o presente que fazia crescer
	passava despercebido -- a camera continuava em outro lugar. ]]
local function darOMomento(spawn: Servidor.Spawn, modelo: Model)
	canalCamera:FireAllClients({
		modo = if spawn.cena > 0 then "cena" else "seguir",
		alvo = modelo,
		duracao = spawn.cena,
	})

	-- Avisa a voz. Dentro de task.spawn porque isto faz HTTP: uma fala perdida
	-- nao vale segurar o laco de spawn.
	task.spawn(function()
		Servidor.avisarCamera(spawn.tipo, spawn.nickname, spawn.presente)
	end)

	if spawn.danca_geral > 0 then
		especialAte = agora() + spawn.danca_geral
		Avatares.trocarDancaDeTodos(pasta, true)
	end

	seguraAte = agora() + math.max(spawn.segura, spawn.cena)
end

--[[ O presente fez o avatar desta pessoa CRESCER. Devolve false se nao deu.

	"Nao deu" e' rotina e nao erro: a pessoa pode nao ter boneco na tela (nunca
	comentou, ou o ciclo limpou a formacao), o presente pode nao ter
	crescimento configurado, ou o avatar dela ja' pode estar no teto. Em todos
	esses casos quem chama cai no caminho do nascimento, e a pessoa ganha um
	boneco novo em vez de nada. ]]
local function crescer(spawn: Servidor.Spawn, comMomento: boolean): boolean
	if spawn.crescimento <= 0 then
		return false
	end

	local avatar = porPessoa[spawn.tiktok_id]
	if not avatar or not avatar.modelo.Parent or avatar.indice <= 0 then
		return false
	end

	local teto = tamanhoMaximo()
	--[[ NO TETO, O PRESENTE NAO E' IGNORADO -- ELE VIRA UM BONECO NOVO.

		Este `return false` e' o que impede o pior caso do produto: a pessoa que
		mais gastou na live e' justamente a que chega ao teto primeiro, e a
		partir dali cada presente novo dela nao faria absolutamente nada na
		tela. Devolvendo false, quem chama spawna outro avatar pra ela -- entao
		continuar mandando presente continua tendo efeito visivel, so' que
		agora em quantidade em vez de tamanho. ]]
	if avatar.escala >= teto - 0.01 then
		return false
	end

	local destino = math.min(avatar.escala + spawn.crescimento, teto)
	--[[ A formacao abre espaco ANTES de o corpo crescer.

		Se ela recusar (o tamanho novo nao cabe na grade), o crescimento nao
		acontece e o presente vira um boneco novo. Crescer assim mesmo poria o
		gigante por cima dos vizinhos ate' o fim do ciclo. ]]
	if not formacao:mudarEscala(avatar.indice, destino) then
		return false
	end

	Avatares.crescer(avatar, destino, suavidadeDoCrescimento(), function(atual)
		avatar.escalaVisual = atual
		local posicao = formacao:posicaoDe(avatar.indice)
		if posicao then
			Avatares.plantar(avatar.modelo, posicao, atual)
		end
		Avatares.ajustarRotulo(avatar.modelo, atual)
	end)

	-- Todo mundo se afasta pra dar lugar ao que cresceu.
	reacomodar()

	--[[ No modo "ambos" quem da' o momento e' o boneco NOVO, que nasce logo
		em seguida. Sem esta guarda, a camera olharia pro que cresceu e no
		instante seguinte pularia pro que nasceu, e o `segura` seria contado
		duas vezes pro mesmo presente -- o dobro de pausa que o painel diz. ]]
	if comMomento then
		darOMomento(spawn, avatar.modelo)
		if spawn.furacao > 0 then
			furacao(avatar, spawn.furacao)
		end
	end
	return true
end

--[[ Nasce um avatar. Devolve false quando a grade encheu (fim do ciclo). ]]
local function spawnar(spawn: Servidor.Spawn): boolean
	local ehColosso = spawn.colosso > 0
	-- A MESMA conta que o Avatares usa pra chamar o ScaleTo. Ver
	-- `Avatares.escalaDe`: os dois lados discordarem ja' custou o colosso
	-- inteiro, que nascia do tamanho de gente normal.
	local escala = Avatares.escalaDe(spawn)

	local posicao, indice
	if ehColosso then
		-- O colosso vive FORA da grade, atras de todo mundo. Nao entra na
		-- formacao: entrar faria um gigante consumir meia fileira e o ciclo
		-- fecharia cedo demais toda vez que alguem mandasse o presente caro.
		posicao = Formacao.posicaoColosso(colossosNoCiclo)
		colossosNoCiclo += 1
		indice = -1
	else
		local entrou = formacao:entrar(escala)
		if not entrou then
			return false -- a grade encheu: fim do ciclo
		end
		indice = entrou
		posicao = formacao:posicaoDe(indice) or CFrame.identity
	end

	local modelo = Avatares.criar(spawn, posicao, pasta)
	if not modelo then
		-- Nao carregou (limite da Roblox, conta apagada, rede). O lugar na
		-- grade ja' foi gasto de proposito: devolve-lo faria o proximo avatar
		-- nascer no buraco, ATRAS de quem ja' esta' na frente -- o problema que
		-- a grade so'-pra-frente existe pra evitar.
		return true
	end

	local avatar: Avatares.Avatar = {
		modelo = modelo,
		indice = indice,
		tiktok_id = spawn.tiktok_id,
		nascido = agora(),
		vida = spawn.vida,
		prio = spawn.prio,
		escala = escala,
		escalaVisual = escala,
		geracao = 0,
	}
	table.insert(naTela, avatar)
	if spawn.tiktok_id ~= "" then
		porPessoa[spawn.tiktok_id] = avatar
	end

	-- Quem entrou empurrou a grade: os que ja' estavam podem ter mudado de
	-- lugar (uma fileira nova comecou, ou este e' grande e abriu espaco).
	reacomodar()
	darOMomento(spawn, modelo)

	if spawn.furacao > 0 then
		furacao(avatar, spawn.furacao)
	end
	return true
end

--[[ O QUE FAZER COM UM EVENTO: crescer o boneco que existe, criar um, ou os dois.

	Esta e' a decisao central do produto, e ela mora aqui -- e nao na ponte --
	porque so' o jogo sabe quem esta' na tela NESTE instante. A formacao e'
	apagada a cada ciclo, entao "esta pessoa ja' tem avatar" e' uma verdade que
	muda a cada poucos minutos.

	  novo      cada presente poe um boneco NOVO na tela.
	  crescer   o presente engorda o boneco que a pessoa ja' tem. So' cria um
	            novo quando ela ainda nao esta' na tela.
	  ambos     as duas coisas (padrao).

	O PLACAR E' CONTADO UMA VEZ SO', AQUI.

	Antes ele era contado dentro do `crescer` E dentro do `spawnar`. Enquanto
	os dois eram exclusivos isso funcionava; no modo "ambos" o mesmo presente
	passaria pelos dois caminhos e as moedas entrariam em DOBRO no top 10 --
	um erro que ninguem nota olhando a tela, e que premia a pessoa errada.

	E vem ANTES de criar o avatar, de proposito: o avatar e' o que a Roblox
	pode negar (limite de requisicao, conta apagada); a participacao, nao. Quem
	pagou nao pode sumir do placar porque a API engasgou.

	Devolve false so' no caso que interessa a quem chama: a grade encheu e o
	ciclo precisa fechar. ]]
local function aplicar(spawn: Servidor.Spawn): boolean
	contarNoPlacar(spawn)

	if spawn.tipo ~= "presente" then
		return spawnar(spawn)
	end

	local modo = modoDoPresente()
	if modo == "novo" then
		return spawnar(spawn)
	end

	if modo == "crescer" then
		-- Cresceu? Acabou. Nao cresceu (a pessoa nao tem boneco, ou ja' esta'
		-- no teto)? Entao ela ganha um boneco novo, em vez de nada.
		return crescer(spawn, true) or spawnar(spawn)
	end

	-- "ambos": o que ela ja' tinha cresce, e um novo aparece. Quem da' o
	-- momento da camera e' o novo -- ele e' o que acabou de entrar em cena.
	crescer(spawn, false)
	return spawnar(spawn)
end

-- ─────────────────────────── Os lacos ───────────────────────────

--[[ Traduz o erro cru da Roblox na frase que resolve o problema.

	Sao dois casos, e a solucao de um nao serve pro outro -- por isso eles nao
	podem virar um aviso generico. O texto e' curto de proposito: ele aparece
	POR CIMA da live, e uma parede de texto no meio da transmissao e' pior que o
	problema que ela explica. ]]
local function explicar(motivo: string): (string, string)
	if string.find(motivo, "Http requests are not enabled", 1, true)
		or string.find(motivo, "HttpService", 1, true) then
		return "LIGUE AS REQUISICOES HTTP",
			"No Studio: aba HOME > Game Settings > Security > "
				.. "Allow HTTP Requests. Depois aperte Play de novo."
	end
	return "O SERVIDOR DA LIVE NAO RESPONDE",
		"A janela preta \"1 - SERVIDOR DA LIVE\" precisa estar aberta. "
			.. "Feche tudo e rode o INICIAR-LIVE.bat (ou o TESTAR.bat) de novo."
end

-- Quantas voltas mudas antes de por o aviso na tela. 5 voltas = ~5 segundos:
-- tempo de sobra pro servidor terminar de subir, e pouco o bastante pra quem
-- esta' olhando a tela receber a resposta antes de desistir.
local MUDO_ATE_AVISAR = 5

--[[ Ja' sabemos ONDE a fila esta'? Ver `ancorar` logo abaixo.

	Comeca FALSO, e nada e' puxado antes de virar verdadeiro. Isso e' a correcao
	de um defeito que so' aparecia quando alguma outra coisa dava errado -- o
	pior tipo. ]]
local ancorado = false

--[[ Pergunta ao servidor em que ponto da fila ele esta', e pula pra la'.

	POR QUE ISTO NAO PODE FALHAR EM SILENCIO

	O `cursor` comeca em 0, e 0 quer dizer "me manda desde o comeco". Numa fila
	que guarda ate' 2000 eventos, isso e' uma multidao inteira de gente que
	comentou ha' dez minutos e ja' foi embora nascendo de uma vez no primeiro
	segundo do Play.

	Antes, quando a ancoragem falhava -- o servidor demorando meio segundo a mais
	pra subir e' o bastante -- o codigo apenas AVISAVA e seguia em frente com o
	cursor em 0. O aviso ia pro Output do Studio, que ninguem esta' olhando com a
	live no ar, e o que se via era exatamente o sintoma que este kit promete que
	nao acontece: bonecos aparecendo sozinhos, sem ninguem ter comentado nada.

	Agora a falha nao anda pra frente: enquanto nao ancorar, o jogo NAO puxa. Ele
	tenta de novo a cada volta do laco, e quando o servidor responde a live
	comeca do ponto certo -- do que esta' acontecendo agora, e nao do historico. ]]
local function ancorar(): boolean
	local ancora = Servidor.ancorar()
	if not ancora then
		return false
	end
	cursor = ancora
	ancorado = true
	return true
end

local function lacoServidor()
	local mudo = 0

	while true do
		--[[ Nada de puxar antes de saber onde a fila esta'. Um servidor que
			demorou a subir deixaria o cursor em 0, e o cursor em 0 spawna o
			historico inteiro. ]]
		local spawns: { Servidor.Spawn } = {}
		if ancorado or ancorar() then
			local novoCursor, novos = Servidor.puxar(cursor)
			cursor = novoCursor
			spawns = novos
		end

		--[[ O DIAGNOSTICO. Falar SEMPRE que falha afogaria o Output; falar
			nunca era o que produzia a tela vazia sem explicacao. Fala uma vez,
			quando o silencio vira problema, e desfaz sozinho quando volta. ]]
		local ok, motivo = Servidor.estado()
		if ok then
			if mudo >= MUDO_ATE_AVISAR then
				print("[live] o servidor voltou a responder.")
			end
			mudo = 0
			avisar(nil, nil)
		else
			mudo += 1
			if mudo == MUDO_ATE_AVISAR then
				local titulo, texto = explicar(motivo)
				warn("[live] " .. titulo .. " -- " .. texto)
				warn("[live] detalhe tecnico: " .. motivo)
				avisar(titulo, texto)
			end
		end

		for _, spawn in ipairs(spawns) do
			table.insert(fila, spawn)
		end

		--[[ Ordena por prioridade, mas ESTAVEL dentro da mesma prioridade.

			table.sort do Luau nao e' estavel, entao dois comentarios com prio 0
			poderiam trocar de lugar a cada ordenacao -- e quem comentou primeiro
			perderia a vez pra quem comentou depois, aleatoriamente. Comparar
			so' quando as prioridades DIFEREM preserva a ordem de chegada. ]]
		if #fila > 1 then
			local ordem: { [any]: number } = {}
			for i, item in ipairs(fila) do
				ordem[item] = i
			end
			table.sort(fila, function(a, b)
				if a.prio ~= b.prio then
					return a.prio > b.prio
				end
				return ordem[a] < ordem[b]
			end)
		end

		-- A fila nao pode crescer sem limite. Se ela passar disso, o que sobra
		-- e' gente que comentou ha' tanto tempo que ja' saiu da live -- mostrar
		-- essas pessoas e' pior que nao mostrar.
		while #fila > 300 do
			table.remove(fila)
		end

		task.wait(Segredos.INTERVALO)
	end
end

--[[ O TETO de bonecos que podem existir ao mesmo tempo. Vem do painel.

	Ao bater nele, a formacao INTEIRA e' apagada e o ciclo recomeca do zero. E'
	o que segura o custo da live: cada avatar e' um rig R15 completo, com roupa,
	acessorio e uma animacao tocando. Cem ja' pesam; quinhentos derrubam o
	servidor do Studio, e a live cai junto. ]]
local function tetoDeBonecos(): number
	local v = tonumber(workspace:GetAttribute("TotalAvatares"))
	return math.clamp(math.floor(v or Config.MAX_AVATARES), 4, 400)
end

local function lacoSpawn()
	while true do
		--[[ TETO RIGIDO, contando os bonecos DE VERDADE na pasta.

			A grade ja' fecha o ciclo sozinha quando os slots acabam, e na live
			normal e' ela que manda. Mas existe um caminho que ESCAPA dela: o
			COLOSSO nasce fora da grade e nao reserva slot nenhum (de proposito
			-- um gigante consumindo meia fileira fecharia o ciclo cedo demais).

			Sem esta contagem, uma sequencia de presentes de colosso empilharia
			gigantes sem nunca encher a grade, e o servidor iria afundando sem
			nada no codigo dizendo por que. Contar o que EXISTE, e nao o que foi
			reservado, fecha esse buraco. ]]
		if #pasta:GetChildren() >= tetoDeBonecos() then
			pedirFormacaoNova = true
		end

		if pedirFormacaoNova then
			pedirFormacaoNova = false
			fecharCiclo()
		end

		if especialAte > 0 and agora() >= especialAte then
			especialAte = 0
			Avatares.trocarDancaDeTodos(pasta, false)
		end

		if #fila > 0 and agora() >= seguraAte then
			local spawn = table.remove(fila, 1)
			if spawn and not aplicar(spawn) then
				-- A grade encheu. Devolve o spawn pro comeco da fila: ele nao
				-- pode ser perdido so' porque chegou no instante em que o ciclo
				-- virou -- ainda mais se for um presente pago.
				table.insert(fila, 1, spawn)
				fecharCiclo()
			end
		end

		-- 0.1s e nao 0: um laco apertado demais come CPU do mesmo processo que
		-- monta os avatares, e o spawn fica MAIS lento, nao mais rapido.
		task.wait(0.1)
	end
end

local function lacoPlacar()
	while true do
		task.wait(3)
		Servidor.publicarPlacar(topo("moedas"), topo("curtidas"), topo("presenca"))
	end
end

--[[ NAO EXISTE REMOCAO POR TEMPO, E ISSO E' DELIBERADO.

	A versao anterior tirava cada avatar quando a `vida` dele acabava. Parecia
	certo e ficava HORRIVEL: comentario vivia 45s e presente 300s, entao depois
	de um minuto a formacao virava um queijo suico -- buraco no meio da terceira
	fileira, dois no fim da primeira, um bloco vago no canto. A grade so' parece
	uma PLATEIA enquanto esta' cheia; furada, parece um bug.

	Agora ninguem sai sozinho. A formacao inteira vive ate' o ciclo fechar (a
	grade encher ou bater o teto de bonecos) e ai' e' apagada de uma vez, com a
	camera aberta mostrando ela cheia antes de recomecar.

	O custo continua limitado -- e' exatamente o que o teto faz. O que se perde
	e' o campo `vida` mandar em alguma coisa; por isso ele saiu do painel, em vez
	de continuar la' enganando quem mexe nele. ]]

--[[ Le' os ajustes do painel e espelha nos atributos do workspace.

	Atributo, e nao variavel: assim o Formacao e o cliente da camera leem o valor
	novo sozinhos, sem ninguem precisar avisa-los. E' o que faz o "salvei e ja'
	valeu" do painel ser verdade tambem aqui dentro. ]]
--[[ Os ajustes do painel que viram ATRIBUTO do workspace, um por linha.

	Atributo, e nao variavel, porque quem le' varios deles e' o CLIENTE (a
	camera) e o modulo da Formacao -- e atributo replica sozinho, sem RemoteEvent
	nenhum no meio. E' o que faz o "salvei e ja' valeu" ser verdade nos dois
	lados.

	A lista e' declarativa pra adicionar um ajuste ser UMA linha aqui. Com um
	`if` escrito na mao por campo, o padrao que se repetia era esquecer de
	espelhar o novo -- e o sintoma disso e' o pior do painel: o valor aparece
	salvo na tela e o jogo continua com o antigo, sem nada indicando por que. ]]
local ESPELHADOS: { { chave: string, atributo: string, reiniciaCiclo: boolean? } } = {
	{ chave = "por_fila", atributo = "PorFila", reiniciaCiclo = true },
	{ chave = "total_avatares", atributo = "TotalAvatares" },
	{ chave = "camera_recuo", atributo = "CameraRecuo" },
	{ chave = "tamanho_max", atributo = "TamanhoMax" },
	{ chave = "crescimento_suave", atributo = "CrescimentoSuave" },
	{ chave = "camera_fov", atributo = "CameraFov" },
	{ chave = "camera_distancia", atributo = "CameraDistancia" },
	{ chave = "camera_altura", atributo = "CameraAltura" },
}

-- Os de liga/desliga vao separados: `tonumber(false)` e' nil, entao eles
-- sumiriam calados do laco acima.
local ESPELHADOS_SIMNAO: { { chave: string, atributo: string } } = {
	{ chave = "vertical", atributo = "Vertical" },
}

-- E os de TEXTO, pelo mesmo motivo: `tonumber("novo")` tambem e' nil.
local ESPELHADOS_TEXTO: { { chave: string, atributo: string } } = {
	{ chave = "presente_faz", atributo = "PresenteFaz" },
}

--[[ ═══════════ O QUE O TELAO DIZ ═══════════

	O telao tem DOIS lugares onde presente aparece, e o jogo escreve nos dois:

	  a COLUNA CENTRAL, que gira entre o convite da live e um presente de cada
	  vez (ver `lacoTelao`). E' a unica parte que sobrevive ao corte do video em
	  pe', entao e' ela que carrega a mensagem.

	  a LISTA LATERAL, quatro slots fixos que so' aparecem no 16:9.

	POR QUE ISTO E' FEITO AQUI, E NAO GRAVADO NO MAPA

	O catalogo e' editavel: voce pode cadastrar um presente novo, mudar o preco
	de outro ou desligar um -- tudo ao vivo, pelo painel. Um telao com os nomes
	gravados no arquivo do mapa passaria a anunciar presentes que nao fazem mais
	nada, ou a esconder os que fazem. Um telao que mente sobre o que aceitar e'
	pior que um telao sem lista: o espectador manda o presente errado e nao
	acontece o que ele esperava.

	Vale pro PRECO e vale, agora, pro EFEITO: a frase "o que este presente faz"
	tambem sai do catalogo, derivada dos campos do proprio presente. ]]

--[[ O QUE ESTE PRESENTE FAZ, em uma linha curta.

	A pergunta que faz alguem mandar um presente nao e' quanto custa, e' o que
	acontece na tela. "Rosquinha · 30" e' uma tabela de precos de uma coisa que
	o espectador nao sabe o que e'; "VOCE ENTRA GIGANTE" e' o convite.

	A frase e' DERIVADA dos campos do proprio presente, e nao escrita na mao em
	lugar nenhum. E' a mesma regra que vale pra lista inteira: o catalogo e'
	editavel pelo painel, entao qualquer texto fixo vira mentira no dia em que
	voce desligar o furacao do oculos. Aqui, desligou o campo, a frase muda
	sozinha.

	UMA FRASE SO', e a ordem importa: um presente caro faz varias coisas ao
	mesmo tempo (o oculos cresce, brilha, dança diferente E derruba todo mundo),
	mas na altura que o telao tem cabe UMA linha. Ganha a mais espetacular --
	que e' tambem a que a pessoa quer ver de novo. ]]
local function frasePresente(efeito: any): string
	local function num(chave: string): number
		return tonumber(efeito[chave]) or 0
	end

	if num("colosso") > 0 then
		return "VOCÊ VIRA UM COLOSSO"
	end

	--[[ O TAMANHO VEM PRIMEIRO, e o numero e' o do proprio presente.

		A escadinha de tamanho e' o que a live vende, e ela so' funciona se o
		espectador CONSEGUIR COMPARAR: "2x maior" ao lado de "3x maior" ao lado
		de "4x maior" e' uma tabela de precos que se entende sem legenda. "VOCÊ
		ENTRA GIGANTE" nos tres -- que era o que estava escrito -- apagava
		justamente a diferenca pela qual a pessoa paga a mais.

		O teto vira "O MAIOR DE TODOS" em vez de "6x": quem chega no topo nao
		precisa de numero, precisa saber que nao da' pra ir mais alto. E se um
		dia o teto mudar no painel, a frase acompanha sozinha. ]]
	local escala = num("escala")
	-- O MESMO teto que o crescimento usa (painel > Config): duas fontes pra
	-- este numero e' o telao dizendo "o maior de todos" de um boneco que ainda
	-- pode crescer, ou o contrario.
	local teto = tamanhoMaximo()
	if escala >= teto then
		return "O MAIOR DE TODOS"
	elseif escala >= 2 then
		--[[ Sem casa decimal quando e' redondo: "2x MAIOR" se le' de relance,
			"2.0x MAIOR" faz o olho parar pra conferir se aquilo e' um numero
			ou um codigo. ]]
		local rotulo = if escala % 1 == 0
			then string.format("%d", escala)
			else string.format("%.1f", escala)
		return "VOCÊ FICA " .. rotulo .. "x MAIOR"
	elseif num("furacao") > 0 then
		return "DERRUBA TODO MUNDO"
	elseif num("chuva") > 0 then
		return "CHOVEM CÓPIAS SUAS"
	elseif tostring(efeito.danca or "") ~= "" then
		return "VOCÊ DANÇA DIFERENTE"
	elseif num("cena") > 0 then
		return "A CÂMERA SÓ PRA VOCÊ"
	elseif num("brilho") > 0 then
		return "SEU BONECO BRILHA"
	end
	return "VOCÊ ENTRA NA LIVE"
end

--[[ O SEGUNDO efeito -- o espetaculo, quando existe.

	Fica separado da frase do tamanho porque os dois cabem em lugares
	diferentes: o tamanho e' a linha grande do cartao, este aqui entra junto do
	preco, em letra menor. Um presente que so' aumenta devolve "" e a linha do
	preco fica limpa, em vez de inventar um efeito que ele nao tem. ]]
local function fraseExtra(efeito: any): string
	local function num(chave: string): number
		return tonumber(efeito[chave]) or 0
	end
	if num("furacao") > 0 then
		return "derruba todo mundo"
	elseif num("chuva") > 0 then
		return "chovem cópias suas"
	elseif num("cena") > 0 then
		return "a câmera para em você"
	elseif tostring(efeito.danca or "") ~= "" then
		return "dança só sua"
	elseif num("brilho") > 0 then
		return "seu boneco brilha"
	end
	return ""
end

--[[ A lista de presentes do catalogo, agrupada e em ordem de preco.

	AGRUPA PELOS APELIDOS. No catalogo, o mesmo presente aparece uma vez por
	apelido ("rose" e "rosa" sao a mesma rosa). Sem agrupar, o telao mostraria
	"Rosa, Rosa, Rosquinha, Rosquinha" e os quatro slots se esgotariam em dois
	presentes de verdade.

	ORDENA PELO PRECO, do mais barato pro mais caro: e' a ordem em que a pessoa
	decide o que mandar, e a que faz a escadinha de valor ficar obvia sem
	precisar explicar. ]]
local function listaDePresentes(ajustes: any)
	local vistos: { [string]: boolean } = {}
	local lista = {}
	for _, efeito in pairs((ajustes and ajustes.presentes) or {}) do
		if type(efeito) == "table" then
			local grupo = tostring(efeito.grupo or "")
			if grupo ~= "" and not vistos[grupo] then
				vistos[grupo] = true
				table.insert(lista, {
					rotulo = tostring(efeito.rotulo or grupo),
					emoji = tostring(efeito.emoji or ""),
					moedas = tonumber(efeito.moedas) or 0,
					frase = frasePresente(efeito),
					extra = fraseExtra(efeito),
				})
			end
		end
	end
	table.sort(lista, function(a, b)
		if a.moedas ~= b.moedas then
			return a.moedas < b.moedas
		end
		-- Desempate pelo nome pra a ordem NAO mudar a cada volta do laco: dois
		-- presentes do mesmo preco trocariam de lugar no telao a cada 5
		-- segundos, e uma lista que se mexe sozinha parece defeito.
		return a.rotulo < b.rotulo
	end)
	return lista
end

-- O que o rodizio da coluna central esta' mostrando. Guardado aqui porque os
-- dois lacos mexem nele: o dos ajustes reescreve a lista, o do rodizio vira a
-- pagina.
local telaoLista: { any } = {}
local telaoPagina = 0

local function fundoDoTelao(): Instance?
	local cenario = workspace:FindFirstChild("Cenario")
	local parede = cenario and cenario:FindFirstChild("ParedeDeLED")
	local peca = parede and parede:FindFirstChild("Telao")
	local tela = peca and peca:FindFirstChild("Tela")
	return tela and tela:FindFirstChild("Fundo")
end

--[[ Escreve as duas linhas de um slot da lista lateral.

	Os slots sao Frames com dois TextLabel dentro (Nome e Efeito) -- eram
	TextLabel unicos, e viraram dois quando o telao passou a dizer o que cada
	presente FAZ. O `if` em cada peca existe porque o mapa pode ser antigo: um
	Cenario gerado antes desta mudanca ainda tem os slots de uma linha so', e a
	live tem que continuar subindo. ]]
local function escreverSlot(slot: Instance?, item: any?)
	if not slot or not slot:IsA("GuiObject") then
		return
	end
	if not item then
		-- Menos de quatro presentes cadastrados: o slot some, em vez de ficar
		-- uma caixa vazia no meio do telao.
		slot.Visible = false
		return
	end
	local nome = slot:FindFirstChild("Nome")
	local efeito = slot:FindFirstChild("Efeito")
	if nome and nome:IsA("TextLabel") then
		nome.Text = string.format("%s %s · %d", item.emoji, item.rotulo, item.moedas)
		if efeito and efeito:IsA("TextLabel") then
			efeito.Text = item.frase
		end
	elseif slot:IsA("TextLabel") then
		--[[ MAPA ANTIGO: o slot ainda e' um TextLabel de uma linha so'. Escreve
			no formato velho em vez de acender uma caixa vazia -- que e' o que
			aconteceria se este ramo nao existisse, e seria pior que nao mostrar
			nada. Regerando o Cenario (ferramentas/gerar-cenario.py) o slot vira
			duas linhas e o efeito aparece junto. ]]
		slot.Text = string.format("%s %s  ·  %d", item.emoji, item.rotulo, item.moedas)
	else
		slot.Visible = false
		return
	end
	slot.Visible = true
end

local function atualizarTelao(ajustes: any)
	local fundo = fundoDoTelao()
	if not fundo then
		return -- mapa antigo, ou telao apagado: nao ha' o que preencher
	end

	telaoLista = listaDePresentes(ajustes)

	for i = 1, 4 do
		escreverSlot(fundo:FindFirstChild("Presente" .. i), telaoLista[i])
	end
end

local function lacoAjustes()
	while true do
		local ajustes = Servidor.lerAjustes()
		atualizarTelao(ajustes)
		if type(ajustes) == "table" and type(ajustes.geral) == "table" then
			local geral = ajustes.geral

			for _, item in ipairs(ESPELHADOS) do
				local valor = tonumber(geral[item.chave])
				if valor then
					local antigo = workspace:GetAttribute(item.atributo)
					workspace:SetAttribute(item.atributo, valor)
					--[[ Mudou a regua da grade? Fecha o ciclo AGORA.

						Sem isto a mudanca so' valeria quando a formacao
						enchesse sozinha -- o que numa live normal demora tanto
						que, na pratica, mexer no painel nao fazia nada. Era
						exatamente o sintoma de "botei 5 por fileira e continua
						10". ]]
					if item.reiniciaCiclo and antigo ~= nil and antigo ~= valor then
						pedirFormacaoNova = true
					end
				end
			end

			for _, item in ipairs(ESPELHADOS_SIMNAO) do
				local valor = geral[item.chave]
				if type(valor) == "boolean" then
					workspace:SetAttribute(item.atributo, valor)
				end
			end

			for _, item in ipairs(ESPELHADOS_TEXTO) do
				local valor = geral[item.chave]
				if type(valor) == "string" and valor ~= "" then
					workspace:SetAttribute(item.atributo, valor)
				end
			end
		end
		task.wait(5)
	end
end

--[[ ─────────────── O RODIZIO DA COLUNA CENTRAL ───────────────

	A coluna do meio do telao tem 37 studs de largura -- e' o que sobra depois
	que o video em pe' corta o resto da parede. Nesse espaco NAO cabem, ao mesmo
	tempo e legiveis, o convite da live e a lista do que cada presente faz.

	Entao ela vira pagina. A CHAMADA volta entre dois presentes, sempre, e nao
	uma vez a cada volta completa: ela e' a unica coisa que a live PRECISA
	dizer, e alguem que chegou agora nao pode cair num telao que so' fala de
	preco. Com dois presentes cadastrados o convite ocupa 60% do tempo; com
	quatro, ainda 60% -- porque ele entra entre cada par, e nao no fim da fila.

	O rodizio e' tambem a unica coisa do cenario que se MEXE sozinha, e isso
	trabalha a favor: uma parede que muda a cada poucos segundos puxa o olho
	num vídeo em que o resto do fundo esta' parado.

	Se o mapa for antigo (gerado antes dos cartoes), o laco sai na primeira
	volta e o telao continua funcionando como sempre funcionou. ]]
local TELAO_CHAMADA_S = 6
local TELAO_PRESENTE_S = 4

local function lacoTelao()
	while true do
		local fundo = fundoDoTelao()
		if not fundo then
			-- O Cenario chega junto com o lugar, mas este script pode subir
			-- antes de a arvore terminar de replicar.
			task.wait(2)
			continue
		end

		local chamada = fundo:FindFirstChild("CartaoChamada")
		local cartao = fundo:FindFirstChild("CartaoPresente")
		if not (chamada and chamada:IsA("GuiObject")
				and cartao and cartao:IsA("GuiObject")) then
			return -- mapa antigo: nao ha' cartoes pra girar
		end

		chamada.Visible = true
		cartao.Visible = false
		task.wait(TELAO_CHAMADA_S)

		if #telaoLista > 0 then
			telaoPagina = telaoPagina % #telaoLista + 1
			local item = telaoLista[telaoPagina]
			local nome = cartao:FindFirstChild("Nome")
			local efeito = cartao:FindFirstChild("Efeito")
			local preco = cartao:FindFirstChild("Preco")
			if nome and nome:IsA("TextLabel") then
				nome.Text = string.format("%s %s", item.emoji, item.rotulo)
			end
			if efeito and efeito:IsA("TextLabel") then
				efeito.Text = item.frase
			end
			if preco and preco:IsA("TextLabel") then
				-- "1 moeda", e nao "1 moedas". O presente mais barato e' o que
				-- mais aparece no telao, entao o erro de concordancia ficaria
				-- na tela a live inteira.
				local moedas = string.format("%d %s", item.moedas,
					if item.moedas == 1 then "moeda" else "moedas")
				-- O segundo efeito pega carona quando existe. Sem o `if`, um
				-- presente que so' aumenta ficaria com um "·" solto no fim.
				preco.Text = if item.extra ~= ""
					then moedas .. " · " .. item.extra
					else moedas
			end
			chamada.Visible = false
			cartao.Visible = true
			task.wait(TELAO_PRESENTE_S)
		end
	end
end

--[[ Conta ao painel de que tamanho esta' o avatar de cada pessoa.

	A cada 3s, junto do placar, e nao a cada crescimento: crescer e' um evento
	que acontece varias vezes por segundo num combo, e uma requisicao HTTP por
	crescimento estouraria o teto de 500/min do HttpService -- que nao da' erro,
	so' TRAVA as requisicoes por uns 30 segundos. A live inteira congelaria, e
	a causa seria o envio de uma informacao de diagnostico. ]]
local function lacoTamanhos()
	while true do
		task.wait(3)
		local tamanhos: { [string]: any } = {}
		local algum = false
		for _, avatar in ipairs(naTela) do
			if avatar.tiktok_id ~= "" and avatar.modelo.Parent then
				local linha = tamanhos[avatar.tiktok_id]
				if linha then
					linha.avatares += 1
					-- O MAIOR boneco da pessoa e' o que o painel mostra: e' o
					-- que ela ve' na tela e o que o crescimento afetou.
					if avatar.escala > linha.tamanho then
						linha.tamanho = avatar.escala
					end
				else
					tamanhos[avatar.tiktok_id] =
						{ tamanho = avatar.escala, avatares = 1 }
					algum = true
				end
			end
		end
		if algum then
			Servidor.publicarTamanhos(tamanhos)
		end
	end
end

-- ─────────────────────────── Subida ───────────────────────────

--[[ Liga as requisicoes HTTP sozinho, se der.

	Sem elas o jogo nao fala com o servidor da live e NADA aparece -- e a
	mensagem que a Roblox devolve ("Http requests are not enabled") nao diz onde
	fica a chave que liga isso.

	Em modo Play no Studio a propriedade costuma aceitar escrita, e ai' o kit
	resolve sozinho um dos motivos mais comuns de "nao acontece nada". Quando
	nao aceita, o pcall segura o erro e o aviso da tela ensina o caminho do
	Game Settings. ]]
local function ligarHttp()
	local http = game:GetService("HttpService")
	if http.HttpEnabled then
		return
	end
	local ok = pcall(function()
		http.HttpEnabled = true
	end)
	if ok and http.HttpEnabled then
		print("[live] liguei as requisicoes HTTP sozinho.")
	end
end

local function subir()
	--[[ O PALCO PRIMEIRO, antes de qualquer conferencia.

		Antes o mapa so' era montado DEPOIS do teste de configuracao, entao
		qualquer problema de servidor deixava o Studio numa tela vazia -- que e'
		o quadro que faz quem comprou concluir que o kit nao funciona. Agora o
		palco esta' de pe' aconteca o que acontecer, e o que falta aparece
		escrito em cima dele. ]]
	montarPalco()
	ligarHttp()

	if not Servidor.configurado() then
		warn("[live] URL ou CHAVE vazios em Segredos.luau -- o jogo nao vai "
			.. "receber nada. Isto e' de proposito: melhor parar aqui do que "
			.. "falhar em silencio no meio de uma live.")
		avisar("FALTA CONFIGURAR O SEGREDOS.LUAU",
			"URL ou CHAVE estao vazios em roblox/src/ServerScriptService/"
				.. "Segredos.luau.")
		return
	end

	Avatares.iniciarRelogio()
	-- Antes de qualquer avatar nascer: a danca principal carrega? Se nao, o
	-- modulo troca pra reserva sozinho e a live nem percebe.
	Avatares.escolherDanca()

	--[[ Ancora no FIM da fila antes de comecar.

		Sem isto, um servidor que sobe no meio da live receberia o historico
		inteiro de uma vez e spawnaria uma multidao de fantasmas no primeiro
		segundo -- gente que comentou ha' dez minutos e ja' foi embora. ]]
	if ancorar() then
		print(string.format("[live] conectado ao servidor. Ancorado no evento %d.", cursor))
	else
		--[[ Falhou agora, mas isto NAO libera o jogo pra puxar do zero: o
			`ancorado` continua falso e o lacoServidor tenta de novo a cada
			volta, sem spawnar nada enquanto isso. Uma live que demora dois
			segundos a mais pra comecar e' muito melhor que uma live que abre
			despejando o historico inteiro na tela. ]]
		warn("[live] nao consegui falar com o servidor em " .. Segredos.URL)
		warn("[live] confira: a janela 'SERVIDOR DA LIVE' esta' aberta? "
			.. "E o HttpService esta' ligado em Game Settings > Security?")
		warn("[live] vou continuar tentando -- nenhum boneco nasce ate' o "
			.. "servidor responder.")
	end

	task.spawn(lacoServidor)
	task.spawn(lacoSpawn)
	task.spawn(lacoPlacar)
	task.spawn(lacoAjustes)
	task.spawn(lacoTelao)
	task.spawn(lacoTamanhos)

	print("[live] tudo no ar. Comente um nick do Roblox na sua live.")
end

subir()
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="13">
      <Properties>
        <string name="Name">Segredos</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Endereco e chave do servidor da live.

	Este modulo vive em ServerScriptService e NUNCA e' replicado pros clientes.
	E' por isso que ele existe separado do Config.luau: se a chave estivesse em
	ReplicatedStorage, qualquer pessoa que entrasse na sua experiencia
	conseguiria le-la e ficar consultando (ou poluindo) o seu servidor.
]]

return {
	--[[ O servidor roda na SUA maquina, sem nuvem e sem cota.

		Isto so' funciona com o jogo rodando no Studio em modo PLAY -- nesse
		modo o servidor do jogo roda no seu PC e alcanca o 127.0.0.1. O jogo
		PUBLICADO roda na nuvem da Roblox e nao alcanca a sua maquina; com ele,
		nada aparece, e nao ha' configuracao que resolva.
	]]
	URL = "http://127.0.0.1:8000",

	--[[ A chave de LEITURA. Nunca ponha a de escrita aqui.

		Se esta vazar, o pior que fazem e' ler a fila. Com a de escrita,
		injetariam avatares falsos na sua live. Rodando local nada disso e'
		alcancavel de fora do seu PC, mas o par continua separado pra que a
		troca pra nuvem, um dia, seja so' mudar estas duas linhas.
	]]
	CHAVE = "leitura-local",

	--[[ Intervalo entre consultas ao servidor.

		1s = 60 requisicoes por minuto, bem abaixo do teto de 500/min por
		servidor do HttpService.

		NAO baixe de 0,5s: estourar o teto nao da' erro, faz as requisicoes
		TRAVAREM por cerca de 30 segundos -- e ai' a live inteira congela, sem
		nenhuma mensagem dizendo por que.
	]]
	INTERVALO = 1.0,
}
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="14">
      <Properties>
        <string name="Name">Servidor</string>
        <string name="Source"><![CDATA[--!strict
--[[
	Conversa com o servidor da live.

	POR QUE O JOGO PERGUNTA EM VEZ DE RECEBER

	O Roblox nao fala WebSocket, e o HttpService so' faz requisicao de SAIDA.
	Nao existe nenhum jeito de o jogo ser AVISADO de que alguem comentou -- ele
	tem que perguntar.

	Dai' o cursor: cada resposta diz ate' onde o jogo ja' leu, e a pergunta
	seguinte continua dali. Sem isso, ou o jogo receberia tudo de novo a cada
	segundo, ou perderia o que chegou entre duas perguntas.
]]

local HttpService = game:GetService("HttpService")
local Segredos = require(script.Parent:WaitForChild("Segredos"))

local Servidor = {}

export type Spawn = {
	tiktok_id: string,
	nickname: string,
	nick_roblox: string,
	roblox_id: number,

	-- Quem tem numero maior fura a fila e entra na frente.
	prio: number,
	-- Multiplicador de tamanho com que o avatar NASCE.
	escala: number,
	--[[ Quanto SOMAR no avatar que esta pessoa ja' tem na tela.
		0 = este evento nao faz crescer.

		Escala e crescimento sao coisas diferentes e o jogo usa uma OU a outra,
		nunca as duas: quem ja' tem boneco cresce, quem nao tem nasce. Ver
		`Principal.aplicar`. ]]
	crescimento: number,
	-- Segundos na tela antes de sumir.
	vida: number,
	-- Segundos em que NINGUEM mais nasce depois deste avatar. Como a camera
	-- acompanha quem acabou de chegar, isto vira o tempo de tela dele.
	segura: number,
	-- Segundos de CINEMATICA (0 = nenhuma). So' presente caro tem.
	cena: number,
	-- Segundos varrendo a formacao e derrubando todo mundo (0 = nao faz).
	furacao: number,
	-- Cor do nome e do brilho, em hexadecimal ("FF2D6F").
	cor: string,
	-- Forca da aura, de 0 a 5. 0 = sem aura.
	brilho: number,
	-- A danca SO' DESTE avatar ("rosquinha", "oculos", "galaxia"...). "" = a
	-- danca padrao, a mesma de quem so' comentou. O nome tem que bater com uma
	-- chave de Config.DANCAS; nome desconhecido cai na padrao em vez de deixar o
	-- boneco parado.
	danca: string,
	-- Segundos em que a formacao INTEIRA troca pra danca especial e volta.
	danca_geral: number,
	-- Escala do COLOSSO: um gigante atras da formacao, fora da grade. 0 = normal.
	colosso: number,

	-- O nome do presente que trouxe esta pessoa ("" = comentario ou curtida).
	presente: string,
	-- O ID numerico do presente no TikTok ("" = nao veio).
	presente_id: string,
	moedas: number,
	-- comentario | curtida | seguiu | compartilhou | presente
	tipo: string,
	-- Quantas curtidas CRUAS este evento representa (a ponte junta N por avatar).
	curtidas: number,
	-- A posicao dentro de um combo. 0 = o primeiro, ou um presente avulso.
	combo: number,
}

--[[ COMO FOI A ULTIMA CONVERSA COM O SERVIDOR.

	Guardado aqui porque o `pedir` engole os erros de proposito (com o servidor
	instavel, um warn por falha repetiria 60x por minuto e afogaria o Output).
	So' que engolir tudo produzia o pior sintoma do kit: a tela vazia com o chat
	andando, sem uma linha em lugar nenhum dizendo de que lado estava o
	problema.

	Agora o motivo fica gravado, e o Principal usa ele pra por um aviso na TELA
	-- que e' onde quem comprou esta' olhando. ]]
local ultimoOk = false
local ultimoMotivo = "ainda nao tentei falar com o servidor"

--[[ (deu certo?, por que nao). O motivo e' texto cru da Roblox: quem traduz
	pra portugues e' o Principal, que e' quem mostra. ]]
function Servidor.estado(): (boolean, string)
	return ultimoOk, ultimoMotivo
end

local function pedir(caminho: string): any?
	local ok, resposta = pcall(function()
		return HttpService:RequestAsync({
			Url = Segredos.URL .. caminho,
			Method = "GET",
			Headers = { ["X-Chave"] = Segredos.CHAVE },
		})
	end)

	if not ok then
		-- Erro de rede, ou HttpService desligado. Silencioso de proposito: com
		-- o servidor instavel isto repetiria 60x por minuto e afogaria o Output
		-- justamente quando voce precisa ler alguma outra coisa nele.
		ultimoOk, ultimoMotivo = false, tostring(resposta)
		return nil
	end
	if not resposta.Success then
		if resposta.StatusCode == 401 then
			warn("[servidor] chave recusada -- confira CHAVE em Segredos.luau")
		end
		ultimoOk = false
		ultimoMotivo = string.format("o servidor respondeu %d", resposta.StatusCode)
		return nil
	end
	ultimoOk, ultimoMotivo = true, ""

	local okJson, dados = pcall(function()
		return HttpService:JSONDecode(resposta.Body)
	end)
	return if okJson then dados else nil
end

--[[ "Estou entrando agora, me diga so' onde a fila esta'."

	Sem isto, um servidor de jogo que sobe no meio da live receberia o historico
	inteiro de uma vez e spawnaria uma multidao de fantasmas no primeiro segundo
	-- gente que comentou ha' dez minutos e ja' foi embora.
]]
function Servidor.ancorar(): number?
	local dados = pedir("/eventos")
	if type(dados) == "table" and type(dados.seq) == "number" then
		return dados.seq
	end
	return nil
end

--[[ Devolve (novoCursor, spawns).

	Em falha devolve o cursor ANTIGO e uma lista vazia: a proxima volta do laco
	tenta de novo do mesmo ponto, e ninguem se perde. ]]
function Servidor.puxar(cursor: number): (number, { Spawn })
	local dados = pedir("/eventos?desde=" .. tostring(cursor))
	if type(dados) ~= "table" or type(dados.seq) ~= "number" then
		return cursor, {}
	end

	local spawns: { Spawn } = {}
	for _, ev in ipairs(dados.lista or {}) do
		-- Um evento torto nao pode derrubar a live: valida, monta o que da', e
		-- ignora o resto em silencio.
		if type(ev) == "table" and type(ev.roblox_id) == "number" and ev.roblox_id > 0 then
			table.insert(spawns, {
				tiktok_id = tostring(ev.tiktok_id or ""),
				nickname = tostring(ev.nickname or "?"),
				nick_roblox = tostring(ev.nick_roblox or ""),
				roblox_id = ev.roblox_id,

				prio = tonumber(ev.prio) or 0,
				escala = math.clamp(tonumber(ev.escala) or 1, 0.5, 4),
				-- Teto de 3 por evento, igual ao CRESCIMENTO_MAX do
				-- ponte/regras.py. Nao e' o teto do AVATAR (esse e' o
				-- tamanho_max, que vem do painel): e' o teto do SALTO, pra um
				-- evento torto nao fazer um boneco pular de tamanho num quadro
				-- so' e atravessar meia formacao antes de a camera reagir.
				crescimento = math.clamp(tonumber(ev.crescimento) or 0, 0, 3),
				vida = math.clamp(tonumber(ev.vida) or 45, 5, 900),
				-- Teto de 25s: um `segura` grande demais -- por bug ou por
				-- evento forjado -- congelaria os spawns, e a live inteira
				-- pararia sem nenhum sinal do que aconteceu.
				segura = math.clamp(tonumber(ev.segura) or 0.4, 0, 25),
				cena = math.clamp(tonumber(ev.cena) or 0, 0, 25),
				-- Teto de 20s pelo mesmo motivo: uma varredura sem fim deixaria
				-- a formacao presa pro resto da transmissao.
				furacao = math.clamp(tonumber(ev.furacao) or 0, 0, 20),
				cor = tostring(ev.cor or "FFFFFF"),
				brilho = math.clamp(tonumber(ev.brilho) or 0, 0, 5),
				-- Cortado em 20 caracteres: o nome vira ATRIBUTO do modelo, e
				-- um evento torto com um texto gigante ficaria replicado pra
				-- todos os clientes, cem vezes por ciclo, sem servir pra nada.
				danca = string.sub(tostring(ev.danca or ""), 1, 20),
				danca_geral = math.clamp(tonumber(ev.danca_geral) or 0, 0, 120),
				colosso = math.clamp(tonumber(ev.colosso) or 0, 0, 40),

				presente = tostring(ev.presente or ""),
				presente_id = string.sub(tostring(ev.presente_id or ""), 1, 20),
				moedas = tonumber(ev.moedas) or 0,
				-- "comentario" como padrao: um evento de uma ponte antiga (sem
				-- o campo) continua valendo como participacao, em vez de cair
				-- num tipo desconhecido e sumir dos placares.
				tipo = tostring(ev.tipo or "comentario"),
				-- Teto alto mas existente: um evento forjado com um numero
				-- absurdo tomaria o placar de curtidas pra sempre.
				curtidas = math.clamp(tonumber(ev.curtidas) or 0, 0, 100000),
				combo = math.clamp(tonumber(ev.combo) or 0, 0, 300),
			})
		end
	end
	return dados.seq, spawns
end

export type LinhaDePlacar = { nick: string, id: number, pontos: number }

--[[ Publica os TRES placares (top 10 cada) -- e' o que alimenta o overlay do
	OBS. Silencioso em falha, e de proposito: placar atrasado e' muito melhor
	que Output afogado no meio da live.

	Os tres numa requisicao so', e nao uma cada: sao tres leituras da MESMA live
	que mudam ao mesmo tempo, e manda-las separadas triplicaria o trafego pra
	mostrar exatamente a mesma coisa. ]]
function Servidor.publicarPlacar(moedas: { LinhaDePlacar }, curtidas: { LinhaDePlacar },
	presenca: { LinhaDePlacar })
	pcall(function()
		HttpService:RequestAsync({
			Url = Segredos.URL .. "/placar",
			Method = "POST",
			Headers = {
				["X-Chave"] = Segredos.CHAVE,
				["content-type"] = "application/json",
			},
			Body = HttpService:JSONEncode({
				moedas = moedas,
				curtidas = curtidas,
				presenca = presenca,
			}),
		})
	end)
end

--[[ Avisa em QUEM a camera acabou de parar.

	E' isto que faz a voz narrar: da' pra tocar uma fala gravada so' pra quem
	mandou presente, outra pra quem so' comentou -- e ate' uma so' da rosquinha,
	porque o nome do presente vai junto.

	Silencioso em falha, e chamado de dentro de um task.spawn: uma fala perdida
	nao vale segurar o laco da live. ]]
function Servidor.avisarCamera(tipo: string, nick: string, presente: string)
	pcall(function()
		HttpService:RequestAsync({
			Url = Segredos.URL .. "/camera",
			Method = "POST",
			Headers = {
				["X-Chave"] = Segredos.CHAVE,
				["content-type"] = "application/json",
			},
			Body = HttpService:JSONEncode({ tipo = tipo, nick = nick, presente = presente }),
		})
	end)
end

--[[ Manda pro painel o TAMANHO de cada avatar que esta' na tela.

	POR QUE O JOGO PRECISA CONTAR ISTO

	A ponte sabe quem mandou presente; so' o jogo sabe de que tamanho o boneco
	ficou. Sem este envio, a coluna "tamanho atual" do painel seria uma
	previsao -- e previsao erra sempre que um avatar nao carregou, quando o
	ciclo limpou a formacao, ou quando o teto de tamanho cortou o crescimento.
	Mostrar 5.4 pra um boneco que na verdade esta' em 2.0 e' pior do que nao
	mostrar nada, porque e' com esse numero que voce vai calibrar o painel. ]]
function Servidor.publicarTamanhos(tamanhos: { [string]: any })
	pcall(function()
		HttpService:RequestAsync({
			Url = Segredos.URL .. "/jogadores",
			Method = "POST",
			Headers = {
				["X-Chave"] = Segredos.CHAVE,
				["content-type"] = "application/json",
			},
			Body = HttpService:JSONEncode({ tamanhos = tamanhos }),
		})
	end)
end

--[[ O ciclo limpou a formacao: zera os tamanhos no painel de uma vez.

	Separado do `publicarTamanhos` porque nao da' pra dizer "ninguem tem
	avatar" mandando uma tabela vazia -- o servidor nao teria como distinguir
	isso de "nao tenho novidade", e o painel ficaria mostrando os tamanhos do
	ciclo anterior pra sempre. ]]
function Servidor.limparTamanhos()
	pcall(function()
		HttpService:RequestAsync({
			Url = Segredos.URL .. "/jogadores",
			Method = "POST",
			Headers = {
				["X-Chave"] = Segredos.CHAVE,
				["content-type"] = "application/json",
			},
			Body = HttpService:JSONEncode({ limpar_tamanhos = true }),
		})
	end)
end

--[[ Uma linha no diario do painel, vinda de DENTRO do jogo.

	O Output do Studio ja' recebe tudo por `print`/`warn`. Mas ele fica atras
	da janela do jogo durante a transmissao, e o que acontece no Roblox (o
	avatar que nao carregou, o ciclo que fechou) e' justamente o que nao
	aparece em lugar nenhum do painel. Com isto, o painel conta a historia
	inteira num lugar so'. ]]
function Servidor.contar(nivel: string, texto: string)
	pcall(function()
		HttpService:RequestAsync({
			Url = Segredos.URL .. "/logs",
			Method = "POST",
			Headers = {
				["X-Chave"] = Segredos.CHAVE,
				["content-type"] = "application/json",
			},
			Body = HttpService:JSONEncode({
				linhas = { { nivel = nivel, origem = "jogo", texto = texto } },
			}),
		})
	end)
end

--[[ Os ajustes do PAINEL. O jogo consulta de tempos em tempos e aplica sem
	reiniciar -- e' o que faz o "salvei e ja' valeu" ser verdade tambem DENTRO
	do Roblox, e nao so' na ponte. ]]
function Servidor.lerAjustes(): any?
	return pedir("/ajustes")
end

function Servidor.configurado(): boolean
	return Segredos.URL ~= "" and Segredos.CHAVE ~= ""
end

return Servidor
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="15">
    <Properties>
      <string name="Name">SoundService</string>
      <token name="AmbientReverb">10</token>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="18">
        <Properties>
          <string name="Name">Aviso</string>
          <string name="Source"><![CDATA[--!strict
--[[
	O aviso na TELA quando a live nao esta' recebendo nada.

	POR QUE ISTO EXISTE

	O relato numero 1 de quem comprou o kit e' sempre a mesma frase: "apertei
	Play e nao acontece nada". E "nada" tem causas diferentes, com solucoes
	diferentes:

	  - a janela preta do servidor fechou (ou nem chegou a abrir);
	  - as requisicoes HTTP estao desligadas no Studio;
	  - esta' tudo certo e ninguem comentou um nick do Roblox ainda.

	Ate' aqui as tres se pareciam com exatamente a mesma coisa: um palco vazio.
	A resposta existia -- no Output do Studio, na janela preta da ponte, no
	diagnostico do painel -- mas em tres lugares que quem esta' de olho na tela
	do jogo nao esta' olhando.

	Entao a resposta vem pra ONDE A PESSOA ESTA' OLHANDO.

	QUANDO ELE APARECE, E QUANDO NAO APARECE

	So' quando o jogo passou varios segundos sem conseguir falar com o servidor
	-- ou seja, quando a live ja' esta' quebrada e nao ha' nada pra atrapalhar.
	Ele some sozinho no instante em que o servidor responde. Numa live que
	funciona, este arquivo nunca desenha nada.

	Fica no CANTO, e nao no meio, pelo mesmo motivo: se acontecer de aparecer
	com a transmissao no ar, ele avisa sem tapar a live.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local canal = ReplicatedStorage:WaitForChild("AvisoLive") :: RemoteEvent

-- A anotacao existe pro modo estrito: em StarterPlayerScripts o LocalPlayer
-- sempre existe, mas o tipo declarado pela Roblox e' `Player?`.
local jogador = Players.LocalPlayer :: Player
local paiDaGui = jogador:WaitForChild("PlayerGui")

local tela = Instance.new("ScreenGui")
tela.Name = "AvisoDaLive"
tela.ResetOnSpawn = false
-- Sem personagem, o jogador nunca "renasce", mas a inset da barra superior
-- continua existindo: sem isto o aviso nasce empurrado alguns pixels pra baixo
-- e desalinha do canto.
tela.IgnoreGuiInset = true
tela.DisplayOrder = 50
tela.Enabled = false
tela.Parent = paiDaGui

local caixa = Instance.new("Frame")
caixa.Name = "Caixa"
caixa.Size = UDim2.new(0, 520, 0, 132)
caixa.Position = UDim2.new(0.5, -260, 0, 24)
caixa.BackgroundColor3 = Color3.fromRGB(12, 12, 18)
caixa.BackgroundTransparency = 0.12
caixa.BorderSizePixel = 0
caixa.Parent = tela

local canto = Instance.new("UICorner")
canto.CornerRadius = UDim.new(0, 14)
canto.Parent = caixa

local linha = Instance.new("UIStroke")
linha.Color = Color3.fromRGB(255, 45, 111)
linha.Thickness = 2
linha.Transparency = 0.15
linha.Parent = caixa

local titulo = Instance.new("TextLabel")
titulo.Name = "Titulo"
titulo.BackgroundTransparency = 1
titulo.Size = UDim2.new(1, -32, 0, 34)
titulo.Position = UDim2.new(0, 16, 0, 14)
titulo.Font = Enum.Font.GothamBold
titulo.TextSize = 22
titulo.TextColor3 = Color3.fromRGB(255, 214, 64)
titulo.TextXAlignment = Enum.TextXAlignment.Left
titulo.Text = ""
titulo.Parent = caixa

local texto = Instance.new("TextLabel")
texto.Name = "Texto"
texto.BackgroundTransparency = 1
texto.Size = UDim2.new(1, -32, 0, 66)
texto.Position = UDim2.new(0, 16, 0, 50)
texto.Font = Enum.Font.Gotham
texto.TextSize = 16
texto.TextColor3 = Color3.fromRGB(235, 235, 245)
texto.TextXAlignment = Enum.TextXAlignment.Left
texto.TextYAlignment = Enum.TextYAlignment.Top
texto.TextWrapped = true
texto.Text = ""
texto.Parent = caixa

--[[ O servidor manda (titulo, texto) pra mostrar e (nil, nil) pra esconder.

	Esconder pelo `Enabled` em vez de destruir e recriar: a mesma live pode
	perder e recuperar o servidor varias vezes (a janela preta fechada e aberta
	de novo, por exemplo), e recriar a GUI a cada vez custaria uma piscada na
	transmissao. ]]
canal.OnClientEvent:Connect(function(qual: any, detalhe: any)
	if type(qual) ~= "string" or qual == "" then
		tela.Enabled = false
		return
	end
	titulo.Text = qual
	texto.Text = tostring(detalhe or "")
	tela.Enabled = true
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="19">
        <Properties>
          <string name="Name">Camera</string>
          <string name="Source"><![CDATA[--!strict
--[[
	A camera da live.

	Ela e' o que separa "um monte de bonecos num campo" de uma transmissao que
	alguem assiste ate' o fim.

	  SEGUIR   o padrao, e o que roda a live quase inteira. Enquadra quem acabou
	           de chegar JUNTO COM O TELAO, e se ajusta sozinha quando o avatar
	           e' grande ou quando a formacao se aproxima.
	  ABERTA   fim do ciclo: recua e mostra a formacao inteira antes de limpar.
	  CENA     DESLIGADA por padrao (Config.CAMERA.CENA_LIGADA). Ela cortava
	           pro presente caro e girava em volta; numa live movimentada a
	           camera passava mais tempo rodando em torno de alguem do que
	           mostrando a live, e cada giro escondia a multidao do fundo.
	           O codigo continua aqui pra quem quiser ligar de volta.

	═══════════════════════════════════════════════════════════════════════
	POR QUE O ENQUADRAMENTO E' CALCULADO, E NAO UM OFFSET FIXO
	═══════════════════════════════════════════════════════════════════════

	A versao anterior punha a camera num deslocamento fixo do alvo: sempre 17
	studs acima e 42 atras, mirando no peito dele. Isso da' um quadro bonito
	numa situacao e errado em todas as outras, porque tres coisas mudam durante
	a live:

	  1. O TAMANHO DO ALVO. O avatar cresce com presente, ate' 6x. Um boneco de
	     36 studs mirado pelo peito com a lente a 42 studs sai pela borda de
	     cima do quadro.
	  2. A FILEIRA. A formacao avanca ~70 studs em direcao a' camera ao longo de
	     um ciclo, entao a distancia ate' o telao quase dobra do comeco ao fim.
	  3. O FORMATO DO VIDEO. Em 9:16 a abertura horizontal e' pouco mais de um
	     terco da de 16:9.

	O sintoma disso era concreto e constante: mirando no peito de quem acabou de
	chegar, a lente ficava inclinada uns 22 graus pra baixo, e com isso o TOPO
	DO TELAO caia fora do quadro. O telao existe pra dizer "comente seu nick";
	cortado pela metade, ele nao diz nada, e a live perde o unico convite que
	ela faz.

	Aqui a camera declara o que PRECISA estar no quadro (o topo do telao, a
	cabeca do avatar e os pes dele) e resolve a distancia e a inclinacao que
	fazem os tres caberem, com folga. Se nao houver distancia que resolva --
	acontece com um colosso -- ela desiste do telao e prioriza o avatar, que e'
	a escolha certa nesse impasse.

	O QUE "O TELAO" QUER DIZER AQUI

	A peca `Telao` e' so' a JANELA DO MEIO da parede de LED (y 18..32) -- a que
	carrega texto. Abaixo e acima ficam PainelInferior e PainelSuperior, e a
	camera NAO promete caber os dois: com a lente na altura do peito, o alto da
	parede nao esta' no quadro em nenhuma distancia razoavel, e o pe' dela fica
	atras das cabecas da galera. Ver o bloco TELAO do Config.luau.

	E O TELAO NAO MANDA MAIS NO PLANO. Ele empurra a lente pra tras ate'
	CAMERA.TELAO_RECUO_MAX e para ali; passando disso o solver desiste dele e
	entrega o plano de perto. Quem manda no quadro e' o boneco de quem chegou.

	═══════════════════════════════════════════════════════════════════════
	O ZOOM DE CHEGADA
	═══════════════════════════════════════════════════════════════════════

	Quem comenta ou manda presente ganha CAMERA.ZOOM_S segundos de close, com o
	boneco ocupando ~74% da altura do quadro e o nick legivel. Depois a camera
	volta sozinha pro plano aberto.

	Existe porque os dois pedidos do quadro brigam: o plano normal precisa da
	multidao e do telao, o close precisa de uma pessoa so'. Resolvido no TEMPO
	em vez de no espaco, os dois cabem.

	POR QUE ELA E' DO LADO DO CLIENTE

	A camera no Roblox e' propriedade do cliente. Mover do servidor exigiria
	replicar CFrame 60 vezes por segundo pra cada quadro -- e o resultado, no
	video, seria uma camera aos trancos. Aqui o servidor manda so' o EVENTO
	("agora o alvo e' aquele avatar") e o movimento e' calculado localmente.

	O ATRASO E' PROPOSITAL

	`SUAVIDADE` faz a camera chegar DEPOIS de quem ela persegue. Isso e' o que
	da' a sensacao de camera na mao de alguem em vez de trilho de trem. Colar no
	alvo instantaneamente parece um bug, mesmo estando "certo".
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))
--[[ A conta de enquadramento mora num modulo puro pra poder ser TESTADA sem
	abrir o Studio. Ver roblox/src/ReplicatedStorage/Enquadramento.luau e a
	suite em roblox/testes/. ]]
local Enquadramento = require(ReplicatedStorage:WaitForChild("Enquadramento"))

local camera = workspace.CurrentCamera
local canal = ReplicatedStorage:WaitForChild("CameraLive") :: RemoteEvent

camera.CameraType = Enum.CameraType.Scriptable

-- ─────────────────────────── Estado ───────────────────────────

local modo = "seguir"
local alvo: Model? = nil
local cenaAte = 0
-- Ate' quando o ZOOM DE CHEGADA vale. Ver `destinoZoom`.
local zoomAte = 0
local centroAberto = Vector3.new(0, 0, 0)
-- Do fundo ate' a fileira da frente. O servidor manda junto com o centro.
local profundidadeAberta = 0
local abertaAte = 0
-- O angulo do giro da CENA. Guardado entre quadros pra ele continuar de onde
-- parou, em vez de saltar quando o modo troca.
local anguloCena = 0

--[[ Onde a camera QUER estar. O movimento de verdade e' a interpolacao entre a
	posicao atual e esta, quadro a quadro. ]]
local destino = CFrame.new(0, 20, 40)

-- ─────────────────── Os ajustes que vem do painel ───────────────────
--
-- Lidos a cada quadro, dos atributos do workspace. E' o que faz mexer no painel
-- valer na hora, sem reiniciar o Play -- e ler direto (em vez de guardar numa
-- variavel atualizada por evento) e' o que garante que nao existe uma copia
-- velha em lugar nenhum.

local function ajuste(nome: string, padrao: number, minimo: number, maximo: number): number
	local v = tonumber(workspace:GetAttribute(nome))
	return if v then math.clamp(v, minimo, maximo) else padrao
end

local function ehVertical(): boolean
	local v = workspace:GetAttribute("Vertical")
	if type(v) == "boolean" then
		return v
	end
	--[[ Sem ajuste do painel, DEDUZ pelo formato da janela.

		E' o padrao mais util: quem grava o Studio direto no OBS em modo retrato
		ganha o enquadramento certo sem saber que existe um ajuste. O painel
		continua podendo forcar, pra quem grava em janela deitada e recorta
		depois -- caso em que a janela mente sobre o formato final. ]]
	local tela = camera.ViewportSize
	return tela.Y > tela.X
end

local function recuoDoPainel(): number
	return ajuste("CameraRecuo", Config.CAMERA.RECUO, 10, 200)
end

-- ─────────────────────── O TELAO no mundo ───────────────────────

--[[ Mede o telao de verdade, uma vez, e guarda.

	Medir a peca em vez de confiar so' no Config e' o que faz o enquadramento
	acompanhar o mapa: arrastou o telao no Studio, a camera passa a mirar onde
	ele esta' agora. Com numeros fixos, mexer no mapa quebraria o quadro sem
	nenhum aviso -- e o defeito apareceria como "o telao voltou a ficar
	cortado", varios dias depois, sem ninguem lembrar da mudanca.

	Uma vez so' porque o telao e' ancorado e nao se move durante a live; medir
	todo quadro seria uma travessia da arvore do Workspace 60 vezes por segundo
	pra sempre dar a mesma resposta. ]]
local telao = {
	z = Config.TELAO.Z,
	topo = Config.TELAO.TOPO,
	meiaLargura = Config.TELAO.MEIA_LARGURA,
}

local function medirTelao()
	local cenario = workspace:FindFirstChild("Cenario")
	local parede = cenario and cenario:FindFirstChild("ParedeDeLED")
	local peca = parede and parede:FindFirstChild("Telao")
	if peca and peca:IsA("BasePart") then
		telao.z = peca.Position.Z
		telao.topo = peca.Position.Y + peca.Size.Y / 2
		telao.meiaLargura = peca.Size.X / 2
	end
end

task.spawn(function()
	-- O Cenario chega junto com o lugar, mas o script pode subir antes de a
	-- arvore terminar de replicar. Uma tentativa por segundo, por alguns
	-- segundos: se nao achar, os valores do Config seguem valendo.
	for _ = 1, 10 do
		medirTelao()
		if telao.z ~= Config.TELAO.Z or workspace:FindFirstChild("Cenario") then
			return
		end
		task.wait(1)
	end
end)

-- ─────────────────────── O solver de enquadramento ───────────────────────

--[[ Quantas VEZES um boneco normal este avatar tem de altura.

	6 studs e' a altura de um R15 padrao com um chapeu pequeno: um avatar comum
	precisa dar 1 aqui, senao o enquadramento de quem so' comentou mudaria
	junto. ]]
local function tamanhoDe(modelo: Model): number
	local ok, tamanho = pcall(function()
		return modelo:GetExtentsSize().Y
	end)
	if not ok or not tamanho then
		return 1
	end
	return math.clamp(tamanho / 6, 1, 8)
end

--[[ Monta o pedido que o modulo de enquadramento resolve.

	Toda a conta esta' no Enquadramento.luau, que e' puro e testado. Aqui so'
	se junta o que vem de tres lugares diferentes: o alvo (do mundo), o telao
	(medido no mapa) e os ajustes (do painel). ]]
--[[ Onde termina o BALAO DO NOME deste avatar, em Y do mundo.

	O balao fica `ROTULO.ALTURA * tamanho` acima do CENTRO DA CABECA (e' um
	StudsOffsetWorldSpace, ver `ajustarRotulo` no Avatares.luau) e tem
	`2.2 * raiz(tamanho)` studs de altura. A cabeca de um R15 tem o centro a
	uns 78% da altura do boneco.

	ESTA CONTA E' O QUE FAZ O NICK APARECER. Sem ela a camera enquadra ate' o
	alto da cabeca e o nome fica acima da borda -- e quanto mais perto a lente
	chega, mais do nome fica de fora. ]]
local function topoDoBalao(pes: number, topo: number, tamanho: number): number
	local altura = topo - pes
	return pes + altura * 0.78 + Config.ROTULO.ALTURA * tamanho
		+ 1.1 * math.sqrt(tamanho)
end

local function enquadrar(alvoZ: number, alvoPes: number, alvoTopo: number,
	topoQuadro: number?, tetoTelao: number?, partida: number?,
	margem: number?, alturaBase: number?)
	: (number, number, number)
	local fov = if ehVertical()
		then ajuste("CameraFov", Config.CAMERA.FOV_VERTICAL, 30, 110)
		else ajuste("CameraFov", Config.CAMERA.FOV, 30, 110)

	local plano = Enquadramento.resolver({
		alvoZ = alvoZ,
		alvoPes = alvoPes,
		alvoTopo = alvoTopo,
		alvoTopoQuadro = topoQuadro,
		telaoZ = telao.z,
		telaoTopo = telao.topo,
		fov = fov,
		margem = margem or Config.CAMERA.MARGEM_GRAUS,
		--[[ O piso e' 0, e nao 4. Com 4, o Config.CAMERA.ALTURA = 1 (a altura
			do peito) era silenciosamente empurrado pra 4 aqui dentro e a lente
			subia pros ombros -- um ajuste do Config anulado por um limite de
			outro arquivo, sem erro e sem aviso. Negativo continua barrado: uma
			camera abaixo do palco filma o chao. ]]
		alturaBase = alturaBase
			or ajuste("CameraAltura", Config.CAMERA.ALTURA, 0, 90),
		--[[ A PARTIDA e' o piso da busca: `menorQueCabe` procura a menor
			distancia A PARTIR dela, e nunca aproxima mais que isso. Por isso o
			zoom precisa mandar a dele -- com a partida do plano normal, o
			solver responderia "ja' cabe" e devolveria a mesma distancia de
			sempre, e o zoom simplesmente nao aconteceria. ]]
		partida = partida or ajuste("CameraDistancia", Config.CAMERA.DISTANCIA,
			Config.CAMERA.DISTANCIA_MIN, Config.CAMERA.DISTANCIA_MAX),
		minimo = Config.CAMERA.DISTANCIA_MIN,
		maximo = Config.CAMERA.DISTANCIA_MAX,
		--[[ Ate' onde o TELAO pode empurrar a lente pra tras.

			Sem este teto, o telao mandava no plano inteiro: ele fica 74 studs
			atras da formacao, e caber o topo dele junto com o avatar exigia
			recuar ate' o boneco virar um bonequinho. A live inteira ficava
			longe por causa do fundo.

			Com ele, quem manda e' o AVATAR. Se o telao nao couber dentro deste
			limite, o solver desiste dele (o caminho `comTelao = false`, que ja'
			existia pro colosso) e entrega o plano de perto -- com o telao
			aparecendo cortado no fundo, que e' o preco certo a pagar. ]]
		tetoComTelao = tetoTelao,
	})
	return plano.distancia, plano.eixo, plano.altura
end

-- ─────────────────────────── Os modos ───────────────────────────

--[[ Monta o CFrame a partir do que o solver decidiu.

	O ponto de mira sai do ANGULO escolhido, e nao de um ponto do corpo do
	avatar. E' a diferenca inteira desta versao: mirar no peito de quem chegou
	deixava a lente inclinada uns 22 graus pra baixo, e era isso que cortava o
	topo do telao. ]]
local function montarPlano(x: number, alvoZ: number, alvoPes: number,
	alvoTopo: number, tamanho: number, tetoTelao: number?,
	partida: number?, margem: number?, alturaBase: number?): CFrame
	-- O quadro vai ate' o topo do BALAO, e nao ate' o alto da cabeca: e' o que
	-- garante que o nick de quem chegou esta' dentro do video.
	local topoQuadro = topoDoBalao(alvoPes, alvoTopo, tamanho)
	local d, eixo, yCam = enquadrar(alvoZ, alvoPes, alvoTopo, topoQuadro,
		tetoTelao, partida, margem, alturaBase)
	-- A camera fica do lado +Z, que e' o lado pra onde todos os avatares olham.
	local posicao = Vector3.new(x, yCam, alvoZ + d)
	local mira = posicao + Vector3.new(0, math.tan(math.rad(eixo)) * d, -d)
	return CFrame.new(posicao, mira)
end

--[[ ─────────────── O ZOOM DE CHEGADA ───────────────

	Quem comenta ou manda presente ganha alguns segundos de CLOSE: o boneco
	grande na tela, com o nick legivel, e depois a camera volta pro plano
	normal.

	POR QUE ISTO EXISTE

	Porque os dois pedidos do quadro brigam entre si. O plano normal precisa
	mostrar a MULTIDAO e o TELAO -- e' o que faz a proxima pessoa comentar. O
	close precisa mostrar UMA pessoa e o nome dela -- e' o que faz quem ja'
	comentou continuar assistindo. Nao existe uma distancia so' que entregue
	as duas coisas: a que mostra a multidao deixa a skin pequena, e a que
	mostra a skin corta a multidao.

	Resolver isso no TEMPO, e nao no espaco, entrega as duas: o close acontece
	no instante em que a pessoa chega (que e' o unico instante em que ela esta'
	olhando), e o resto do tempo a live respira aberta.

	O CLOSE NAO PEDE O TELAO. Ele enquadra so' o avatar e o balao do nome --
	por isso `tetoComTelao = 0`, que faz o solver desistir do fundo na hora em
	vez de recuar pra tentar caber os dois. ]]
local function destinoZoom(m: Model): CFrame?
	local ok, pivo = pcall(function()
		return m:GetPivot().Position
	end)
	if not ok or not pivo then
		return nil
	end
	local tamanho = tamanhoDe(m)
	local pes = pivo.Y - 3 * tamanho
	--[[ CORPO INTEIRO, E A LENTE NA HORIZONTAL.

		A primeira versao cortava na cintura pra chegar mais perto. Chegava --
		e saia olhando pra cima: com o quadro indo da cintura ao topo do balao,
		o MEIO do que precisa caber fica na altura da cabeca, e o eixo optico
		vai atras dele. Na tela, o boneco escorregava pro rodape e o miolo do
		quadro virava parede.

		Agora o quadro vai do PE' ao topo do balao, e as duas pontas ficam a
		mesma distancia da altura da lente (o peito, 4 studs num boneco normal;
		o balao termina em 8). Simetrico assim, o eixo sai reto sozinho -- sem
		mirar em ponto nenhum, sem caso especial -- e o peito fica no centro do
		quadro, que foi o pedido.

		O preco sao uns dois studs a mais de distancia, e a margem apertada do
		close (ZOOM_MARGEM_GRAUS) devolve quase todos. ]]
	local topo = pes + 6 * tamanho
	--[[ A LENTE EXATAMENTE NO MEIO DO QUE PRECISA CABER.

		"Reto" e' isto, escrito como conta em vez de como numero: com o pe' e o
		topo do balao a distancias iguais da lente, o eixo optico sai na
		horizontal por construcao, em qualquer escala de boneco.

		A CAMERA.ALTURA fixa do plano normal nao serve aqui. Ela vale 1 stud e
		nao cresce com o avatar, entao acertava a simetria so' no boneco de
		escala 1 -- no de escala 6 a lente ficava 6 studs abaixo do meio e o
		close voltava a olhar pra cima, que foi exatamente a reclamacao.

		O termo `- (topo - pes) * 0.5` desfaz a meia-altura que o proprio solver
		soma depois (ver `resolver` no Enquadramento.luau): o que sobra e' a
		altura da lente que ele precisa receber pra pousar no meio. ]]
	local topoQuadro = topoDoBalao(pes, topo, tamanho)
	local alturaBase = (topoQuadro - pes) / 2 - (topo - pes) * 0.5

	return montarPlano(pivo.X, pivo.Z, pes, topo, tamanho, 0,
		Config.CAMERA.ZOOM_DISTANCIA * tamanho,
		Config.CAMERA.ZOOM_MARGEM_GRAUS, alturaBase)
end

--[[ O plano padrao: o alvo em primeiro plano e o telao atras dele. ]]
local function destinoSeguir(): CFrame
	if not alvo or not alvo.Parent then
		--[[ Sem alvo (comeco da live, ou o alvo foi limpo): enquadra a PRIMEIRA
			FILEIRA como se houvesse alguem la'.

			Antes isto era um plano geral fixo, e o comeco da live abria com um
			quadro diferente do resto -- a primeira impressao de quem entra era
			de outra transmissao. Passando pelo mesmo solver, o palco vazio ja'
			aparece com o telao no lugar em que ele vai ficar, e a chegada do
			primeiro avatar quase nao move a camera. ]]
		return montarPlano(0, 0, 0, 6, 1, Config.CAMERA.TELAO_RECUO_MAX)
	end

	local ok, pivo = pcall(function()
		return alvo:GetPivot().Position
	end)
	if not ok or not pivo then
		return destino
	end

	local tamanho = tamanhoDe(alvo)
	--[[ Os pes, e nao o pivo. O pivo de um R15 fica na cintura, e o solver
		precisa da base do boneco pra saber onde o quadro tem que terminar
		embaixo -- e do topo pra saber onde ele termina em cima. ]]
	local pes = pivo.Y - 3 * tamanho
	return montarPlano(pivo.X, pivo.Z, pes, pes + 6 * tamanho, tamanho,
		Config.CAMERA.TELAO_RECUO_MAX)
end

local function destinoCena(dt: number): CFrame
	if not alvo or not alvo.Parent then
		return destinoSeguir()
	end
	local ok, pivo = pcall(function()
		return alvo:GetPivot().Position
	end)
	if not ok or not pivo then
		return destino
	end
	local ponto = pivo + Vector3.new(0, 1.7 * tamanhoDe(alvo), 0)
	anguloCena += dt * Config.CAMERA.CENA_GIRO * math.pi * 2
	-- Afasta na medida do boneco: o CENA_DISTANCIA do Config e' a distancia de
	-- UM avatar normal, e quem e' quatro vezes maior precisa de quatro vezes
	-- mais espaco pra caber no mesmo quadro.
	local tamanho = tamanhoDe(alvo)
	local raio = Config.CAMERA.CENA_DISTANCIA * tamanho
	local posicao = ponto + Vector3.new(
		math.sin(anguloCena) * raio,
		Config.CAMERA.CENA_ALTURA * tamanho,
		math.cos(anguloCena) * raio)
	return CFrame.new(posicao, ponto)
end

--[[ O plano aberto do fim do ciclo: a formacao INTEIRA no quadro.

	O recuo do painel conta a partir da FILEIRA DA FRENTE, e nao do centro. Com
	dez fileiras, o centro fica na quinta -- recuar 34 studs dali punha a camera
	no meio da formacao, com metade dela nas costas da lente. Somar meia
	profundidade tira a camera pra fora antes de aplicar o recuo, e ai' o numero
	do painel volta a significar o que ele diz: distancia da plateia.

	A altura sobe junto pelo mesmo motivo: olhando de raspao, uma formacao funda
	esconde as fileiras de tras atras das da frente. ]]
local function destinoAberto(): CFrame
	local recuo = recuoDoPainel() + profundidadeAberta / 2
	local altura = math.max(Config.CAMERA.ALTURA_ABERTA, profundidadeAberta * 0.45)
	local posicao = centroAberto + Vector3.new(0, altura, recuo)
	return CFrame.new(posicao, centroAberto + Vector3.new(0, 2, 0))
end

-- ─────────────────────────── O laco ───────────────────────────

--[[ A lente propriamente dita.

	Escrita a cada quadro porque o painel pode mudar o FOV ao vivo e porque
	girar a janela (do modo deitado pro em pe') muda qual dos dois vale. Uma
	atribuicao por quadro num numero que quase nunca muda custa nada, e o
	`if` evita marcar a propriedade como suja a' toa. ]]
local function aplicarLente()
	local desejado = if ehVertical()
		then ajuste("CameraFov", Config.CAMERA.FOV_VERTICAL, 30, 110)
		else ajuste("CameraFov", Config.CAMERA.FOV, 30, 110)
	if math.abs(camera.FieldOfView - desejado) > 0.01 then
		camera.FieldOfView = desejado
	end
end

--[[ ─────────── QUEM A CAMERA ESTA' MOSTRANDO TEM NOME ───────────

	Marca o balao do alvo com um atributo, e o Rotulos.client.luau o acende
	sem passar por regra nenhuma -- nem rodizio de fileira, nem teto de
	quantidade, nem apagamento por distancia.

	POR QUE UM CANAL DIRETO, E NAO MAIS UMA HEURISTICA

	Porque "o nick nao aparece" ja' voltou tres vezes, cada uma por um motivo
	diferente: o rodizio apagava a fileira dele, o quadro cortava o balao pela
	borda de cima, o alcance nao acompanhava o recuo. Todas eram regras
	tentando ADIVINHAR quem a camera esta' mostrando -- e a camera SABE quem
	e'. Perguntar pra quem sabe e' mais curto que acertar a adivinhacao.

	O atributo e' escrito no CLIENTE e nao replica pra ninguem, que e'
	exatamente o que se quer: cada espectador acende o nome de quem a camera
	DELE esta' mostrando. E' a mesma razao de a camera viver no cliente.

	Reavaliado a cada quadro (e nao so' na troca de alvo) porque o balao chega
	DEPOIS do modelo: o avatar nasce, a camera ja' aponta pra ele, e a cabeca
	com o rotulo replica um instante mais tarde. Marcando so' na troca, quem
	chegasse durante esse instante ficaria sem nome ate' o proximo. Sao dois
	FindFirstChild por quadro. ]]
local balaoMarcado: BillboardGui? = nil

local function rotuloDe(m: Model?): BillboardGui?
	local cabeca = m and m:FindFirstChild("Head")
	local balao = cabeca and cabeca:FindFirstChild("Rotulo")
	return if balao and balao:IsA("BillboardGui") then balao else nil
end

local function marcarAlvo(m: Model?)
	local balao = rotuloDe(m)
	if balao == balaoMarcado then
		return
	end
	if balaoMarcado and balaoMarcado.Parent then
		balaoMarcado:SetAttribute("AlvoDaCamera", nil)
	end
	balaoMarcado = balao
	if balao then
		balao:SetAttribute("AlvoDaCamera", true)
	end
end

RunService.RenderStepped:Connect(function(dt)
	local tempo = workspace:GetServerTimeNow()

	if modo == "cena" and tempo >= cenaAte then
		modo = "seguir"
	end
	if modo == "aberta" and tempo >= abertaAte then
		modo = "seguir"
	end

	aplicarLente()

	-- Quem a camera esta' mostrando tem nome, sempre. Ver `marcarAlvo`.
	marcarAlvo(if modo == "aberta" then nil else alvo)

	--[[ O ZOOM manda enquanto durar, e so' no modo seguir: o plano aberto do
		fim de ciclo e a cinematica sao momentos com dono, e um close por cima
		deles seria a camera brigando consigo mesma. ]]
	local emZoom = modo == "seguir" and tempo < zoomAte and alvo ~= nil
		and alvo.Parent ~= nil

	if modo == "cena" then
		destino = destinoCena(dt)
	elseif modo == "aberta" then
		destino = destinoAberto()
	elseif emZoom then
		destino = destinoZoom(alvo :: Model) or destinoSeguir()
	else
		destino = destinoSeguir()
	end

	--[[ A interpolacao.

		O `1 - (1 - s)^(dt*60)` em vez de `s` puro nao e' firula: com `s` puro, a
		velocidade da camera dependeria do FPS de quem assiste -- mais macia num
		PC rapido, mais dura num lento. Assim ela se move igual em qualquer
		maquina, que e' o que importa quando o video e' o produto.

		A ENTRADA DO ZOOM USA OUTRA SUAVIDADE, e e' o pedido literal do dono:
		"tem que ser um zoom rapido". Com a suavidade normal (0.08) a camera
		levaria mais de um segundo pra chegar no close -- ou seja, ela ainda
		estaria viajando quando o tempo do close acabasse, e o efeito na tela
		seria um vai-e-vem molenga em vez de um zoom. Na VOLTA vale a suavidade
		normal: sair devagar do close devolve a multidao sem susto. ]]
	local suavidade = if emZoom then Config.CAMERA.ZOOM_SUAVIDADE
		else Config.CAMERA.SUAVIDADE
	local fator = 1 - (1 - suavidade) ^ (dt * 60)
	camera.CFrame = camera.CFrame:Lerp(destino, math.clamp(fator, 0, 1))
end)

canal.OnClientEvent:Connect(function(ordem)
	if type(ordem) ~= "table" then
		return
	end
	local tempo = workspace:GetServerTimeNow()

	--[[ TROCOU DE ALVO? Comeca o zoom.

		Uma funcao so' pros dois caminhos (o "cena" convertido e o "seguir")
		porque os dois sao a mesma coisa do ponto de vista de quem assiste:
		alguem acabou de entrar na live. Quem mandou presente e quem so'
		comentou ganham o mesmo close -- o que separa os dois e' o tamanho do
		boneco e a aura, nao o direito de aparecer.

		SO' QUANDO O ALVO MUDA. Numa live movimentada o servidor manda "seguir"
		varias vezes seguidas pro mesmo avatar; reiniciando o zoom em cada uma,
		a camera ficaria presa no close sem nunca voltar pro plano aberto. ]]
	local function mirar(novo: Model?)
		if not novo or novo == alvo then
			return
		end
		alvo = novo
		if Config.CAMERA.ZOOM_LIGADO then
			zoomAte = tempo + Config.CAMERA.ZOOM_S
		end
	end

	if ordem.modo == "cena" then
		--[[ Com a cinematica desligada, presente caro NAO tira a camera do
			normal: ela so' vira pra ele e fica parada, como faz com todo mundo.

			Convertido AQUI, e nao no servidor, de proposito: o servidor continua
			mandando "cena" e continua segurando os proximos spawns pelo tempo
			que a pessoa pagou. Quem decide como a camera se comporta e' o
			arquivo da camera -- entao ligar o giro de volta e' mexer em um
			lugar so', o Config, sem tocar na logica da live. ]]
		if Config.CAMERA.CENA_LIGADA then
			modo = "cena"
			alvo = ordem.alvo
			cenaAte = tempo + (tonumber(ordem.duracao) or 3)
		else
			modo = "seguir"
			mirar(ordem.alvo)
		end
	elseif ordem.modo == "aberta" then
		modo = "aberta"
		centroAberto = ordem.centro or Vector3.new(0, 0, 0)
		profundidadeAberta = math.clamp(tonumber(ordem.profundidade) or 0, 0, 600)
		abertaAte = tempo + (tonumber(ordem.duracao) or Config.CAMERA.ABERTA_S)
	elseif ordem.modo == "seguir" then
		--[[ Uma CENA em andamento nao pode ser interrompida por um comentario
			comum que chegou logo atras.

			Sem esta guarda, o momento que a pessoa PAGOU pra ter duraria ate' o
			proximo "oi" no chat -- e numa live movimentada isso e' menos de um
			segundo. O presente caro viraria um piscar. ]]
		if modo == "cena" and tempo < cenaAte then
			return
		end
		modo = "seguir"
		mirar(ordem.alvo)
	end
end)

-- Sem personagem, o Roblox nao tem onde ancorar a interface padrao, e ela fica
-- ocupando canto de tela numa transmissao onde cada pixel e' conteudo.
local jogador = Players.LocalPlayer
if jogador then
	local gui = jogador:FindFirstChildOfClass("PlayerGui")
	if gui then
		pcall(function()
			game:GetService("StarterGui"):SetCoreGuiEnabled(
				Enum.CoreGuiType.All, false)
		end)
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">Rotulos</string>
          <string name="Source"><![CDATA[--!strict
--[[
	QUEM APAGA OS NOMES QUANDO A CAMERA ESTA' LONGE.

	O PROBLEMA QUE ISTO RESOLVE

	Cada avatar nasce com um balao de nome em cima da cabeca. Um balao e' otimo.
	Cem baloes nao sao cem vezes melhor -- sao uma parede preta.

	Com o limite antigo (80 studs, fixo, decidido so' pelo motor da Roblox), a
	camera de perto -- que fica a uns 45 studs de quem ela segue -- alcancava a
	pessoa seguida MAIS quatro fileiras atras dela. Quarenta, cinquenta rotulos
	desenhados juntos, encavalados, cada um do tamanho de uma unha na tela de
	quem assiste pelo celular. Nao dava pra ler nenhum, nem o de quem a camera
	estava seguindo -- que e' o unico que precisava ser lido. E a multidao do
	fundo, que e' o argumento que faz a proxima pessoa comentar, ficava escondida
	atras do texto.

	No plano aberto do fim do ciclo era pior ainda: e' o momento de mostrar
	QUANTA gente entrou, e ele saia coberto de nomes ilegiveis.

	A REGRA, EM QUATRO LINHAS

	  1. so' a FILEIRA DA FRENTE tem nome -- e ela inteira;
	  2. passou do alcance do rotulo, ele some;
	  3. chegando perto do limite, ele APAGA aos poucos em vez de piscar;
	  4. e nenhum nome cai EM CIMA de outro (ver "O CHOQUE ENTRE FILEIRAS").

	E o item 1 e' o que faz o resultado ser bom e nao so' "menos pior": a
	formacao cresce PARA A FRENTE (cada fileira nova nasce mais perto da
	camera), entao a fileira da frente e' sempre a de quem acabou de chegar.
	Quem comentou agora ve' o proprio nome; quem esta' na live ha' cinco
	minutos continua na tela, dancando, mas sem competir por espaco com quem
	chegou.

	Fora de todas elas fica QUEM A CAMERA ESTA' MOSTRANDO: esse acende sempre.
	A camera marca o balao dele, e este arquivo obedece sem perguntar.

	POR QUE NO CLIENTE

	A distancia da camera muda 60 vezes por segundo, e a camera e' propriedade do
	cliente. Fazer esta conta no servidor exigiria replicar posicao de camera o
	tempo todo pra chegar sempre atrasado.

	POR QUE NAO BASTA O `MaxDistance`

	Ele existe e continua ligado aqui como rede de seguranca (o servidor o
	configura junto com o balao). Mas ele so' sabe cortar por distancia: nao
	tem teto de quantidade, nao apaga aos poucos, e liga tudo que estiver dentro
	do raio. Numa fileira de dez, "dentro do raio" e' dez rotulos de uma vez.

	SE ESTE ARQUIVO NAO SUBIR, a live NAO quebra: os rotulos ficam como eram
	antes, cortados so' pelo MaxDistance. E' de proposito -- nenhum enfeite deste
	kit pode ser capaz de derrubar uma transmissao.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

--[[ Escrito IGUAL no Avatares.luau (MARCA_ROTULO). Os dois precisam combinar:
	uma letra diferente e este arquivo nao acha rotulo nenhum -- sem erro, sem
	aviso, e o excesso volta calado. ]]
local MARCA_ROTULO = "RotuloDaLive"

local ROTULO = Config.ROTULO

--[[ De que fracao do alcance o rotulo comeca a apagar.

	Guardado como FRACAO, e nao em studs, porque cada rotulo tem o proprio
	alcance (o do boneco grande e' maior). Assim a faixa de apagamento acompanha
	o alcance de cada um, em vez de ser larga num e inexistente no outro.

	O teto de 0.95 nao e' capricho: se alguem puser DISTANCIA_SUAVE igual (ou
	maior) que DISTANCIA_MAX no Config, a conta do `alpha` la' embaixo dividiria
	por zero e todo rotulo viraria NaN -- ou seja, sumiriam TODOS, com o Config
	parecendo inofensivo. ]]
local INICIO_DO_FADE = math.clamp(
	(tonumber(ROTULO.DISTANCIA_SUAVE) or 0) / math.max(ROTULO.DISTANCIA_MAX, 1),
	0, 0.95)

--[[ Quantos slots do FIM do teto entram apagando.

	Sem esta folga o teto de quantidade cortaria seco: o 13o rotulo mais perto
	sumiria de um quadro pro outro enquanto a camera anda, e um rotulo piscando
	na gravacao chama mais atencao que o excesso que este arquivo veio resolver.
	Com ela, os ultimos do orcamento entram e saem apagando. ]]
local FOLGA_DO_TETO = 3

-- Intervalo entre duas contas. 0.06s (~16 vezes por segundo) e' de sobra pra
-- um apagamento parecer continuo, e custa quase nada com cem baloes. Refazer
-- a conta a cada quadro seria trabalho jogado fora: rotulo nao e' animacao.
local INTERVALO = 0.06

local camera = workspace.CurrentCamera

--[[ As transparencias ORIGINAIS de cada balao.

	Precisam ser lidas UMA vez, na primeira vez que vemos o balao, e guardadas:
	depois disso quem mexe nelas e' este arquivo, e reler viraria uma cobra
	comendo o proprio rabo -- o valor "original" seria o que sobrou do quadro
	anterior, e o rotulo iria apagando ate' sumir de vez sem nunca mais voltar.

	Tabela de chave FRACA: o ciclo apaga cem avatares de uma vez, e sem isto ela
	seguraria cem baloes destruidos na memoria ate' o fim da live. ]]
type Pintura = {
	fundo: Frame?,
	fundoBase: number,
	textos: { { rotulo: TextLabel, textoBase: number, tracoBase: number } },
}

local pinturas: { [Instance]: Pintura } = setmetatable({}, { __mode = "k" }) :: any

local function pinturaDe(balao: BillboardGui): Pintura
	local guardada = pinturas[balao]
	if guardada then
		return guardada
	end

	local nova: Pintura = { fundo = nil, fundoBase = 0, textos = {} }
	local fundo = balao:FindFirstChildOfClass("Frame")
	if fundo then
		nova.fundo = fundo
		nova.fundoBase = fundo.BackgroundTransparency
		for _, filho in ipairs(fundo:GetChildren()) do
			if filho:IsA("TextLabel") then
				table.insert(nova.textos, {
					rotulo = filho,
					textoBase = filho.TextTransparency,
					tracoBase = filho.TextStrokeTransparency,
				})
			end
		end
	end

	pinturas[balao] = nova
	return nova
end

--[[ Pinta o balao com `alpha` de opacidade: 1 = como o servidor o criou,
	0 = invisivel.

	Apaga o FUNDO e o TEXTO juntos, e nao so' o texto. Um balao preto vazio
	flutuando em cima da cabeca de alguem e' pior que o nome: vira um borrao sem
	informacao nenhuma, e a formacao continua parecendo uma parede. ]]
local function pintar(balao: BillboardGui, alpha: number)
	if alpha <= 0.02 then
		if balao.Enabled then
			balao.Enabled = false
		end
		return
	end

	if not balao.Enabled then
		balao.Enabled = true
	end

	local pintura = pinturaDe(balao)
	local fundo = pintura.fundo
	if fundo and fundo.Parent then
		fundo.BackgroundTransparency = 1 - (1 - pintura.fundoBase) * alpha
	end
	for _, item in ipairs(pintura.textos) do
		if item.rotulo.Parent then
			item.rotulo.TextTransparency = 1 - (1 - item.textoBase) * alpha
			item.rotulo.TextStrokeTransparency = 1 - (1 - item.tracoBase) * alpha
		end
	end
end

--[[ Onde este rotulo esta' no mundo.

	O Adornee vem primeiro porque e' ele quem manda quando existe; o Parent e' o
	caminho normal aqui (o balao mora dentro da Head). Devolve nil pra balao que
	ja' saiu do jogo -- e sair do jogo e' rotina: a formacao inteira e' apagada a
	cada ciclo. ]]
local function ondeEsta(balao: BillboardGui): Vector3?
	local ancora = balao.Adornee or balao.Parent
	if ancora and ancora:IsA("BasePart") then
		return ancora.Position
	end
	if ancora and ancora:IsA("Model") then
		local ok, pivo = pcall(function()
			return ancora:GetPivot().Position
		end)
		if ok and pivo then
			return pivo
		end
	end
	return nil
end

-- Reaproveitada entre as voltas em vez de criada de novo a cada 0.06s: cem
-- tabelas por segundo jogadas fora dao trabalho ao coletor de lixo bem no meio
-- da transmissao.
local candidatos: { {
	balao: BillboardGui,
	razao: number,
	fileira: number?,
	ancora: Vector3,
} } = {}

local function fileiraDaFrente(): number?
	if ROTULO.SO_FILEIRA_DA_FRENTE == false then
		return nil          -- desligado: vale o comportamento antigo
	end
	local quantas = tonumber(workspace:GetAttribute("FileirasNaTela")) or 0
	if quantas <= 0 then
		return nil
	end
	-- `FileirasNaTela` e' a CONTAGEM; a da frente e' a ultima, entao -1.
	return quantas - 1
end

--[[ ═══════════════════════════════════════════════════════════════════
	O CHOQUE ENTRE FILEIRAS
	═══════════════════════════════════════════════════════════════════

	As regras acima decidem QUANTOS nomes aparecem. Nenhuma delas olha ONDE
	eles caem na tela -- e e' ai' que nasce o embolamento.

	A conta que explica: com a lente na altura do peito, todo balao esta' na
	mesma altura do MUNDO (uns 8 studs). Quanto mais longe, menor a elevacao --
	entao o balao da fileira de tras desce na tela e vai pousar exatamente em
	cima da cabeca de quem esta' na frente. Nao e' acaso nem azar de posicao: e'
	geometria, e acontece toda vez.

	A resposta e' medir o RETANGULO de cada balao na tela e dar o lugar a quem
	esta' mais perto. Quem chegou depois e cairia por cima simplesmente nao
	acende -- e' melhor um nome a menos que dois ilegiveis empilhados.

	POR QUE ISTO NAO SUBSTITUI AS OUTRAS REGRAS: elas resolvem outra coisa. O
	SO_FILEIRA_DA_FRENTE escolhe QUEM tem direito a nome, o MAX_NA_TELA limita
	o CUSTO de desenho, e isto aqui cuida da LEITURA. Os tres juntos e' que
	fazem a tela ficar limpa.

	E os tres podem discordar: uma fileira de dez cabe no teto e mesmo assim
	dois vizinhos podem se encostar num angulo fechado. Quando isso acontece,
	quem esta' mais perto da lente fica. ]]

-- Os retangulos ja' ocupados nesta volta. Reaproveitado entre as voltas pelo
-- mesmo motivo da tabela `candidatos`: nao dar trabalho ao coletor de lixo no
-- meio da transmissao.
local ocupados: { { x: number, y: number, l: number, a: number } } = {}

--[[ O retangulo que este balao ocupa na tela, em pixels. `nil` se ele esta'
	atras da lente ou fora do quadro.

	O CENTRO E' O DO BALAO, e nao o da cabeca: o balao mora `StudsOffsetWorldSpace`
	acima do ponto de ancoragem, e medir o choque na altura errada deixaria
	passar exatamente as sobreposicoes que este codigo veio evitar.

	O tamanho sai da propria peca: um BillboardGui com Size em `fromScale` mede
	STUDS DO MUNDO, entao os pixels na tela sao os studs vezes a escala da
	perspectiva -- que e' a mesma conta que o motor faz pra desenha-lo. Assim o
	balao do gigante (que e' maior de proposito) reserva o espaco que ele
	realmente ocupa. ]]
local function retanguloDe(balao: BillboardGui, ancora: Vector3)
	: { x: number, y: number, l: number, a: number }?
	local centro = ancora + balao.StudsOffsetWorldSpace
	local ponto, naTela = camera:WorldToViewportPoint(centro)
	if not naTela then
		return nil
	end

	local tela = camera.ViewportSize
	local meia = math.tan(math.rad(camera.FieldOfView) / 2)
	if ponto.Z <= 0.01 or meia <= 0 then
		return nil
	end
	-- Quantos pixels vale um stud a esta profundidade.
	local porStud = tela.Y / (2 * ponto.Z * meia)

	local folga = tonumber(ROTULO.FOLGA_SOBREPOR) or 6
	local l = balao.Size.X.Scale * porStud + folga
	local a = balao.Size.Y.Scale * porStud + folga
	return { x = ponto.X - l / 2, y = ponto.Y - a / 2, l = l, a = a }
end

local function bateEm(r: any, outro: any): boolean
	return r.x < outro.x + outro.l
		and outro.x < r.x + r.l
		and r.y < outro.y + outro.a
		and outro.y < r.y + r.a
end

--[[ Guarda o lugar se ele estiver livre. Devolve `false` quando o balao cairia
	por cima de um que ja' esta' aceso -- e ai' quem chama simplesmente nao
	acende este. ]]
local function reservar(r: any?): boolean
	if not r then
		return false
	end
	if ROTULO.SEM_SOBREPOR == false then
		return true
	end
	for _, outro in ipairs(ocupados) do
		if bateEm(r, outro) then
			return false
		end
	end
	table.insert(ocupados, r)
	return true
end

local function atualizar()
	--[[ A camera pode trocar (o Studio troca ao entrar e sair do Play). Reler o
		CurrentCamera a cada volta evita o caso em que este arquivo fica medindo
		distancia a partir de uma camera que nao existe mais -- e ai' os rotulos
		somem todos, ou aparecem todos, sem nada explicando por que. ]]
	camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local deOnde = camera.CFrame
	local olho = deOnde.Position

	table.clear(candidatos)
	table.clear(ocupados)
	local daFrente = fileiraDaFrente()

	for _, item in ipairs(CollectionService:GetTagged(MARCA_ROTULO)) do
		local balao = item :: BillboardGui
		if balao:IsA("BillboardGui") and balao.Parent then
			--[[ QUEM A CAMERA ESTA' MOSTRANDO PASSA NA FRENTE DE TUDO.

				Sem rodizio, sem teto de quantidade, sem apagamento por
				distancia. A marca vem do proprio Camera.client.luau (ver
				`marcarAlvo` la'), que e' quem SABE quem esta' em cena -- todas
				as regras deste arquivo sao aproximacoes disso.

				E' a resposta final pra "o nick de quem comentou nao aparece":
				enquanto a lente estiver nele, o nome esta' aceso, por
				construcao e nao por coincidencia de numeros. ]]
			if balao:GetAttribute("AlvoDaCamera") then
				pintar(balao, 1)
				--[[ E RESERVA O LUGAR DELE ANTES DE TODO MUNDO. Ele acende de
					qualquer jeito, entao quem tem que sair da frente sao os
					outros -- sem isto, um balao da fileira de tras poderia
					pousar exatamente em cima do unico nome que a live PRECISA
					mostrar. ]]
				local ancora = ondeEsta(balao)
				if ancora then
					reservar(retanguloDe(balao, ancora))
				end
				continue
			end
			--[[ A FILEIRA entra como DADO, e nao como filtro.

				Antes o rodizio cortava aqui, antes de medir distancia. Era mais
				barato e estava errado: cortando neste ponto, nao havia como
				saber se o balao que estava sendo apagado era justamente o de
				quem a camera estava mostrando. Agora a fileira viaja junto com
				o candidato e quem decide e' o laco de baixo, que ja' tem a
				ordem de quem esta' mais perto da lente.

				O `colosso` continua de fora do rodizio de proposito: ele nasce
				atras da grade, sem fileira nenhuma, e e' o presente mais caro
				da live -- deixa-lo esperando a vez de uma fileira que ele nao
				tem faria o gigante ficar anonimo pra sempre. ]]
			local minha = tonumber(balao:GetAttribute("Fileira"))

			local posicao = ondeEsta(balao)
			if posicao then
				local alcance = tonumber(balao:GetAttribute("Alcance"))
					or ROTULO.DISTANCIA_MAX
				local distancia = (posicao - olho).Magnitude

				--[[ O que esta' ATRAS da camera nao entra na conta.

					Nao e' economia de CPU: e' o teto de quantidade. Um rotulo
					atras da lente nao aparece na tela de jeito nenhum, mas se
					ele contasse, ocuparia um dos lugares do teto -- e o resultado
					seria uma formacao com espaco sobrando na tela e rotulos
					desligados "sem motivo". No Roblox o -Z do CFrame e' pra
					onde a camera olha, entao Z positivo no espaco dela e'
					exatamente o que ficou pra tras. ]]
				local relativo = deOnde:PointToObjectSpace(posicao)
				if relativo.Z <= 0 and distancia < alcance then
					table.insert(candidatos, {
						balao = balao,
						--[[ RAZAO, e nao a distancia crua. Cada rotulo tem o
							proprio alcance, e ordenar por distancia faria o
							boneco grande -- que enxerga mais longe de proposito
							-- perder o lugar pro vizinho de tamanho normal que
							esta' dois studs mais perto. Dividindo pelo alcance,
							a comparacao passa a ser "o quao perto do LIMITE
							DELE cada um esta'", que e' a pergunta certa. ]]
						razao = distancia / math.max(alcance, 1),
						fileira = minha,
						ancora = posicao,
					})
				else
					pintar(balao, 0)
				end
			end
		end
	end

	table.sort(candidatos, function(a, b)
		return a.razao < b.razao
	end)

	local teto = math.max(1, math.floor(tonumber(ROTULO.MAX_NA_TELA) or 12))

	for posto, item in ipairs(candidatos) do
		--[[ A FILEIRA DA FRENTE INTEIRA acende; o resto, nao.

			Sem teto de quantos da fileira e sem revezamento entre eles: se dez
			pessoas estao na fileira que esta' entrando, os dez nicks aparecem.
			Era o pedido, e e' o que a live promete. ]]
		local foraDaVez = daFrente ~= nil
			and item.fileira ~= nil
			and item.fileira ~= daFrente

		--[[ E, POR FIM, O LUGAR NA TELA. Vem depois das outras regras de
			proposito: nao adianta reservar espaco pra um balao que a regra da
			fileira ou o teto ja' iam apagar -- ele estaria segurando um lugar que outro
			poderia usar. Como a lista esta' ordenada por proximidade, quem
			ganha o lugar disputado e' sempre o mais perto da lente. ]]
		if posto > teto or foraDaVez
			or not reservar(retanguloDe(item.balao, item.ancora)) then
			pintar(item.balao, 0)
		else
			-- Quanto o LIMITE de distancia ja' apagou este rotulo.
			local porDistancia = math.clamp(
				(1 - item.razao) / (1 - INICIO_DO_FADE), 0, 1)

			--[[ Quanto o TETO DE QUANTIDADE ja' apagou. Os ultimos lugares do
				orcamento entram e saem apagando em vez de piscar. ]]
			local porPosto = 1
			if posto > teto - FOLGA_DO_TETO then
				porPosto = (teto - posto + 1) / (FOLGA_DO_TETO + 1)
			end

			-- O MENOR dos dois manda: basta um dos limites pedir pra apagar.
			pintar(item.balao, math.min(porDistancia, porPosto))
		end
	end
end

local acumulado = 0

RunService.RenderStepped:Connect(function(dt)
	acumulado += dt
	if acumulado < INTERVALO then
		return
	end
	acumulado = 0

	--[[ Sob pcall porque isto roda pra sempre, a cada 0.06s, no meio de uma
		transmissao ao vivo. Um avatar destruido no instante exato entre o
		`GetTagged` e a leitura da posicao dele levantaria um erro, o
		RenderStepped desconectaria a funcao, e a partir dali TODOS os rotulos
		ficariam congelados no estado em que estavam -- um defeito que aparece
		uma vez a cada mil ciclos e some quando voce vai testar. ]]
	pcall(atualizar)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
