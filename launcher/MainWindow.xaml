<Window x:Class="NexivoLive.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Width="430" Height="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Border CornerRadius="28" BorderThickness="1" BorderBrush="#35FFFFFF" Background="#E8090D0B" Padding="1">
        <Border CornerRadius="27" Background="#F20B100E">
            <Grid>
                <Ellipse Width="340" Height="340" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-210,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3318E58A" Offset="0"/>
                            <GradientStop Color="#0018E58A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel VerticalAlignment="Center" Margin="42,22,42,30">
                    <TextBlock Text="NexivoLive" Foreground="#F4FAF7" FontSize="27" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SubtitleText" Text="Ative seu acesso" Foreground="#84918A"
                               FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <TextBlock Text="CHAVE DE LICENÇA" Foreground="#65716A" FontSize="10"
                               FontWeight="SemiBold" Margin="2,0,0,8"/>
                    <Border Background="#CC070B09" BorderBrush="#303B35" BorderThickness="1" CornerRadius="13" Height="52" Padding="15,0">
                        <TextBox x:Name="KeyBox" Background="Transparent" BorderThickness="0"
                                 Foreground="#E8F8EF" CaretBrush="#18E58A" FontSize="14"
                                 VerticalContentAlignment="Center" MaxLength="15"
                                 CharacterCasing="Upper" TextChanged="KeyBox_TextChanged"/>
                    </Border>
                    <Button x:Name="VerifyButton" Content="Verificar licença" Height="50" Margin="0,14,0,0"
                            Click="VerifyButton_Click" Foreground="#03110A" FontWeight="Bold" FontSize="13"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0A9F62" Offset="0"/>
                                <GradientStop Color="#18E58A" Offset=".7"/>
                                <GradientStop Color="#77FFC0" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <StackPanel x:Name="StatusPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <TextBlock x:Name="SpinnerText" Text="◌" Foreground="#18E58A" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Foreground="#B6C2BB" FontSize="12"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,25,0,0">
                        <TextBlock Text="✓" Foreground="#18E58A" FontSize="38" HorizontalAlignment="Center"/>
                        <TextBlock Text="NexivoLive instalado" Foreground="#F4FAF7" FontSize="16"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock Text="Seus arquivos estão prontos." Foreground="#84918A" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,5,0,14"/>
                        <Button Content="Abrir pasta" Width="150" Height="40" Click="OpenFolder_Click"
                                Background="#121A16" Foreground="#DDF9E9" BorderBrush="#294337"
                                BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="ErrorText" Foreground="#FF9EAA" FontSize="11" TextAlignment="Center"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,18,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
